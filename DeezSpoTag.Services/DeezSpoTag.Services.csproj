<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>DeezSpoTag Services</AssemblyTitle>
    <AssemblyDescription>DeezSpoTag Application Services</AssemblyDescription>
    <Copyright>Copyright © 2025</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Openur.TagLibSharp" Version="2.5.0.6" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="z440.atl.core" Version="7.18.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <!-- SoundCloud page hydration extraction. Same version the web host already uses. -->
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeezSpoTag.Core\DeezSpoTag.Core.csproj" />
    <ProjectReference Include="..\DeezSpoTag.Integrations\DeezSpoTag.Integrations.csproj" />
    <ProjectReference Include="..\DeezSpoTag.Data\DeezSpoTag.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Library/Schema/library.sql" />
    <!--
      The researched Genre/Style master, generated from the research spreadsheet by
      scripts/genre/build_genre_taxonomy.py. Embedded so the shipped build carries
      the catalog and never needs the spreadsheet or a loose file at runtime.
    -->
    <EmbeddedResource Include="Genre/Data/genre-intelligence-taxonomy.json" />
    <EmbeddedResource Include="Genre/Data/style-construction-rules.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Download/UnifiedQueueBackgroundService.cs" />
  </ItemGroup>

</Project>
