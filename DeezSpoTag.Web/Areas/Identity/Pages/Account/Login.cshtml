@page
@model DeezSpoTag.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-center">
    <form class="auth-card text-center" method="post">
        <div class="mb-4">
            <a class="d-inline-flex align-items-center justify-content-center" href="@Url.Action("Index", "Home", new { area = "" })">
                @await Html.PartialAsync("_DeezSpoTagLogo", "auth-logo theme-logo auth-theme-logo")
            </a>
            <h2 class="auth-title mt-3">Sign In</h2>
        </div>
        @if (ViewData.ModelState.TryGetValue(string.Empty, out var modelErrorEntry) &&
             modelErrorEntry?.Errors.Count > 0)
        {
            <div class="text-danger small mb-3" role="alert" aria-live="polite">
                @foreach (var error in modelErrorEntry.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }
        <div class="mb-3">
            <label for="Input_Username" class="visually-hidden">Username</label>
            @Html.TextBoxFor(model => model.Input.Username, new { id = "Input_Username", @class = "app-modal-input", autocomplete = "username" })
            @Html.ValidationMessageFor(model => model.Input.Username, string.Empty, new { @class = "text-danger small" })
        </div>
        <div class="mb-4">
            <label for="Input_Password" class="visually-hidden">Password</label>
            @Html.PasswordFor(model => model.Input.Password, new { id = "Input_Password", @class = "app-modal-input", autocomplete = "current-password" })
            @Html.ValidationMessageFor(model => model.Input.Password, string.Empty, new { @class = "text-danger small" })
        </div>
        <button class="btn btn-lg btn-primary w-100" type="submit">Let me in</button>
    </form>
</div>
