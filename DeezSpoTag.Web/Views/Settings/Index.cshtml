function normalizeDownloadEngineOrderConfig(config) {
    const incoming = config && typeof config === 'object' ? config : {};
    const incomingEngines = Array.isArray(incoming.engines) ? incoming.engines : [];
    const byEngine = new Map(defaultDownloadEngineOrder.map(engine => [engine.engine, engine]));
    const normalized = {
        enabled: incoming.enabled === true,
        engines: []
    };
    const seenEngines = new Set();

    incomingEngines.forEach(engineConfig => {
        const engineKey = String(engineConfig?.engine || '').trim().toLowerCase();
        const defaultEngine = byEngine.get(engineKey);
        if (!defaultEngine || seenEngines.has(engineKey)) {
            return;
        }

        seenEngines.add(engineKey);
        normalized.engines.push(normalizeDownloadEngineOrderItem(engineConfig, defaultEngine));
    });

    defaultDownloadEngineOrder.forEach(defaultEngine => {
        if (seenEngines.has(defaultEngine.engine)) {
            return;
        }

        normalized.engines.push(normalizeDownloadEngineOrderItem(defaultEngine, defaultEngine));
    });

    return normalized;
}

function normalizeDownloadEngineOrderItem(engineConfig, defaultEngine) {
    const incomingQualities = Array.isArray(engineConfig?.qualities) ? engineConfig.qualities : [];
    const incomingByQuality = new Map();

    incomingQualities.forEach(qualityConfig => {
        const qualityKey = String(qualityConfig?.quality || '').trim();
        if (!qualityKey || incomingByQuality.has(qualityKey.toLowerCase())) {
            return;
        }

        incomingByQuality.set(qualityKey.toLowerCase(), qualityConfig);
    });

    const qualities = defaultEngine.qualities.map(defaultQuality => {
        const incomingQuality = incomingByQuality.get(defaultQuality.quality.toLowerCase());
        return {
            quality: defaultQuality.quality,
            label: defaultQuality.label,
            enabled: incomingQuality ? incomingQuality.enabled !== false : defaultQuality.enabled !== false
        };
    });

    return {
        engine: defaultEngine.engine,
        label: defaultEngine.label,
        enabled: engineConfig?.enabled !== false,
        qualities
    };
}

function renderDownloadEngineOrder(config) {
    const list = document.getElementById('downloadEngineOrderList');
    const enabled = document.getElementById('downloadEngineOrderEnabled');
    const summary = document.getElementById('downloadEngineOrderSummary');
    if (!list || !enabled) {
        return;
    }

    const normalized = normalizeDownloadEngineOrderConfig(config);
    enabled.value = normalized.enabled ? 'true' : 'false';
    list.innerHTML = '';

    normalized.engines.forEach(engine => {
        const row = document.createElement('div');
        row.className = `engine-order-item${engine.enabled ? '' : ' engine-disabled'}`;
        row.dataset.engine = engine.engine;
        row.innerHTML = `
            <div class="engine-order-header">
                <input type="checkbox" class="engine-order-enabled" ${engine.enabled ? 'checked' : ''} aria-label="Enable ${escapeHtml(engine.label)}">
                <span class="engine-order-title">${escapeHtml(engine.label)}</span>
                <span class="engine-order-status">${engine.enabled ? 'enabled' : 'disabled'}</span>
            </div>
            <div class="engine-quality-list">
                ${engine.qualities.map(quality => `
                    <div class="checkbox-group" data-quality="${escapeHtml(quality.quality)}">
                        <input type="checkbox" class="engine-quality-enabled" ${quality.enabled ? 'checked' : ''} aria-label="Enable ${escapeHtml(engine.label)} ${escapeHtml(quality.label)}">
                        <label>${escapeHtml(quality.label)}</label>
                    </div>
                `).join('')}
            </div>
        `;
        list.appendChild(row);
    });

    bindDownloadEngineOrderControls(list);
    updateDownloadEngineOrderSummary(list, summary);
}

function bindDownloadEngineOrderControls(list) {
    list.querySelectorAll('.engine-order-item').forEach(item => {
        item.querySelector('.engine-order-enabled')?.addEventListener('change', event => {
            const checked = event.target?.checked === true;
            item.classList.toggle('engine-disabled', !checked);
            const status = item.querySelector('.engine-order-status');
            if (status) {
                status.textContent = checked ? 'enabled' : 'disabled';
            }
            updateDownloadEngineOrderSummary(list);
        });
    });

    list.querySelectorAll('.engine-quality-enabled').forEach(input => {
        input.addEventListener('change', () => {
            updateDownloadEngineOrderSummary(list);
        });
    });
}

function updateDownloadEngineOrderSummary(list, summary) {
    const resolvedList = list || document.getElementById('downloadEngineOrderList');
    const resolvedSummary = summary || document.getElementById('downloadEngineOrderSummary');
    if (!resolvedList || !resolvedSummary) {
        return;
    }

    const engineRows = Array.from(resolvedList.querySelectorAll('.engine-order-item'));
    const enabledEngines = engineRows.filter(row => row.querySelector('.engine-order-enabled')?.checked === true);
    const enabledQualityCount = enabledEngines.reduce((total, row) => (
        total + Array.from(row.querySelectorAll('.engine-quality-enabled')).filter(input => input.checked === true).length
    ), 0);
    const engineLabels = enabledEngines
        .map(row => row.querySelector('.engine-order-title')?.textContent?.trim())
        .filter(Boolean);
    const engineSummary = engineLabels.length > 0
        ? engineLabels.join(', ')
        : 'No enabled sources';
    resolvedSummary.textContent = `${enabledEngines.length} enabled source${enabledEngines.length === 1 ? '' : 's'}, ${enabledQualityCount} enabled qualit${enabledQualityCount === 1 ? 'y' : 'ies'}: ${engineSummary}.`;
}

function collectDownloadEngineOrder() {
    const source = document.getElementById('downloadSource')?.value || 'deezer';
    const enabled = source === 'custom';
    const engines = Array.from(document.querySelectorAll('#downloadEngineOrderList .engine-order-item'))
        .map(item => ({
            engine: item.dataset.engine || '',
            enabled: item.querySelector('.engine-order-enabled')?.checked === true,
            qualities: Array.from(item.querySelectorAll('.engine-quality-list .checkbox-group'))
                .map(qualityRow => ({
                    quality: qualityRow.dataset.quality || '',
                    enabled: qualityRow.querySelector('.engine-quality-enabled')?.checked === true
                }))
        }))
        .filter(engine => engine.engine);

    return normalizeDownloadEngineOrderConfig({ enabled, engines });
}

function escapeHtml(value) {
    return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

