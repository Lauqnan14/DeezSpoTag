@section Scripts {
<script>
let currentSettings = {};
let defaultSettings = {};
const defaultGenreTagBlockList = ['other', 'others', 'Worldwide'];
let currentLibraryScanSettings = {
    livePreviewIngest: false,
    enableSignalAnalysis: false
};
let settingsReady = false;
let settingsSaveInFlight = false;
let settingsSaveQueued = false;
let settingsSaveQueuedToast = false;
let mediaServerLibraryConfig = null;
let mediaServerLibraryAdvancedUnlocked = false;
let mediaServerLibraryPinConfigured = false;
let mediaServerLibraryPinStateAvailable = null;
let mediaServerLibraryAutoSaveTimer = 0;
let mediaServerLibraryAutoSaveInFlight = false;
let mediaServerLibraryAutoSavePending = false;
const APPLE_NOTIFICATION_MODE_KEY = 'apple-download-notification-mode';
const DOWNLOAD_SOURCE_SETTING_KEY = 'deezspotag-download-source-updated';
const DISABLED_LOGIN_PLATFORMS_KEY = 'deezspotag-disabled-login-platforms';
const FIXED_LOGIN_PLATFORMS = new Set(['deezer', 'spotify']);
const engineQualityOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    DeezSpoTag.Services.Download.QualityCatalog.GetEngineQualityOptions()
        .ToDictionary(
            kvp => kvp.Key,
            kvp => kvp.Value.Select(option => new { value = option.Value, label = option.Label }).ToList(),
            StringComparer.OrdinalIgnoreCase)));
const defaultDownloadEngineOrder = @Html.Raw(defaultDownloadEngineOrderJson);

window.DeezSpoTagRevealMaterialIconsWhenReady('.settings-page.material-icons-pending');

document.addEventListener('DOMContentLoaded', function() {
    initSettings();
    setupEventListeners();
    setupAccordionToggle();
    setupTemplateVariableHelpers();
    initTabPreferenceToggle();
    initDownloadSourceDropdowns();
    initDownloadEngineOrderCollapse();
    initLibraryFolderDestinationDropdowns();
    initSecondarySourceControls();
    initLoginTabControls();
    setupArtworkFallbackOrder();
    initializeSettingsTooltips();
    bindMediaServerLibraryPinActions();
    bindMediaServerLibraryActions();
    bindApiTokenActions();
    void initNotificationPreferences();
});

function createSettingsTooltipIcon(message) {
    if (!message) {
        return null;
    }

    const tooltip = document.createElement('span');
    tooltip.className = 'settings-tooltip-icon';
    tooltip.title = message;
    tooltip.setAttribute('aria-label', message);
    tooltip.innerHTML = '<i class="fas fa-question-circle"></i>';
    return tooltip;
}

function appendTooltipToElement(target, message) {
    if (!target || !message) {
        return false;
    }

    if (target.querySelector('.settings-tooltip-icon')) {
        return true;
    }

    const tooltip = createSettingsTooltipIcon(message);
    if (!tooltip) {
        return false;
    }

    target.appendChild(tooltip);
    return true;
}

function upsertSettingsTooltip(target, message, tooltipId) {
    if (!target) {
        return null;
    }

    let tooltip = tooltipId
        ? document.getElementById(tooltipId)
        : target.querySelector('.settings-tooltip-icon');

    if (!tooltip) {
        tooltip = createSettingsTooltipIcon(message || '');
        if (!tooltip) {
            return null;
        }

        if (tooltipId) {
            tooltip.id = tooltipId;
        }

        target.appendChild(tooltip);
    }

    const resolvedMessage = (message || '').trim();
    tooltip.title = resolvedMessage;
    tooltip.setAttribute('aria-label', resolvedMessage);
    tooltip.style.display = resolvedMessage ? '' : 'none';
    return tooltip;
}

function resolveTooltipTarget(warning) {
    if (!warning) {
        return null;
    }

    const explicitTargetId = warning.getAttribute('data-tooltip-target');
    if (explicitTargetId) {
        const explicitTarget = document.getElementById(explicitTargetId);
        if (explicitTarget) {
            const label = document.querySelector(`label[for="${explicitTargetId}"]`);
            return label || explicitTarget.closest('.form-group')?.querySelector('label, .form-label') || explicitTarget;
        }
    }

    const previousGroup = warning.previousElementSibling;
    if (previousGroup?.classList.contains('form-group')) {
        const previousGroupLabel = previousGroup.querySelector('label, .form-label');
        if (previousGroupLabel) {
            return previousGroupLabel;
        }
    }

    const formGroup = warning.closest('.form-group');
    if (formGroup) {
        const label = formGroup.querySelector('label, .form-label');
        if (label) {
            return label;
        }
    }

    const checkboxGroup = warning.previousElementSibling?.classList.contains('checkbox-group')
        ? warning.previousElementSibling
        : warning.closest('.settings-content')?.querySelector('.checkbox-group:last-of-type');
    if (checkboxGroup) {
        const checkboxLabel = checkboxGroup.querySelector('label');
        if (checkboxLabel) {
            return checkboxLabel;
        }
    }

    const switchLabel = warning.previousElementSibling?.querySelector('.switch-label')
        || warning.closest('.settings-section')?.querySelector('.switch-label');
    if (switchLabel) {
        return switchLabel;
    }

    return null;
}

function initializeSettingsTooltips() {
    const targetMessages = new Map();

    document.querySelectorAll('.settings-section .warning-text').forEach((warning) => {
        if (warning.id === 'multiQualitySecondaryFolderWarning') {
            return;
        }

        const message = (warning.innerText || warning.textContent || '').trim();
        if (!message) {
            return;
        }

        const target = resolveTooltipTarget(warning);
        if (!target) {
            return;
        }

        const messages = targetMessages.get(target) || [];
        messages.push(message);
        targetMessages.set(target, messages);
        warning.remove();
    });

    targetMessages.forEach((messages, target) => {
        const mergedMessage = messages.join('\n');
        const tooltip = upsertSettingsTooltip(target, mergedMessage, '');
        if (tooltip) {
            tooltip.dataset.baseMessage = mergedMessage;
        }
    });
}

function initSecondarySourceControls() {
    const secondarySelect = document.getElementById('multiQualitySecondaryDestinationFolderId');
    if (!secondarySelect) {
        return;
    }

    secondarySelect.addEventListener('change', updateSecondaryFolderRequirement);
    updateSecondaryFolderRequirement();
}

function updateSecondaryFolderRequirement() {
    const secondarySelect = document.getElementById('multiQualitySecondaryDestinationFolderId');
    const enabledCheckbox = document.getElementById('multiQualityEnabled');
    const configGroup = document.getElementById('multiQualityConfigGroup');
    const targetLabel = document.querySelector('label[for="multiQualitySecondaryDestinationFolderId"]');
    if (!secondarySelect) {
        return;
    }

    if (configGroup && enabledCheckbox) {
        configGroup.style.display = enabledCheckbox.checked ? 'block' : 'none';
    }

    const dynamicWarningMessage = 'Select an Atmos destination to enable the secondary download.';
    const hasDestination = !!(secondarySelect.value || '').trim();
    const shouldShowWarning = Boolean(enabledCheckbox?.checked) && !hasDestination;
    const existingTooltip = targetLabel?.querySelector('.settings-tooltip-icon');
    const baseMessage = (existingTooltip?.dataset.baseMessage || '').trim();
    const resolvedMessage = shouldShowWarning
        ? [baseMessage, dynamicWarningMessage].filter(Boolean).join('\n')
        : baseMessage;
    const tooltip = upsertSettingsTooltip(targetLabel, resolvedMessage, '');
    if (tooltip) {
        tooltip.dataset.baseMessage = baseMessage;
    }
}

async function initLibraryFolderDestinationDropdowns() {
    const primarySelect = document.getElementById('multiQualityPrimaryDestinationFolderId');
    const secondarySelect = document.getElementById('multiQualitySecondaryDestinationFolderId');
    const videoSelect = document.getElementById('videoDownloadLocation');
    if (!primarySelect && !secondarySelect && !videoSelect) {
        return;
    }

    try {
        const [allFoldersResponse, atmosFoldersResponse, videoFoldersResponse] = await Promise.all([
            fetch('/api/library/folders'),
            fetch('/api/library/folders?downloadOnly=true&contentType=atmos'),
            fetch('/api/library/folders?downloadOnly=true&contentType=video')
        ]);
        if (!allFoldersResponse.ok) {
            return;
        }

        const folders = await allFoldersResponse.json();
        if (!Array.isArray(folders)) {
            return;
        }
        const videoFolders = videoFoldersResponse.ok
            ? await videoFoldersResponse.json()
            : [];
        const atmosFolders = atmosFoldersResponse.ok
            ? await atmosFoldersResponse.json()
            : [];
        const validVideoFolders = Array.isArray(videoFolders) ? videoFolders : [];
        const validAtmosFolders = Array.isArray(atmosFolders) ? atmosFolders : [];

        const sorted = folders
            .filter(folder => folder && folder.id != null && folder.displayName)
            .slice()
            .sort((a, b) => String(a.displayName).localeCompare(String(b.displayName), undefined, { sensitivity: 'base' }));

        const sortedAtmos = validAtmosFolders
            .filter(folder => folder && folder.id != null && folder.displayName && folder.enabled !== false)
            .slice()
            .sort((a, b) => String(a.displayName).localeCompare(String(b.displayName), undefined, { sensitivity: 'base' }));

        const buildOptionsHtml = (items = sorted) => {
            return [
                '<option value="">(Use request destination)</option>',
                ...items.map(folder =>
                    `<option value="${String(folder.id)}">${escapeHtml(String(folder.displayName))}</option>`)
            ].join('');
        };

        const currentPrimary = primarySelect ? ((primarySelect.value || primarySelect.dataset.pendingValue || '').trim()) : '';
        const currentSecondary = secondarySelect ? ((secondarySelect.value || secondarySelect.dataset.pendingValue || '').trim()) : '';
        const currentVideo = videoSelect ? (videoSelect.value || '').trim() : '';
        const hasFolderIdOption = (value, items = sorted) => {
            const normalized = String(value ?? '').trim();
            if (!normalized) {
                return false;
            }

            return items.some(folder => String(folder.id).trim() === normalized);
        };
        const appendCurrentFolderOption = (select, value, labelPrefix, items = sorted) => {
            const normalized = String(value ?? '').trim();
            if (!select || !normalized || hasFolderIdOption(normalized, items)) {
                return;
            }

            const option = document.createElement('option');
            option.value = normalized;
            option.textContent = `${labelPrefix}: ${normalized}`;
            select.appendChild(option);
        };

        if (primarySelect) {
            primarySelect.innerHTML = buildOptionsHtml();
            appendCurrentFolderOption(primarySelect, currentPrimary, 'Current folder');
        }
        if (secondarySelect) {
            secondarySelect.innerHTML = buildOptionsHtml(sortedAtmos);
            appendCurrentFolderOption(secondarySelect, currentSecondary, 'Current Atmos folder', sortedAtmos);
        }
        if (videoSelect) {
            const videoOptions = [
                '<option value="">(required: select video destination folder)</option>',
                ...validVideoFolders
                    .filter(folder => folder && folder.id != null && folder.displayName && folder.enabled !== false && folder.rootPath)
                    .slice()
                    .sort((a, b) => String(a.displayName).localeCompare(String(b.displayName), undefined, { sensitivity: 'base' }))
                    .map(folder => `<option value="${escapeHtml(String(folder.rootPath))}">${escapeHtml(String(folder.displayName))}</option>`)
            ];

            const hasCurrent = currentVideo
                && validVideoFolders.some(folder =>
                    folder.enabled !== false
                    && String(folder.rootPath || '').trim().toLowerCase() === currentVideo.toLowerCase());
            if (currentVideo && !hasCurrent) {
                videoOptions.push(`<option value="${escapeHtml(currentVideo)}">Current (unmapped): ${escapeHtml(currentVideo)}</option>`);
            }

            videoSelect.innerHTML = videoOptions.join('');
        }

        if (primarySelect && currentPrimary) {
            primarySelect.value = currentPrimary;
            delete primarySelect.dataset.pendingValue;
        }
        if (secondarySelect && currentSecondary) {
            secondarySelect.value = currentSecondary;
            delete secondarySelect.dataset.pendingValue;
        }
        if (secondarySelect) {
            updateSecondaryFolderRequirement();
        }
        if (videoSelect && currentVideo) {
            videoSelect.value = currentVideo;
        }
    } catch {
        // Non-fatal: keep the default "(Use request destination)" option.
    }
}

function escapeHtml(text) {
    return String(text)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
}

function normalizeLoginPlatformId(id) {
    const normalized = String(id || '').trim().toLowerCase().replace(/-login$/, '').replace(/[^a-z0-9]/g, '');
    const aliases = {
        applemusic: 'applemusic',
        bpmsupreme: 'bpmsupreme',
        lastfm: 'lastfm',
    };
    return aliases[normalized] || normalized;
}

function readDisabledLoginPlatforms() {
    try {
        const parsed = JSON.parse(localStorage.getItem(DISABLED_LOGIN_PLATFORMS_KEY) || '[]');
        if (!Array.isArray(parsed)) {
            return new Set();
        }

        return new Set(parsed
            .map(normalizeLoginPlatformId)
            .filter(id => id && !FIXED_LOGIN_PLATFORMS.has(id)));
    } catch {
        return new Set();
    }
}

function writeDisabledLoginPlatforms(disabledPlatforms) {
    const values = Array.from(disabledPlatforms || [])
        .map(normalizeLoginPlatformId)
        .filter(id => id && !FIXED_LOGIN_PLATFORMS.has(id))
        .sort();
    localStorage.setItem(DISABLED_LOGIN_PLATFORMS_KEY, JSON.stringify(values));
    if (window.UserPrefs) {
        window.UserPrefs.set('disabledLoginPlatforms', values);
        void window.UserPrefs.flush(false);
    }
    window.dispatchEvent(new CustomEvent('deezspotag:login-tabs-updated', {
        detail: {
            disabledPlatforms: values
        }
    }));
}

async function initLoginTabControls() {
    const list = document.getElementById('loginTabControlList');
    if (!list) {
        return;
    }

    list.innerHTML = '<p class="secondary-text">Loading login tabs...</p>';
    try {
        const response = await fetch('/api/platform-registry', {
            cache: 'no-store',
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
        });
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const registry = await response.json();
        renderLoginTabControls(Array.isArray(registry) ? registry : []);
    } catch (error) {
        console.warn('Failed to load login tab controls.', error);
        list.innerHTML = '<p class="server-library-empty">Failed to load login tabs.</p>';
    }
}

function renderLoginTabControls(registry) {
    const list = document.getElementById('loginTabControlList');
    if (!list) {
        return;
    }

    const platforms = registry
        .filter(entry => entry?.requiresAuth === true && entry?.loginTabId)
        .map(entry => ({
            id: normalizeLoginPlatformId(entry.id),
            name: String(entry.name || entry.id || '').trim(),
            icon: String(entry.icon || '').trim()
        }))
        .filter(entry => entry.id && entry.name);

    if (platforms.length === 0) {
        list.innerHTML = '<p class="server-library-empty">No login tabs available.</p>';
        return;
    }

    const disabled = readDisabledLoginPlatforms();
    list.innerHTML = platforms.map(platform => {
        const fixed = FIXED_LOGIN_PLATFORMS.has(platform.id);
        const inputId = `loginTabToggle_${platform.id.replace(/[^a-z0-9_-]/g, '_')}`;
        return `
            <div class="login-tab-control-item" data-login-platform="${escapeHtml(platform.id)}">
                <label class="login-tab-control-label" for="${escapeHtml(inputId)}">
                    ${platform.icon ? `<img src="${escapeHtml(platform.icon)}" alt="">` : ''}
                    <span>${escapeHtml(platform.name)}</span>
                </label>
                ${fixed
                    ? '<span class="login-tab-control-fixed">Always shown</span>'
                    : `<span class="switch">
                        <input type="checkbox" id="${escapeHtml(inputId)}" class="login-tab-visibility-toggle" data-login-platform="${escapeHtml(platform.id)}" ${disabled.has(platform.id) ? '' : 'checked'}>
                        <span class="slider"></span>
                    </span>`}
            </div>
        `;
    }).join('');

    list.querySelectorAll('.login-tab-visibility-toggle').forEach(input => {
        input.addEventListener('change', () => {
            const nextDisabled = readDisabledLoginPlatforms();
            const platformId = normalizeLoginPlatformId(input.dataset.loginPlatform);
            if (!platformId || FIXED_LOGIN_PLATFORMS.has(platformId)) {
                return;
            }

            if (input.checked) {
                nextDisabled.delete(platformId);
            } else {
                nextDisabled.add(platformId);
            }

            writeDisabledLoginPlatforms(nextDisabled);
        });
    });
}

