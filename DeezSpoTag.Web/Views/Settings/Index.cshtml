    align-items: center;
    gap: 10px;
    min-width: 0;
    color: var(--text-primary);
    font-weight: 600;
}

.login-tab-control-label img {
    width: 24px;
    height: 24px;
    object-fit: contain;
}

.login-tab-control-fixed {
    color: var(--text-muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.lyrics-order-hint,
.artwork-order-hint {
