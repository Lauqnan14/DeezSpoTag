function setFieldValue(fieldId, value) {
    const field = document.getElementById(fieldId);
    if (field && value !== undefined && value !== null) {
        const stringValue = String(value);
        if (field instanceof HTMLSelectElement && stringValue && !Array.from(field.options).some(option => option.value === stringValue)) {
            field.dataset.pendingValue = stringValue;
        }
        field.value = stringValue;
        if (field.type === 'hidden') {
            const dropdown = field.closest('.dropdown-select');
            if (dropdown) {
                const trigger = dropdown.querySelector('.dropdown-trigger');
                const option = dropdown.querySelector(`.dropdown-option[data-value="${value}"]`);
                if (trigger && option) {
                    trigger.textContent = option.textContent || String(value);
                    dropdown.querySelectorAll('.dropdown-option').forEach(btn => btn.setAttribute('aria-selected', 'false'));
                    option.setAttribute('aria-selected', 'true');
                }
                if (fieldId === 'downloadSource') {
                    updateQualityDropdownVisibility(String(value), false);
                }
            }
        }
    }
}

function setCheckboxValue(fieldId, value) {
    const field = document.getElementById(fieldId);
    if (field) {
        field.checked = value === true;
    }
}

function setMaxBitrateValue(bitrateValue) {
    let mappedValue;
    switch (bitrateValue) {
        case 9:
            mappedValue = "9";
            break;
        case 3:
            mappedValue = "3";
            break;
        case 1:
        default:
            mappedValue = "1";
            break;
    }

    setFieldValue('maxBitrate', mappedValue);
}

function normalizeAppleVideoCodecPreference(value) {
    const normalized = String(value || '').trim().toLowerCase();
    if (!normalized) {
        return 'prefer-hevc';
    }

    if (normalized === 'hevc,avc') {
        return 'prefer-hevc';
    }

    if (normalized === 'avc,hevc') {
        return 'prefer-avc';
    }

    if (normalized === 'hevc-only' || normalized === 'h265-only') {
        return 'strict-hevc';
    }

    if (normalized === 'strict-hevc'
        || normalized === 'prefer-hevc'
        || normalized === 'prefer-avc'
        || normalized === 'auto') {
        return normalized;
    }

    return 'prefer-hevc';
}

function normalizeAppleVideoAudioType(value) {
    const normalized = String(value || '').trim().toLowerCase();
    if (!normalized) {
        return 'atmos-prefer';
    }

    if (normalized === 'atmos') {
        return 'atmos-prefer';
    }

    if (normalized === 'ac3') {
        return 'ac3-prefer';
    }

    if (normalized === 'aac' || normalized === 'stereo') {
        return 'aac-prefer';
    }

    if (normalized === 'atmos-prefer'
        || normalized === 'atmos-strict'
        || normalized === 'ac3-prefer'
        || normalized === 'ac3-strict'
        || normalized === 'aac-prefer'
        || normalized === 'aac-strict') {
        return normalized;
    }

    return 'atmos-prefer';
}

function normalizeTidalVideoMaxResolution(value) {
    const normalized = Number(value);
    if (normalized === 1080 || normalized === 720 || normalized === 480 || normalized === 360) {
        return normalized;
    }

    return 1080;
}

