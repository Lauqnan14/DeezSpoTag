async function initNotificationPreferences() {
    const container = document.getElementById('notificationEventRows');
    const saveButton = document.getElementById('saveNotificationPreferencesBtn');
    const testButton = document.getElementById('testNotificationWebhookBtn');
    const retention = document.getElementById('notificationRetentionDays');
    const webhookUrl = document.getElementById('notificationWebhookUrl');
    const status = document.getElementById('notificationPreferencesStatus');
    if (!container || !saveButton) {
        return;
    }

    try {
        const response = await fetch('/api/notifications/preferences');
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const payload = await response.json();
        renderNotificationEventRows(payload?.events);
        if (retention) {
            retention.value = payload?.retentionDays ?? 30;
        }
        if (webhookUrl && payload?.hasWebhookUrl) {
            webhookUrl.placeholder = 'Saved - enter a new URL to replace it';
        }
        if (status) {
            status.textContent = payload?.hasWebhookUrl
                ? 'Webhook configured.'
                : 'No webhook configured. In-app notifications are still delivered.';
        }
    } catch (error) {
        container.textContent = 'Failed to load notification preferences.';
        return;
    }

    saveButton.addEventListener('click', async () => {
        try {
            saveButton.disabled = true;
            const body = {
                events: collectNotificationEventRows(),
                retentionDays: Number(retention?.value) || 30
            };
            if (webhookUrl?.value.trim()) {
                body.webhookUrl = webhookUrl.value.trim();
            }
            const response = await fetch('/api/notifications/preferences', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }
            if (webhookUrl) {
                webhookUrl.value = '';
            }
            showToast('Notification settings saved.', 'success');
        } catch (error) {
            showToast('Failed to save notification settings.', 'error');
        } finally {
            saveButton.disabled = false;
        }
    });

    if (testButton) {
        testButton.addEventListener('click', async () => {
            try {
                testButton.disabled = true;
                const response = await fetch('/api/notifications/webhook-test', { method: 'POST' });
                const payload = await response.json().catch(() => null);
                if (!response.ok) {
                    throw new Error(payload?.error || `HTTP ${response.status}`);
                }
                showToast('Test notification delivered.', 'success');
            } catch (error) {
                showToast(error?.message || 'Webhook test failed.', 'error');
            } finally {
                testButton.disabled = false;
            }
        });
    }
}

function bindApiTokenActions() {
    const input = document.getElementById('apiTokenInput');
    const revealButton = document.getElementById('revealApiTokenBtn');
    const copyButton = document.getElementById('copyApiTokenBtn');
    const regenerateButton = document.getElementById('regenerateApiTokenBtn');
    const status = document.getElementById('apiTokenStatus');
    if (!input || !revealButton || !copyButton || !regenerateButton || revealButton.dataset.bound === 'true') {
        return;
    }

    revealButton.dataset.bound = 'true';
    setApiTokenMasked(input, revealButton);
    if (status) {
        status.textContent = 'Token is configured. Reveal or copy it to configure an API client.';
    }

    revealButton.addEventListener('click', async () => {
        if (input.type === 'text') {
            setApiTokenMasked(input, revealButton);
            return;
        }

        try {
            revealButton.disabled = true;
            setApiTokenRevealed(input, revealButton, await fetchApiTokenValue());
        } catch (error) {
            showToast(error?.message || 'Failed to read API token.', 'error');
        } finally {
            revealButton.disabled = false;
        }
    });

    copyButton.addEventListener('click', async () => {
        try {
            copyButton.disabled = true;
            const token = input.type === 'text' ? input.value : await fetchApiTokenValue();
            await navigator.clipboard.writeText(token);
            showToast('API token copied to clipboard.', 'success');
        } catch (error) {
            showToast(error?.message || 'Failed to copy API token.', 'error');
        } finally {
            copyButton.disabled = false;
        }
    });

    regenerateButton.addEventListener('click', async () => {
        if (!window.DeezSpoTag?.ui?.confirm) {
            showToast('App dialog system is unavailable.', 'error');
            return;
        }

        const confirmed = await window.DeezSpoTag.ui.confirm(
            'Regenerate the API token? Existing clients using the current token will stop working until they are updated.',
            {
                title: 'Regenerate API Token',
                okText: 'Regenerate',
                cancelText: 'Cancel'
            });
        if (!confirmed) {
            return;
        }

        try {
            regenerateButton.disabled = true;
            const response = await fetch('/api/settings/api-token', { method: 'POST' });
            if (!response.ok) {
                const payload = await response.json().catch(() => null);
                throw new Error(payload?.error || `Failed to regenerate API token (HTTP ${response.status}).`);
            }
            const payload = await response.json();
            setApiTokenRevealed(input, revealButton, payload.token);
            if (status) {
                status.textContent = 'Token regenerated. Update every API client with the new value.';
            }
            showToast('API token regenerated.', 'success');
        } catch (error) {
            showToast(error?.message || 'Failed to regenerate API token.', 'error');
        } finally {
            regenerateButton.disabled = false;
        }
    });
}

function bindMediaServerLibraryActions() {
    const syncButton = document.getElementById('syncServerLibrariesBtn');
    const saveButton = document.getElementById('saveServerLibrariesBtn');
    const container = document.getElementById('serverLibraryConfigContainer');
    if (!syncButton || !saveButton || !container || syncButton.dataset.bound === 'true') {
        return;
    }

    syncButton.addEventListener('click', async () => {
        try {
            syncButton.disabled = true;
            await loadMediaServerLibraryConfiguration(true);
            showToast('Server libraries refreshed.', 'success');
        } catch (error) {
            showToast(error?.message || 'Failed to refresh server libraries.', 'error');
        } finally {
            syncButton.disabled = false;
        }
    });

    saveButton.addEventListener('click', async () => {
        try {
            if (mediaServerLibraryAutoSaveTimer) {
                window.clearTimeout(mediaServerLibraryAutoSaveTimer);
                mediaServerLibraryAutoSaveTimer = 0;
            }
            saveButton.disabled = true;
            await saveMediaServerLibraryConfiguration();
            showToast('Server library configuration saved.', 'success');
        } catch (error) {
            console.error('Failed to save media server library configuration.', error);
            setMediaServerLibraryStatus(error?.message || 'Failed to save server libraries.', true);
            showToast(error?.message || 'Failed to save server libraries.', 'error');
        } finally {
            saveButton.disabled = false;
        }
    });

    container.addEventListener('change', event => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement)) {
            return;
        }

        if (input.matches('[data-library-include]')) {
            if (input.checked) {
                const row = input.closest('[data-library-row]');
                const hideInput = row?.querySelector('[data-library-hide]');
                if (hideInput instanceof HTMLInputElement && hideInput.checked) {
                    hideInput.checked = false;
                }
            }

            queueMediaServerLibraryAutoSave();
            return;
        }

        if (input.matches('[data-server-autoinclude]')) {
            queueMediaServerLibraryAutoSave();
            return;
        }

        if (!input.matches('[data-library-hide]')) {
            return;
        }

        const row = input.closest('[data-library-row]');
        applyLibraryHideToggleForRow(row);
        queueMediaServerLibraryAutoSave();
    });

    syncButton.dataset.bound = 'true';
}

async function initSettings() {
    try {
        const settingsData = await getSettingsData();
        
        if (settingsData) {
            defaultSettings = settingsData.defaultSettings;
            const mergedSettings = mergeWithDefaults(settingsData.settings, defaultSettings);
            
            loadSettings(mergedSettings);
            try {
                await loadLibraryScanSettings();
            } catch (librarySettingsError) {
                console.warn('Failed to load library scan settings:', librarySettingsError);
                showToast(`Library scan settings failed to load: ${librarySettingsError.message}`, 'error');
            }
            loadAppleNotificationPreference();
            await loadMediaServerLibraryConfiguration(false);
            settingsReady = true;
        } else {
            throw new Error('No settings data received');
        }
    } catch (error) {
        console.error('Error loading settings:', error);
        showToast('Failed to load settings: ' + error.message, 'error');
    } finally {
        initializeSettingsTooltips();
    }
}

function mergeWithDefaults(settings, defaults) {
    if (!settings || !defaults) {
        return defaults || {};
    }
    
    const merged = JSON.parse(JSON.stringify(defaults));
    
    Object.keys(settings).forEach(key => {
        if (key === 'tags') {
            if (settings.tags && defaults.tags) {
                merged.tags = { ...defaults.tags, ...settings.tags };
            }
            return;
        }
        if (settings[key] !== undefined && settings[key] !== null) {
            merged[key] = settings[key];
        }
    });
    
    return merged;
}

async function getSettingsData() {
    try {
        const response = await fetch('/api/settings');
        
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        const data = await response.json();
        
        return {
            settings: data.settings,
            defaultSettings: data.defaultSettings,
        };
    } catch (error) {
        console.error('Failed to fetch settings:', error);
        throw error;
    }
}

