}

function toggleGenreTagAliasEmptyState() {
    const rowsContainer = document.getElementById('genreTagAliasRows');
    const empty = document.getElementById('genreTagAliasEmpty');
    if (!rowsContainer || !empty) {
        return;
    }

    empty.style.display = rowsContainer.children.length === 0 ? 'block' : 'none';
}

function renderGenreTagAliasRules(rules) {
    const rowsContainer = document.getElementById('genreTagAliasRows');
    if (!rowsContainer) {
        return;
    }

    rowsContainer.innerHTML = '';
    const source = Array.isArray(rules) ? rules : [];
    source.forEach(rule => {
        const alias = String(rule?.alias || '').trim();
        const canonical = String(rule?.canonical || '').trim();
        if (!alias || !canonical) {
            return;
        }

        rowsContainer.appendChild(createGenreTagAliasRuleRow(alias, canonical));
    });

    toggleGenreTagAliasEmptyState();
}

function collectGenreTagAliasRules() {
    const rowsContainer = document.getElementById('genreTagAliasRows');
    if (!rowsContainer) {
        return [];
    }

    const rules = [];
    const seen = new Set();
    rowsContainer.querySelectorAll('.genre-alias-row').forEach(row => {
        const alias = String(row.querySelector('.genre-alias-alias')?.value || '').trim();
        const canonical = String(row.querySelector('.genre-alias-canonical')?.value || '').trim();
        if (!alias || !canonical) {
            return;
        }

        const key = buildGenreTagAliasLookupKey(alias);
        if (!key) {
            return;
        }

        if (seen.has(key)) {
            return;
        }

        seen.add(key);
        rules.push({ alias, canonical });
    });

    return rules;
}

function renderGenreTagBlockList(values) {
    const input = document.getElementById('genreTagBlockList');
    if (!input) {
        return;
    }

    const list = Array.isArray(values) ? values : defaultGenreTagBlockList;
    input.value = list
        .map(value => String(value || '').trim())
        .filter(Boolean)
        .join('\n');
}

function collectGenreTagBlockList() {
    const input = document.getElementById('genreTagBlockList');
    if (!input) {
        return [];
    }

    const seen = new Set();
    const values = [];
    String(input.value || '')
        .split(/[\n,;]+/)
        .map(value => value.trim())
        .filter(Boolean)
        .forEach(value => {
            const key = buildGenreTagAliasLookupKey(value);
            if (key && !seen.has(key)) {
                seen.add(key);
                values.push(value);
            }
        });
    return values;
}

function buildGenreTagAliasLookupKey(value) {
    return Array.from(String(value || '').trim())
        .filter(character => /[\p{L}\p{N}]/u.test(character))
        .map(character => character.toLowerCase())
        .join('');
}

function updateGenreTagAliasRulesState() {
