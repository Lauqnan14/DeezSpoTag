function isAtmosDownloadSource(value) {
    return String(value || '').startsWith('atmos:');
}

function resolveDownloadSourceService(value) {
    const normalized = String(value || '').trim().toLowerCase();
    if (normalized === 'atmos:auto') {
        return 'auto';
    }

    if (normalized === 'atmos:apple') {
        return 'apple';
    }

    if (normalized === 'atmos:tidal') {
        return 'tidal';
    }

    if (normalized === 'atmos:amazon') {
        return 'amazon';
    }

    return normalized || 'deezer';
}

function resolveAtmosEngineFromDownloadSource(value) {
    const normalized = String(value || '').trim().toLowerCase();
    if (normalized === 'atmos:tidal') {
        return 'tidal';
    }

    if (normalized === 'atmos:amazon') {
        return 'amazon';
    }

    return 'apple';
}

function resolveDownloadSourceSelection(settings) {
    const loadedDownloadEngineOrder = settings.downloadEngineOrder || settings.DownloadEngineOrder;
    if (loadedDownloadEngineOrder?.enabled === true) {
        return 'custom';
    }

    const sourceContentType = String(settings.downloadSourceContentType || settings.DownloadSourceContentType || 'stereo').trim().toLowerCase();
    const service = String(settings.service || 'deezer').trim().toLowerCase();
    if (sourceContentType !== 'atmos') {
        return service || 'deezer';
    }

    const mq = settings.multiQuality || {};
    if (service === 'auto') {
        return 'atmos:auto';
    }

    if (service === 'tidal' || String(mq.atmosEngine || '').trim().toLowerCase() === 'tidal') {
        return 'atmos:tidal';
    }

    if (service === 'amazon' || String(mq.atmosEngine || '').trim().toLowerCase() === 'amazon') {
        return 'atmos:amazon';
    }

    return 'atmos:apple';
}

function syncAtmosSourceControls(value) {
    const normalized = String(value || '').trim().toLowerCase();
    if (!isAtmosDownloadSource(normalized)) {
        return;
    }

    if (normalized === 'atmos:auto') {
        setFieldValue('multiQualityAtmosEngine', 'apple');
        setCheckboxValue('multiQualityAtmosSearchFallback', true);
        setCheckboxValue('multiQualityAtmosDownloadFallback', true);
        setFieldValue('applePreferredAudioProfile', 'atmos');
        return;
    }

    const engine = resolveAtmosEngineFromDownloadSource(normalized);
    setFieldValue('multiQualityAtmosEngine', engine);
    setCheckboxValue('multiQualityAtmosSearchFallback', false);
    setCheckboxValue('multiQualityAtmosDownloadFallback', false);
    if (engine === 'apple') {
        setFieldValue('applePreferredAudioProfile', 'atmos');
    }
}

function initDownloadSourceDropdowns() {
    const dropdowns = document.querySelectorAll('.dropdown-select');
    dropdowns.forEach(dropdown => {
        const input = dropdown.querySelector('input[type="hidden"]');
        const trigger = dropdown.querySelector('.dropdown-trigger');
        const menu = dropdown.querySelector('.dropdown-menu');
        const options = dropdown.querySelectorAll('.dropdown-option');
        if (!input || !trigger || !menu) {
            return;
        }

        const closeMenu = () => menu.classList.remove('open');
        const openMenu = () => menu.classList.add('open');
        const toggleMenu = (event) => {
            event.stopPropagation();
            menu.classList.toggle('open');
        };

        trigger.addEventListener('click', toggleMenu);
        options.forEach(option => {
            option.addEventListener('click', (event) => {
                event.stopPropagation();
                const value = option.getAttribute('data-value') || '';
                if (!value) {
                    return;
                }
                input.value = value;
                trigger.textContent = option.textContent || value;
                options.forEach(btn => btn.setAttribute('aria-selected', 'false'));
                option.setAttribute('aria-selected', 'true');
                closeMenu();
                if (input.id === 'downloadSource') {
                    syncAtmosSourceControls(value);
                    updateQualityDropdownVisibility(value, true);
                }
            });
        });

        document.addEventListener('click', closeMenu);
    });

    const downloadSourceValue = document.getElementById('downloadSource')?.value || 'deezer';
    updateQualityDropdownVisibility(downloadSourceValue, false);
}

function updateQualityDropdownVisibility(source, autoOpen) {
    const normalizedSource = resolveDownloadSourceService(source);
    const tidalGroup = document.getElementById('multisource-tidalQualityGroup');
    const qobuzGroup = document.getElementById('multisource-qobuzQualityGroup');
    const appleGroup = document.getElementById('apple-qualityGroup');
    const deezerGroup = document.getElementById('deezer-maxBitrateGroup');
    const fallbackQuality = document.getElementById('fallbackBitrate');
    const fallbackQualityLabel = document.querySelector('label[for="fallbackBitrate"]');
    if (tidalGroup) {
        tidalGroup.style.display = normalizedSource === 'tidal' && !isAtmosDownloadSource(source) ? 'block' : 'none';
    }
    if (qobuzGroup) {
        qobuzGroup.style.display = normalizedSource === 'qobuz' ? 'block' : 'none';
    }
    if (appleGroup) {
        appleGroup.style.display = normalizedSource === 'apple' && !isAtmosDownloadSource(source) ? 'block' : 'none';
    }
    if (deezerGroup) {
        deezerGroup.style.display = normalizedSource === 'deezer' ? 'block' : 'none';
    }
    updateCustomEngineOrderVisibility(source);
    if (fallbackQuality) {
        fallbackQuality.removeAttribute('title');
        if (fallbackQualityLabel) {
            fallbackQualityLabel.removeAttribute('title');
        }
    }

    if (!autoOpen) {
        return;
    }

    if (source === 'tidal') {
        document.getElementById('multisource-tidalQualityMenu')?.classList.add('open');
    } else if (source === 'qobuz') {
        document.getElementById('multisource-qobuzQualityMenu')?.classList.add('open');
    } else if (source === 'apple') {
        document.getElementById('applePreferredAudioProfileMenu')?.classList.add('open');
    }
}

