@{
    ViewData["Title"] = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var settingsDownloadSourceOptions = DeezSpoTag.Services.Download.DownloadSourceCatalog.GetSettingsSourceOptions();
    var settingsQualityCatalog = DeezSpoTag.Services.Download.QualityCatalog.GetEngineQualityOptions();
    var settingsSourceLabels = DeezSpoTag.Services.Download.DownloadSourceCatalog.GetEngineOptions()
        .ToDictionary(option => option.Value, option => option.Label, StringComparer.OrdinalIgnoreCase);
    var defaultDownloadEngineOrderJson = System.Text.Json.JsonSerializer.Serialize(
        DeezSpoTag.Core.Models.Settings.DownloadEngineOrderSettings.CreateDefault().Engines.Select(engine =>
        {
            settingsQualityCatalog.TryGetValue(engine.Engine, out var qualityOptions);
            var qualityLabels = (qualityOptions ?? Array.Empty<DeezSpoTag.Services.Download.QualityCatalog.QualityOption>())
                .ToDictionary(option => option.Value, option => option.Label, StringComparer.OrdinalIgnoreCase);
            return new
            {
                engine = engine.Engine,
                label = settingsSourceLabels.TryGetValue(engine.Engine, out var label) ? label : engine.Engine,
                enabled = engine.Enabled,
                qualities = engine.Qualities.Select(quality => new
                {
                    quality = quality.Quality,
                    label = qualityLabels.TryGetValue(quality.Quality, out var qualityLabel) ? qualityLabel : quality.Quality,
                    enabled = quality.Enabled
                }).ToList()
            };
        }).ToList());
}

@section Styles {
<link rel="stylesheet" href="@Url.Content("~/css/settings.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/library.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/dropdown-select.css")" />
<style>
.settings-page {
    padding: 20px;
    padding-bottom: 120px;
    color: var(--text-primary);
}

.settings-width {
    max-width: none;
    width: 100%;
    margin: 0 0 32px 0;
}

.settings-section {
    background: var(--bg-secondary);
    border: 1px solid var(--border-secondary);
    border-radius: 10px;
    margin-bottom: 24px;
    overflow: hidden;
}

.settings-page .settings-width > .settings-section:last-child {
    border-bottom: 1px solid var(--border-secondary);
    margin-bottom: 24px;
    padding-bottom: 30px;
}

.settings-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 20px;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-weight: 600;
    cursor: pointer;
    user-select: none;
}

.settings-header::after {
    content: 'expand_more';
    font-family: 'Material Icons';
    font-size: 1.25rem;
    margin-left: auto;
    transition: transform 0.2s ease;
    color: var(--text-muted);
}

.settings-section:has(> .settings-content.active) > .settings-header::after {
    transform: rotate(180deg);
}

.settings-header:hover {
    background: var(--bg-quaternary);
}

.settings-header .material-icons {
    font-size: 1.5rem;
}

.settings-page.material-icons-pending .material-icons,
.settings-page.material-icons-pending .settings-header::after {
    visibility: hidden;
}

.settings-content {
    padding: 20px;
    display: none;
}

.settings-content.active {
    display: block;
}

.settings-subsection {
    border-top: 1px solid var(--border-secondary);
    margin-top: 8px;
    padding-top: 18px;
}

.settings-subsection:first-child {
    border-top: 0;
    margin-top: 0;
    padding-top: 0;
}

.settings-subsection-title {
    color: var(--primary-color);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
    text-transform: uppercase;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 6px;
    color: var(--text-secondary);
    font-weight: 500;
}

.form-group input,
.form-group select,
.form-group textarea {
