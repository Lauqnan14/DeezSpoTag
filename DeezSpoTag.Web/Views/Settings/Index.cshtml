@@media (max-width: 768px) {
    .form-row,
    .form-row-3,
    .form-row-half,
    .multi-quality-atmos-grid,
    .settings-container {
        grid-template-columns: 1fr;
        flex-direction: column;
    }
    
    .settings-page {
        padding: 10px 10px 100px 10px;
    }
    
    .btn-group {
        flex-direction: column;
    }

    .server-library-pin-controls {
        align-items: stretch;
    }

    .server-library-pin-controls input,
    .server-library-pin-controls .action-btn {
        min-width: 0;
        max-width: none;
        width: 100%;
    }
}
</style>
}

<div class="settings-page material-icons-pending">
    <h1 style="margin-bottom: 30px; color: var(--text-primary);">Settings</h1>
    <p class="secondary-text" style="margin-top: -16px; margin-bottom: 20px;">
        This page controls global download/runtime behavior. AutoTag profile tag choices are configured separately on the AutoTag page.
    </p>

    <div class="settings-width">
        <div class="settings-section" id="download-settings">
            <div class="settings-header">
                <span class="material-icons">get_app</span>
                Download Settings
            </div>
            <div class="settings-content">
                <div class="form-row">
                    <div class="form-group">
                        <label for="downloadSource">Source</label>
                        <div class="dropdown-select" data-dropdown="downloadSource">
                            <button type="button" class="dropdown-trigger" id="downloadSourceTrigger">Deezer</button>
                            <div class="dropdown-menu" id="downloadSourceMenu">
                                <div class="download-source-section-label">Stereo</div>
                                @foreach (var option in settingsDownloadSourceOptions)
                                {
                                    <button type="button" class="dropdown-option" data-value="@option.Value">@option.Label</button>
                                }
                                <div class="download-source-section-label">Atmos</div>
                                <button type="button" class="dropdown-option" data-value="atmos:auto">Auto</button>
                                <button type="button" class="dropdown-option" data-value="atmos:apple">Apple Music</button>
                                <button type="button" class="dropdown-option" data-value="atmos:tidal">Tidal</button>
                                <button type="button" class="dropdown-option" data-value="atmos:amazon">Amazon Music</button>
                            </div>
                            <input type="hidden" id="downloadSource" value="deezer">
                        </div>
                    </div>
                    <div class="form-group" id="multiQualityGroup">
                        <div class="form-label">Multi-quality downloads</div>
                        <div class="checkbox-group">
                            <input type="checkbox" id="multiQualityEnabled">
                            <label for="multiQualityEnabled">Enable dual-profile downloads (Atmos + Stereo)</label>
                        </div>
                        <div class="warning-text">Queues both Atmos and Stereo and uses separate destination folders to avoid overwrites; best paired with automation (watchlists/playlist monitor).</div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <div class="engine-quality-stack">
	                            <div class="form-group" id="multisource-tidalQualityGroup" style="display: none;">
	                                <label for="multisource-tidalQuality">Tidal Quality</label>
	                                <div class="dropdown-select" data-dropdown="multisource-tidalQuality">
	                                    <button type="button" class="dropdown-trigger" id="multisource-tidalQualityTrigger">Max Hi-Res (24-bit/192kHz)</button>
	                                    <div class="dropdown-menu" id="multisource-tidalQualityMenu">
	                                        <button type="button" class="dropdown-option" data-value="HI_RES_LOSSLESS">Max Hi-Res (24-bit/192kHz)</button>
	                                        <button type="button" class="dropdown-option" data-value="HI_RES">Hi-Res (24-bit/96kHz)</button>
	                                        <button type="button" class="dropdown-option" data-value="LOSSLESS">CD Lossless (16-bit/44.1kHz)</button>
	                                        <button type="button" class="dropdown-option" data-value="HIGH">MP3 (320kbps)</button>
	                                        <button type="button" class="dropdown-option" data-value="LOW">Low (96kbps)</button>
	                                    </div>
	                                    <input type="hidden" id="multisource-tidalQuality" value="HI_RES_LOSSLESS">
	                                </div>
                            </div>
	                            <div class="form-group" id="multisource-qobuzQualityGroup" style="display: none;">
	                                <label for="multisource-qobuzQuality">Qobuz Quality</label>
	                                <div class="dropdown-select" data-dropdown="multisource-qobuzQuality">
	                                    <button type="button" class="dropdown-trigger" id="multisource-qobuzQualityTrigger">Max Hi-Res (24-bit/192kHz)</button>
	                                    <div class="dropdown-menu" id="multisource-qobuzQualityMenu">
	                                        <button type="button" class="dropdown-option" data-value="27">Max Hi-Res (24-bit/192kHz)</button>
	                                        <button type="button" class="dropdown-option" data-value="7">Hi-Res (24-bit/96kHz)</button>
	                                        <button type="button" class="dropdown-option" data-value="6">CD Lossless (16-bit/44.1kHz)</button>
