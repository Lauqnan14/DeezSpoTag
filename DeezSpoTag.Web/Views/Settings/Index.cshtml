function setupAccordionToggle() {
    document.querySelectorAll('.settings-header').forEach(header => {
        header.addEventListener('click', function() {
            const content = this.nextElementSibling;
            if (!content || !content.classList.contains('settings-content')) {
                return;
            }
            const isActive = content.classList.contains('active');

            // Scope to the enclosing settings-width so the two columns are independent.
            const settingsWidth = this.closest('.settings-width') || document;
            settingsWidth.querySelectorAll('.settings-content').forEach(c => c.classList.remove('active'));

            if (!isActive) {
                content.classList.add('active');
            }
        });
    });

    const firstContent = document.querySelector('.settings-width .settings-section > .settings-content');
    if (firstContent) {
        firstContent.classList.add('active');
    }
}

