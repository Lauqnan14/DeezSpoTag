@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Meloday Playlists";
}

@section Styles {
<style>
.meloday-page {
    --ml-accent: var(--primary-color, #22d3ee);
    display: grid;
    gap: 18px;
    padding: 18px 22px 32px;
    max-width: 1280px;
    margin: 0 auto;
    color: var(--text-primary);
}

/* ---------- header ---------- */
.meloday-page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
}

.meloday-page-heading h1 {
    margin: 0;
    font-size: 26px;
    font-weight: 800;
    color: var(--ml-accent);
    letter-spacing: 0.2px;
}

.meloday-page-heading p {
    margin: 4px 0 0;
    color: var(--text-muted);
    font-size: 13px;
}

.meloday-page-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.meloday-enable {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid color-mix(in srgb, var(--ml-accent) 30%, var(--border-secondary));
    border-radius: 12px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}

.meloday-enable input {
    accent-color: var(--ml-accent);
    width: 16px;
    height: 16px;
}

/* ---------- help card ---------- */
.meloday-help-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid color-mix(in srgb, var(--ml-accent) 35%, var(--border-secondary));
    border-radius: 16px;
    background: color-mix(in srgb, var(--ml-accent) 7%, var(--bg-secondary));
    box-shadow: 0 0 22px color-mix(in srgb, var(--ml-accent) 12%, transparent);
}

.meloday-help-card .material-icons {
    color: var(--ml-accent);
    font-size: 22px;
    margin-top: 2px;
}

.meloday-help-card strong {
    display: block;
    font-size: 14px;
    margin-bottom: 2px;
}

.meloday-help-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 12.5px;
    line-height: 1.45;
}

/* ---------- cards ---------- */
.meloday-card {
    border: 1px solid var(--border-secondary);
    border-radius: 16px;
    background: var(--bg-secondary);
    padding: 16px 18px;
    display: grid;
    gap: 14px;
}

.meloday-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
}

.meloday-card-title {
    display: flex;
    align-items: flex-start;
    gap: 10px;
}

.meloday-card-title > .material-icons {
    color: var(--ml-accent);
    font-size: 22px;
    margin-top: 2px;
}

.meloday-card-title h2 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
}

.meloday-card-title p {
    margin: 3px 0 0;
    color: var(--text-muted);
    font-size: 12.5px;
}

/* ---------- schedule slots ---------- */
.meloday-slot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
}

.meloday-time-slot {
    display: grid;
    gap: 8px;
    padding: 12px;
    border: 1px solid color-mix(in srgb, var(--ml-accent) 34%, var(--border-secondary));
    border-radius: 14px;
    background: var(--bg-primary, var(--bg-secondary));
    box-shadow: inset 0 0 18px color-mix(in srgb, var(--ml-accent) 6%, transparent);
}

.meloday-time-slot-icon .material-icons {
    color: var(--ml-accent);
    font-size: 22px;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--ml-accent) 45%, transparent));
}

.meloday-time-slot-name {
    font-size: 13px;
    font-weight: 700;
}

.meloday-time-field {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border: 1px solid var(--border-secondary);
    border-radius: 9px;
    background: color-mix(in srgb, var(--ml-accent) 6%, var(--bg-secondary));
    color: var(--text-muted);
}

.meloday-time-field .material-icons {
    font-size: 15px;
}

.meloday-time-field input {
    border: none;
    background: transparent;
    color: var(--text-primary);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    width: 92px;
    padding: 0;
}

.meloday-time-field input:focus {
    outline: none;
}

.meloday-time-field input::-webkit-calendar-picker-indicator {
    filter: invert(0.7);
}

/* ---------- libraries ---------- */
.meloday-view-toggle {
    display: inline-flex;
    border: 1px solid var(--border-secondary);
    border-radius: 10px;
    overflow: hidden;
}

.meloday-view-toggle button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 12.5px;
    font-weight: 600;
    padding: 8px 14px;
    cursor: pointer;
}

.meloday-view-toggle button .material-icons {
    font-size: 16px;
}

.meloday-view-toggle button.is-active {
    background: color-mix(in srgb, var(--ml-accent) 16%, transparent);
    color: var(--ml-accent);
}

.meloday-library-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.meloday-page.is-list .meloday-library-grid {
    grid-template-columns: 1fr;
}

.meloday-library-card {
    display: grid;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--border-secondary);
    border-radius: 14px;
    background: var(--bg-primary, var(--bg-secondary));
}

.meloday-library-head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.meloday-library-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    flex: 0 0 auto;
}

.meloday-library-tile .material-icons {
    font-size: 22px;
    color: #fff;
}

.meloday-library-tile.accent-0 { background: #7c5cff; }
.meloday-library-tile.accent-1 { background: #d9a514; }
.meloday-library-tile.accent-2 { background: #14b8a6; }
.meloday-library-tile.accent-3 { background: #3fae4d; }
.meloday-library-tile.accent-4 { background: #e0567f; }
.meloday-library-tile.accent-5 { background: #4f8ff7; }
.meloday-library-tile.accent-6 { background: #f97316; }

.meloday-library-id {
    min-width: 0;
    margin-right: auto;
}

.meloday-library-id h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.meloday-library-id p {
    margin: 2px 0 0;
    color: var(--text-muted);
    font-size: 12px;
}

.meloday-library-max,
.meloday-library-mode {
    display: grid;
    gap: 4px;
    justify-items: start;
}

.meloday-library-max label,
.meloday-library-mode label {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

.meloday-library-max select {
    border: 1px solid var(--border-secondary);
    border-radius: 9px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 10px;
}

.meloday-mode-segmented {
    display: inline-flex;
    border: 1px solid var(--border-secondary);
    border-radius: 9px;
    overflow: hidden;
}

.meloday-mode-segmented button {
    border: none;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    cursor: pointer;
}

.meloday-mode-segmented button.is-active {
    background: color-mix(in srgb, var(--ml-accent) 18%, transparent);
    color: var(--ml-accent);
}

/* slot chips */
.meloday-library-chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: 8px;
}

.meloday-slot-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--border-secondary);
    border-radius: 10px;
    background: var(--bg-secondary);
    cursor: pointer;
    min-width: 0;
}

.meloday-slot-chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.meloday-slot-chip-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    border-radius: 5px;
    border: 1px solid var(--border-secondary);
    color: transparent;
    flex: 0 0 auto;
}

.meloday-slot-chip-check .material-icons {
    font-size: 13px;
}

.meloday-slot-chip-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.meloday-slot-chip-time {
    margin-left: auto;
    font-size: 11.5px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
}

.meloday-slot-chip.is-selected {
    border-color: color-mix(in srgb, var(--ml-accent) 55%, transparent);
    background: color-mix(in srgb, var(--ml-accent) 10%, var(--bg-secondary));
    box-shadow: 0 0 12px color-mix(in srgb, var(--ml-accent) 14%, transparent);
}

.meloday-slot-chip.is-selected .meloday-slot-chip-check {
    background: var(--ml-accent);
    border-color: var(--ml-accent);
    color: #04121a;
}

.meloday-slot-chip.is-selected .meloday-slot-chip-name,
.meloday-slot-chip.is-selected .meloday-slot-chip-time {
    color: var(--text-primary);
}

.meloday-library-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    border-top: 1px solid var(--border-secondary);
    padding-top: 10px;
}

.meloday-library-example {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
    flex-wrap: wrap;
}

.meloday-library-example-label {
    color: var(--text-muted);
    font-size: 12px;
    white-space: nowrap;
}

.meloday-library-example strong {
    font-size: 12.5px;
    color: var(--ml-accent);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.meloday-library-meta {
    display: flex;
    align-items: center;
    gap: 14px;
}

.meloday-library-counter {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-secondary);
}

.meloday-library-counter.is-over-limit {
    color: var(--danger-color, #e5484d);
}

.meloday-library-note {
    color: var(--text-muted);
    font-size: 11.5px;
    white-space: nowrap;
}

/* ---------- sync targets ---------- */
.meloday-target-server-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    max-width: 520px;
}

.meloday-target-option {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border-secondary);
    background: var(--bg-primary, var(--bg-secondary));
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}

.meloday-target-option input {
    accent-color: var(--ml-accent);
    width: 15px;
    height: 15px;
}

/* ---------- advanced ---------- */
.meloday-advanced-header {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    text-align: left;
}

.meloday-advanced-header .material-icons {
    font-size: 18px;
    transition: transform 0.15s ease;
}

.meloday-advanced-header[aria-expanded="true"] .meloday-advanced-chevron {
    transform: rotate(180deg);
}

.meloday-advanced-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
}

.meloday-advanced-grid .field-group {
    display: grid;
    gap: 6px;
}

.meloday-advanced-grid .field-label {
    font-size: 12px;
    color: var(--text-muted);
}

.meloday-advanced-grid input {
    width: 100%;
    border: 1px solid var(--border-secondary);
    border-radius: 9px;
    background: var(--bg-primary, var(--bg-secondary));
    color: var(--text-primary);
    font: inherit;
    font-size: 13px;
    padding: 8px 10px;
}

/* ---------- artwork ---------- */
.meloday-artwork-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.meloday-artwork-count {
    font-size: 13px;
    font-weight: 700;
}

.meloday-artwork-hint {
    color: var(--text-muted);
    font-size: 12px;
}

.meloday-artwork-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(74px, 1fr));
    gap: 8px;
}

.meloday-artwork-thumb {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border-secondary);
}

.meloday-artwork-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.meloday-artwork-thumb .meloday-artwork-owners {
    position: absolute;
    left: 4px;
    top: 4px;
    background: rgba(4, 12, 20, 0.78);
    color: #fff;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 5px;
}

.meloday-artwork-assignments {
    display: grid;
    gap: 4px;
}

.meloday-artwork-assignment {
    color: var(--text-muted);
    font-size: 12px;
}

/* ---------- buttons ---------- */
.meloday-page .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 10px;
    font-weight: 700;
}

.meloday-page .action-btn .material-icons {
    font-size: 16px;
}

.meloday-page .action-btn-primary {
    background: var(--ml-accent);
    border-color: var(--ml-accent);
    color: #04121a;
}

@@media (max-width: 900px) {
    .meloday-library-grid {
        grid-template-columns: 1fr;
    }

    .meloday-target-server-grid {
        grid-template-columns: 1fr;
    }
}
</style>
}

<div class="meloday-page" id="meloday-page">
    <div class="meloday-page-header">
        <div class="meloday-page-heading">
            <h1>Meloday Playlists</h1>
            <p>Automatically create time-based playlists from your libraries</p>
        </div>
        <div class="meloday-page-actions">
            <label class="meloday-enable" for="meloday-enabled">
                <input id="meloday-enabled" type="checkbox" />
                <span>Enable Meloday</span>
            </label>
            <button id="runMeloday" class="action-btn" type="button">
                <span class="material-icons">play_arrow</span>
                <span>Run now</span>
            </button>
            <button id="saveMelodaySettings" class="action-btn action-btn-primary" type="button">
                <span class="material-icons">save</span>
                <span>Save changes</span>
            </button>
        </div>
    </div>

    <div class="meloday-help-card">
        <span class="material-icons">auto_awesome</span>
        <div>
            <strong>Meloday creates a playlist for each time slot you select</strong>
            <p>Every selected slot becomes a playlist built from that library's tracks and listening history. Playlist names are generated automatically — no naming to configure.</p>
        </div>
    </div>

    <div class="meloday-card">
        <div class="meloday-card-header">
            <div class="meloday-card-title">
                <span class="material-icons">schedule</span>
                <div>
                    <h2>Schedule</h2>
                    <p>Set the daily time slots for your Meloday playlists. These times apply to all selected libraries.</p>
                </div>
            </div>
            <button id="meloday-schedule-reset" class="action-btn" type="button">
                <span class="material-icons">restart_alt</span>
                <span>Reset to default</span>
            </button>
        </div>
        <div class="meloday-slot-grid" id="meloday-schedule-slots"></div>
    </div>

    <div class="meloday-card">
        <div class="meloday-card-header">
            <div class="meloday-card-title">
                <span class="material-icons">layers</span>
                <div>
                    <h2>Target Libraries</h2>
                    <p>Select which libraries to process and choose the time slots for each one. Maximum playlists per library is set on each card.</p>
                </div>
            </div>
            <div class="meloday-view-toggle" role="group" aria-label="Library view">
                <button type="button" data-meloday-view="grid" class="is-active">
                    <span class="material-icons">grid_view</span>
                    <span>Grid</span>
                </button>
                <button type="button" data-meloday-view="list">
                    <span class="material-icons">view_list</span>
                    <span>List</span>
                </button>
            </div>
        </div>
        <div id="meloday-library-schedules" class="meloday-library-grid"></div>
    </div>

    <div class="meloday-card">
        <div class="meloday-card-title">
            <span class="material-icons">dns</span>
            <div>
                <h2>Sync targets</h2>
                <p>Where Meloday playlists are published and listening history is imported from.</p>
            </div>
        </div>
        <div class="meloday-target-server-grid" id="meloday-target-servers" role="group" aria-label="Meloday target servers">
            <label class="meloday-target-option">
                <input type="checkbox" data-meloday-target-server="plex" />
                <span>Plex</span>
            </label>
            <label class="meloday-target-option">
                <input type="checkbox" data-meloday-target-server="jellyfin" />
                <span>Jellyfin</span>
            </label>
            <label class="meloday-target-option">
                <input type="checkbox" data-meloday-target-server="navidrome" />
                <span>Navidrome</span>
            </label>
        </div>
    </div>

    <div class="meloday-card">
        <button id="meloday-advanced-toggle" class="meloday-advanced-header" type="button" aria-expanded="false" aria-controls="meloday-advanced-panel">
            <span class="material-icons">tune</span>
            <span>Advanced settings</span>
            <span class="material-icons meloday-advanced-chevron">expand_more</span>
        </button>
        <div id="meloday-advanced-panel" hidden>
            <div class="meloday-advanced-grid">
                <div class="field-group">
                    <label class="field-label" for="meloday-max-tracks">Max tracks</label>
                    <input id="meloday-max-tracks" type="number" min="10" max="500" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="meloday-lookback-days">History lookback</label>
                    <input id="meloday-lookback-days" type="number" min="1" max="365" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="meloday-exclude-days">Exclude played</label>
                    <input id="meloday-exclude-days" type="number" min="0" max="365" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="meloday-similarity-distance">Similarity distance</label>
                    <input id="meloday-similarity-distance" type="number" min="0.05" max="1" step="0.01" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="meloday-similar-limit">Similar limit</label>
                    <input id="meloday-similar-limit" type="number" min="1" max="50" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="meloday-historical-ratio">Historical ratio</label>
                    <input id="meloday-historical-ratio" type="number" min="0" max="1" step="0.05" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="meloday-grace-minutes">Missed-run grace window (minutes)</label>
                    <input id="meloday-grace-minutes" type="number" min="0" max="720" />
                </div>
            </div>
        </div>
    </div>

    <div class="meloday-card">
        <div class="meloday-card-header">
            <div class="meloday-card-title">
                <span class="material-icons">image</span>
                <div>
                    <h2>Meloday artwork</h2>
                    <p>Covers stay unique across playlists until every image has been used, and each playlist keeps its cover across regenerations.</p>
                </div>
            </div>
            <div class="meloday-artwork-row">
                <span id="meloday-artwork-count" class="meloday-artwork-count">—</span>
                <input id="meloday-artwork-upload" type="file" accept=".jpg,.jpeg,.png,.webp" multiple hidden />
                <button id="meloday-artwork-add" class="action-btn" type="button">
                    <span class="material-icons">add_photo_alternate</span>
                    <span>Add Images</span>
                </button>
            </div>
        </div>
        <div id="meloday-artwork-grid" class="meloday-artwork-grid"></div>
        <div id="meloday-artwork-assignments" class="meloday-artwork-assignments"></div>
    </div>
</div>

@section Scripts {
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/meloday.js")"></script>
}
