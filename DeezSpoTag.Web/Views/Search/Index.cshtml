                    <div class="empty-results soulseek-waiting" id="soulseek-candidates-empty" role="status">
                        <h3>No Soulseek Results Yet</h3>
                        <p>Peers are scored, so the best copy is listed first.</p>
                    </div>
                    <div class="soulseek-count" id="soulseek-result-count"></div>
                </section>
            </div>

            <!-- A Soulseek result is a candidate, not a file: the app picks the quality and the peer when the
                 download runs. This panel describes the selected candidate and nothing more, because transfer
                 progress belongs to the Downloads tab. -->
            <aside class="soulseek-side">
                <section class="soulseek-panel">
                    <div class="soulseek-best-head">
                        <h3>Candidate</h3>
