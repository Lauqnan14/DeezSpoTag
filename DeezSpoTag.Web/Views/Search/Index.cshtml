        font-size: 22px;
        text-align: center;
    }

    .search-meta,
    .search-options {
        text-align: center;
        width: 100%;
    }
}

@@media (max-width: 520px) {
    .results-grid {
        grid-template-columns: repeat(auto-fill, minmax(min(120px, 42vw), 1fr));
    }
}

@@media (max-width: 640px) {
    .search-header {
        padding-bottom: 12px;
    }

    .search-filters {
        width: 100%;
    }

    .qobuz-store-select {
        min-width: 100%;
        max-width: 100%;
    }

    .filter-btn.action-btn {
        width: 100%;
        text-align: center;
    }
}

.source-btn.disabled {
    pointer-events: none;
    opacity: 0.5;
}

.soundtrack-url-panel {
    background: color-mix(in srgb, var(--bg-secondary) 86%, transparent);
    border: 1px solid var(--border-secondary);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.soundtrack-url-label {
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.02em;
}

.soundtrack-url-row {
    display: flex;
    gap: 10px;
    align-items: center;
}

.soundtrack-url-input {
    flex: 1;
    min-width: 180px;
}

.soundtrack-url-help {
    margin: 0;
    color: var(--text-muted);
    font-size: 12px;
}

/* ---- the page's own sticky shell, following the AutoTag page's ----
   A search is a long page: one source can return thousands of rows, and scrolling back up to change tab is
   the most annoying thing about it. The header and the source tabs are therefore pinned below the app
   topbar, exactly as the AutoTag page pins its own tabs, so every tab stays one click away and the results
   scroll underneath. The top offset is measured from the topbar at runtime, because CSS cannot know the
   topbar's height.

   The shell only works once the app's own scroll container stops being one. .main-content is
   overflow-y: auto, and a sticky element inside a scroll container sticks to that container rather than to
   the window - which is why pinning the tabs changed nothing until the page opted out of the inner scroller,
   the same way the AutoTag page does. */
.main-content.search-sticky-enabled {
    overflow-y: visible;
}

.main-content.search-sticky-enabled > .topbar {
    background: var(--bg-primary);
    border-bottom: none;
}

.search-sticky-shell {
    position: sticky;
    top: var(--search-sticky-top, 68px);
    z-index: 880;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-secondary);
    padding-top: 4px;
    margin-bottom: 12px;
}
.search-sticky-shell #searchSourceTabs { margin-bottom: 10px !important; background: var(--bg-primary); }
.search-sticky-shell .search-header { margin-bottom: 10px; }

@@media (max-width: 768px) {
    .search-sticky-shell { top: var(--search-sticky-top, 60px); }
}

@@media (max-width: 640px) {
    .soundtrack-url-row {
        flex-direction: column;
        align-items: stretch;
    }
}

</style>
