                        <select class="soulseek-destination" id="soulseek-destination"></select>
                        <p class="soulseek-hint soulseek-destination-hint" id="soulseek-destination-hint"></p>
                        <button type="button" class="action-btn action-btn--primary" id="soulseek-best-queue" disabled>Queue Download</button>
                        <p class="soulseek-hint">
                            A candidate, not a file &mdash; the ladder picks the quality and the peer.
                            Progress appears in the <a href="/Activities">Downloads</a> tab.
                        </p>
                    </div>
                </section>
            </aside>
        </div>
    </div>

</div>

</div>

@section Scripts {
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/soulseek.js")"></script>
<script>
let currentSearchTerm = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SearchTerm"]?.ToString() ?? string.Empty));
let soulseekSearchTerm = currentSearchTerm;
// The Soulseek panel prefills its artist/title fields from the term this page was rendered for.
window.__dsSearchTerm = soulseekSearchTerm;
let currentSearchType = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SearchType"]?.ToString() ?? "track"));
let currentSearchSource = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SearchSource"]?.ToString() ?? "spotify"));
let activeSearchRequestId = 0;
let appleVideoOffset = 0;
let appleHasMoreVideos = false;
let appleLoadingMore = false;
const selectedVideoKeys = new Set();
let showSelectedOnly = false;
const libraryExistenceCache = new Map();
const searchMode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SearchMode"]?.ToString() ?? string.Empty));
const searchModeNormalized = String(searchMode || '').trim().toLowerCase();
const soundtrackSearchMode = searchModeNormalized === 'soundtrack';
const soundtrackSearchTypes = new Set(['all', 'album', 'playlist', 'compilation']);
const searchSources = soundtrackSearchMode ? ['spotify', 'deezer', 'manual'] : ['spotify', 'deezer', 'apple', 'amazon', 'tidal'];
// Tracks whether the Soulseek pane is the one on screen. Soulseek is deliberately absent from
// searchSources: it is a peer-to-peer transfer panel, not a catalogue search source, so it must not be
// restored from the URL, persisted as a source preference, or fed into the streaming search cache.
let soulseekPanelOpen = false;
let sourceTypeSelections = {};
const soundtrackContextTypeRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SoundtrackContextType"]?.ToString() ?? string.Empty));
const soundtrackContextServerTypeRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SoundtrackContextServerType"]?.ToString() ?? string.Empty));
const soundtrackContextLibraryIdRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SoundtrackContextLibraryId"]?.ToString() ?? string.Empty));
const soundtrackContextItemIdRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SoundtrackContextItemId"]?.ToString() ?? string.Empty));
const soundtrackContextTitleRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SoundtrackContextTitle"]?.ToString() ?? string.Empty));
const soundtrackContextYearRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SoundtrackContextYear"]?.ToString() ?? string.Empty));
const soundtrackContextType = String(soundtrackContextTypeRaw || '').trim();
const soundtrackContextServerType = String(soundtrackContextServerTypeRaw || '').trim().toLowerCase();
const soundtrackContextLibraryId = String(soundtrackContextLibraryIdRaw || '').trim();
const soundtrackContextItemId = String(soundtrackContextItemIdRaw || '').trim();
const soundtrackContextTitle = String(soundtrackContextTitleRaw || '').trim();
const soundtrackContextYear = String(soundtrackContextYearRaw || '').trim();
const cachedSearchTerms = {};
currentSearchSource = String(currentSearchSource || 'spotify').trim().toLowerCase();
const SEARCH_STATE_TTL_MS = 10 * 60 * 1000;
const SEARCH_STATE_PREFIX = 'deezspotag:search-page:v3:';
const searchPrefetchKeys = new Set();
let searchWarmupScheduled = false;

const validSearchTypes = new Set(['track', 'album', 'artist', 'playlist', 'station', 'atmos', 'video', 'all', 'compilation']);
if (!validSearchTypes.has((currentSearchType || '').toLowerCase())) {
    currentSearchType = soundtrackSearchMode ? 'all' : 'track';
}

function getSearchStateKey() {
    const payload = {
        path: window.location.pathname,
        term: currentSearchTerm || '',
        mode: searchModeNormalized || '',
        soundtrackContextType,
        soundtrackContextServerType,
        soundtrackContextLibraryId,
        soundtrackContextItemId,
        soundtrackContextTitle,
        soundtrackContextYear
    };
    return `${SEARCH_STATE_PREFIX}${encodeURIComponent(JSON.stringify(payload))}`;
}

function serializeMap(map) {
    return map instanceof Map ? Array.from(map.entries()) : [];
}

function restoreMap(map, entries) {
    if (!(map instanceof Map)) {
        return;
    }
    map.clear();
    if (!Array.isArray(entries)) {
        return;
    }
    entries.forEach(entry => {
        if (!Array.isArray(entry) || entry.length < 2) {
            return;
        }
        map.set(entry[0], entry[1]);
    });
}

function saveSearchPageState() {
    if (!currentSearchTerm) {
        return;
    }

    try {
        const state = {
            savedAt: Date.now(),
            activeSource: currentSearchSource,
            activeType: currentSearchType,
            sourceTypeSelections,
            cachedResults,
            cachedSearchTerms: { ...cachedSearchTerms },
            libraryExistenceEntries: serializeMap(libraryExistenceCache),
            selectedVideoKeys: Array.from(selectedVideoKeys),
            showSelectedOnly,
            appleVideoOffset,
            appleHasMoreVideos,
            scrollY: window.scrollY || 0
        };
        sessionStorage.setItem(getSearchStateKey(), JSON.stringify(state));
    } catch (error) {
        console.warn('Failed to save search page state.', error);
    }
}

function restoreSearchPageState() {
    if (!currentSearchTerm) {
        return { restored: false, expired: false };
    }

    try {
        const raw = sessionStorage.getItem(getSearchStateKey());
        if (!raw) {
            return { restored: false, expired: false };
        }

        const state = JSON.parse(raw);
        if (!state || typeof state !== 'object') {
            return { restored: false, expired: false };
        }

        const activeSource = String(state.activeSource || '').trim().toLowerCase();
        if (searchSources.includes(activeSource)) {
            currentSearchSource = activeSource;
        }

        sourceTypeSelections = state.sourceTypeSelections && typeof state.sourceTypeSelections === 'object'
            ? state.sourceTypeSelections
            : {};

        const activeType = String(state.activeType || sourceTypeSelections[currentSearchSource] || currentSearchType || '').trim().toLowerCase();
        currentSearchType = normalizeTypeForSource(currentSearchSource, activeType);
        sourceTypeSelections[currentSearchSource] = currentSearchType;

        cachedResults = state.cachedResults && typeof state.cachedResults === 'object' ? state.cachedResults : null;
        Object.keys(cachedSearchTerms).forEach(key => delete cachedSearchTerms[key]);
        if (state.cachedSearchTerms && typeof state.cachedSearchTerms === 'object') {
            Object.assign(cachedSearchTerms, state.cachedSearchTerms);
        }
        restoreMap(libraryExistenceCache, state.libraryExistenceEntries);
        if (cachedResults) {
            Object.values(cachedResults).forEach(applyCachedLibraryStateToSourceResults);
        }

        selectedVideoKeys.clear();
        if (Array.isArray(state.selectedVideoKeys)) {
            state.selectedVideoKeys.forEach(key => {
                if (key) {
                    selectedVideoKeys.add(key);
                }
            });
        }
        showSelectedOnly = state.showSelectedOnly === true;
        appleVideoOffset = Number(state.appleVideoOffset || 0);
        appleHasMoreVideos = state.appleHasMoreVideos === true;
        appleLoadingMore = false;

        updateActiveSource(currentSearchSource);

        const scrollY = Number(state.scrollY || 0);
        if (Number.isFinite(scrollY) && scrollY > 0) {
            requestAnimationFrame(() => window.scrollTo({ top: scrollY, behavior: 'auto' }));
        }

        const savedAt = Number(state.savedAt || 0);
        return {
            restored: true,
            expired: !savedAt || (Date.now() - savedAt) > SEARCH_STATE_TTL_MS
        };
    } catch (error) {
        console.warn('Failed to restore search page state.', error);
        return { restored: false, expired: false };
    }
}

// Storage for the remembered source tab is owned by tab-preferences.js. Only the
// source <-> tab-target mapping below is local, because that is search-specific.
function isRememberLastTabEnabled() {
    return window.TabPreferences?.isEnabled?.() !== false;
}

function getSearchSourcePreferenceKey() {
    return window.TabPreferences?.keyFor?.('searchSourceTabs') || '';
}

function mapSearchSourceToTarget(source) {
    const normalized = String(source || '').trim().toLowerCase();
    if (!searchSources.includes(normalized)) {
        return '';
    }

    return `#search-source-${normalized}`;
}

function mapSearchTargetToSource(target) {
    const normalized = String(target || '').trim().toLowerCase();
    const prefix = '#search-source-';
    if (!normalized.startsWith(prefix)) {
        return '';
    }

    const source = normalized.substring(prefix.length);
    return searchSources.includes(source) ? source : '';
}

function readRememberedSearchSource() {
    const raw = window.TabPreferences?.read?.(getSearchSourcePreferenceKey()) || '';
    return mapSearchTargetToSource(raw);
}

function persistRememberedSearchSource(source) {
    const target = mapSearchSourceToTarget(source);
    if (!target) {
        return;
    }

    window.TabPreferences?.write?.(getSearchSourcePreferenceKey(), target);
}

function getActiveSearchSourceFromTabUi() {
    const activeTab = document.querySelector('#searchSourceTabs .source-btn.active[data-source]');
    const activeSource = String(activeTab?.dataset?.source || '').trim().toLowerCase();
    return searchSources.includes(activeSource) ? activeSource : '';
}

function isValidURL(value) {
    try {
        const parsed = new URL(value);
        return parsed.protocol === 'http:' || parsed.protocol === 'https:';
    } catch (_) {
        return false;
    }
}

function extractAppleIdFromUrl(url) {
    if (!url) return '';
    try {
        const parsed = new URL(url);
        const parts = parsed.pathname.split('/').filter(Boolean);
        for (let i = parts.length - 1; i >= 0; i--) {
            const seg = parts[i];
            if (/^\d+$/.test(seg)) return seg;
        }
        const iParam = parsed.searchParams.get('i');
        if (iParam && /^\d+$/.test(iParam)) return iParam;
    } catch {
    }
    return '';
}

function parseAppleLink(url) {
    const idVal = extractAppleIdFromUrl(url);
    if (!idVal) return null;
    try {
        const parsed = new URL(url);
        const parts = parsed.pathname.split('/').filter(Boolean).map(p => p.toLowerCase());
        let type = 'track';
        if (parts.includes('playlist')) {
            type = 'playlist';
        } else if (parts.includes('album')) {
            type = parsed.searchParams.get('i') ? 'track' : 'album';
        } else if (parts.includes('artist')) {
            type = 'artist';
        } else if (parts.includes('music-video')) {
            type = 'track';
        }
        return { id: idVal, type, url };
    } catch {
        return null;
    }
}

async function parseDeezerLinkDirectly(input) {
    const response = await fetch(`/api/deezer/parse-link?url=${encodeURIComponent(input)}`);
    if (!response.ok) {
        throw new Error(`Deezer link parse failed (HTTP ${response.status}).`);
    }

    const data = await response.json();
    if (data?.error) {
        throw new Error(data.error);
    }
    return data;
}

// Sources whose playlist URL opens the shared tracklist when the link mapper cannot resolve the URL
// to a Deezer entity. SoundCloud belongs here: classifyExternalSource recognises it and
// isPlaylistLikeExternalLink accepts its /sets/ and /discover/sets/ shapes, so without this entry a pasted
// SoundCloud playlist URL failed the gate below and threw instead of opening the tracklist.
const deezerMappedPlaylistSources = new Set(['tidal', 'qobuz', 'bandcamp', 'soundcloud']);

function classifyExternalSource(url) {
    if (!url) return '';
    try {
        const parsed = new URL(url);
        const host = (parsed.hostname || '').toLowerCase();
        if (host.includes('soundcloud.com')) return 'soundcloud';
        if (host.includes('tidal.com')) return 'tidal';
        if (host.includes('qobuz.com')) return 'qobuz';
        if (host.includes('bandcamp.com')) return 'bandcamp';
        if (host.includes('pandora.com')) return 'pandora';
        if (host.includes('boomplay.com')) return 'boomplay';
        if (host.includes('deezer.com') || host.includes('deezer.page.link')) return 'deezer';
    } catch {
    }
    return '';
}

function shouldUseLinkMap(parsedUrl) {
    if (!parsedUrl) return false;
    const host = (parsedUrl.hostname || '').toLowerCase();
    return host.includes('deezer.com')
        || host.includes('deezer.page.link')
        || host.includes('soundcloud.com')
        || host.includes('tidal.com')
        || host.includes('qobuz.com')
        || host.includes('bandcamp.com')
        || host.includes('pandora.com');
}

function isPlaylistLikeExternalLink(parsedUrl, source) {
    if (!parsedUrl) return false;
    const path = (parsedUrl.pathname || '').toLowerCase();
    const query = parsedUrl.searchParams;

    if (query.has('list') || path.includes('/playlist')) {
        return true;
    }

    if (source === 'soundcloud') {
        return path.includes('/sets/');
    }

    if (source === 'tidal') {
        return path.includes('/mix/');
    }

    if (source === 'qobuz') {
        return path.includes('/playlist/') || path.includes('/playlists/');
    }

    if (source === 'bandcamp') {
        return path.includes('/album/');
    }

    return false;
}

function redirectToDeezerEntity(type, id) {
    const normalizedType = String(type || '').trim().toLowerCase();
    const normalizedId = String(id || '').trim();
    if (!normalizedType || !normalizedId) {
        return false;
    }

    if (normalizedType === 'artist') {
        window.location.href = `/Artist?id=${encodeURIComponent(normalizedId)}&source=deezer`;
        return true;
    }

    navigateToTracklist(normalizedId, normalizedType, 'deezer');
    return true;
}

function redirectToExternalPlaylistFlow(source, url) {
    const normalizedSource = String(source || '').trim().toLowerCase();
    const normalizedUrl = String(url || '').trim();
    if (!normalizedSource || !normalizedUrl) {
        return false;
    }

    if (normalizedSource === 'tidal') {
        const tidalRoute = parseTidalTracklistRoute(normalizedUrl);
        if (!tidalRoute.id) {
            return false;
        }
        navigateToTracklist(tidalRoute.id, tidalRoute.type || 'playlist', 'tidal');
        return true;
    }

    navigateToTracklist(normalizedUrl, 'playlist', normalizedSource, { externalUrl: normalizedUrl });
    return true;
}

function parseTidalTracklistRoute(url) {
    try {
        const parsed = new URL(url);
        const segments = parsed.pathname.split('/').filter(Boolean);
        const supportedTypes = new Set(['track', 'album', 'playlist', 'mix', 'artist']);
        for (let i = 0; i < segments.length - 1; i += 1) {
            const segment = segments[i].toLowerCase();
            if (supportedTypes.has(segment)) {
                return {
                    type: segment,
                    id: segments[i + 1] || ''
                };
            }
        }
    } catch {
    }
    return { type: '', id: '' };
}

function hasSoundtrackContext() {
    return soundtrackSearchMode
        && Boolean(soundtrackContextServerType)
        && Boolean(soundtrackContextLibraryId)
        && Boolean(soundtrackContextItemId)
        && Boolean(soundtrackContextTitle);
}

function appendSoundtrackContextToParams(params) {
    if (!hasSoundtrackContext()) {
        return;
    }

    if (soundtrackContextType) params.set('matchContextType', soundtrackContextType);
    if (soundtrackContextServerType) params.set('matchContextServerType', soundtrackContextServerType);
    if (soundtrackContextLibraryId) params.set('matchContextLibraryId', soundtrackContextLibraryId);
    if (soundtrackContextItemId) params.set('matchContextItemId', soundtrackContextItemId);
    if (soundtrackContextTitle) params.set('matchContextTitle', soundtrackContextTitle);
    if (soundtrackContextYear) params.set('matchContextYear', soundtrackContextYear);
}

function navigateToTracklist(id, type, source, options = {}) {
    saveSearchPageState();
    const query = new URLSearchParams();
    query.set('id', String(id || ''));
    query.set('type', String(type || 'track'));
    query.set('source', String(source || 'deezer'));
    const externalUrl = String(options.externalUrl || '').trim();
    if (externalUrl) {
        query.set('externalUrl', externalUrl);
    }
    const appleUrl = String(options.appleUrl || '').trim();
    if (appleUrl) {
        query.set('appleUrl', appleUrl);
    }
    const amazonTrack = options.amazonTrack && typeof options.amazonTrack === 'object' ? options.amazonTrack : null;
    if (amazonTrack) {
        for (const [key, value] of Object.entries(amazonTrack)) {
            const normalizedValue = String(value ?? '').trim();
            if (normalizedValue) {
                query.set(key, normalizedValue);
            }
        }
    }
    appendSoundtrackContextToParams(query);
    window.location.href = `/Tracklist?${query.toString()}`;
}

function showSearchUrlError(message) {
    const container = getResultsContainer();
    if (!container) {
        return;
    }

    container.innerHTML = `
        <div class="error-section">
            <h3>Unable to open link</h3>
            <p>${escapeHtml(message)}</p>
        </div>
    `;
    document.getElementById('search-count').textContent = '';
}

async function routeSearchUrlDirectly(input) {
    const normalizedInput = String(input || '').trim();
    if (!isValidURL(normalizedInput)) {
        return false;
    }

    const parsedUrl = new URL(normalizedInput);
    if (classifyExternalSource(normalizedInput) === 'boomplay') {
        const response = await fetch(`/api/boomplay/parse-link?url=${encodeURIComponent(normalizedInput)}`);
        if (!response.ok) {
            throw new Error(`Boomplay link parse failed (HTTP ${response.status}).`);
        }

        const parsed = await response.json();
        const itemId = String(parsed?.id || '').trim();
        const itemType = String(parsed?.type || '').trim().toLowerCase();
        if (!itemId || !itemType || parsed?.error) {
            throw new Error(parsed?.message || parsed?.error || 'Boomplay link did not resolve to a supported item.');
        }

        navigateToTracklist(itemId, itemType, 'boomplay', { externalUrl: parsed?.canonicalUrl || normalizedInput });
        return true;
    }

    if (isSpotifyHostname(parsedUrl.hostname)) {
        const response = await fetch(`/api/spotify/metadata?url=${encodeURIComponent(normalizedInput)}`);
        if (!response.ok) {
            throw new Error(`Spotify link parse failed (HTTP ${response.status}).`);
        }

        const data = await response.json();
        const metadata = data?.metadata;
        if (!metadata?.id) {
            throw new Error('Spotify link did not resolve to a supported item.');
        }

        if (metadata.type === 'artist') {
            window.location.href = `/Artist?id=${encodeURIComponent(metadata.id)}&source=spotify`;
            return true;
        }

        navigateToTracklist(metadata.id, metadata.type || 'track', 'spotify', { externalUrl: normalizedInput });
        return true;
    }

    if (parsedUrl.hostname.includes('music.apple.com') || parsedUrl.hostname.includes('itunes.apple.com')) {
        const appleLink = parseAppleLink(normalizedInput);
        if (!appleLink) {
            throw new Error('Apple Music link did not resolve to a supported item.');
        }

        if (appleLink.type === 'artist') {
            window.location.href = `/Artist?id=${encodeURIComponent(appleLink.id)}&source=apple`;
            return true;
        }

        navigateToTracklist(appleLink.id, appleLink.type, 'apple', { externalUrl: appleLink.url, appleUrl: appleLink.url });
        return true;
    }

    if (!shouldUseLinkMap(parsedUrl)) {
        throw new Error('Unsupported music link.');
    }

    const response = await fetch(`/api/link-map/deezer?url=${encodeURIComponent(normalizedInput)}`);
    if (!response.ok) {
        throw new Error(`Link parser failed (HTTP ${response.status}).`);
    }

    const mapping = await response.json();
    if (mapping?.available && mapping?.deezerType && mapping?.deezerId) {
        if (!redirectToDeezerEntity(mapping.deezerType, mapping.deezerId)) {
            throw new Error('Mapped Deezer link did not contain a supported item.');
        }
        return true;
    }

    const inferredSource = String(mapping?.source || classifyExternalSource(normalizedInput)).toLowerCase();
    if (deezerMappedPlaylistSources.has(inferredSource)
        && isPlaylistLikeExternalLink(parsedUrl, inferredSource)
        && redirectToExternalPlaylistFlow(inferredSource, normalizedInput)) {
        return true;
    }

    throw new Error(mapping?.error || 'Link could not be resolved.');
}

function getSoundtrackManualElements() {
    return {
        input: document.getElementById('soundtrack-url-input'),
        openButton: document.getElementById('soundtrack-url-open'),
        error: document.getElementById('soundtrack-url-error')
    };
}

function showSoundtrackUrlError(message) {
    const { error } = getSoundtrackManualElements();
    if (!error) return;
    error.hidden = false;
    error.innerHTML = `
        <h3>Unable to open link</h3>
        <p>${escapeHtml(message)}</p>
    `;
}

function clearSoundtrackUrlError() {
    const { error } = getSoundtrackManualElements();
    if (!error) return;
    error.hidden = true;
    error.textContent = '';
}

function isExactOrSubdomainHost(host, expectedHost) {
    const normalizedHost = String(host || '').toLowerCase();
    return normalizedHost === expectedHost || normalizedHost.endsWith(`.${expectedHost}`);
}

function isSpotifyHostname(host) {
    return isExactOrSubdomainHost(host, 'spotify.com');
}

async function openSoundtrackManualUrl(rawUrl) {
    const inputUrl = String(rawUrl || '').trim();
    if (!inputUrl) {
        showSoundtrackUrlError('Paste a Spotify or Deezer album/playlist/track URL.');
        return;
    }

    if (!isValidURL(inputUrl)) {
        showSoundtrackUrlError('The URL is invalid. Use a full http(s) link.');
        return;
    }

    clearSoundtrackUrlError();

    let host = '';
    try {
        host = new URL(inputUrl).hostname.toLowerCase();
    } catch {
        showSoundtrackUrlError('The URL is invalid. Use a full http(s) link.');
        return;
    }

    try {
        if (isSpotifyHostname(host)) {
            const response = await fetch(`/api/spotify/metadata?url=${encodeURIComponent(inputUrl)}`);
            if (!response.ok) {
                throw new Error(`Spotify link parse failed (HTTP ${response.status}).`);
            }

            const payload = await response.json();
            const metadata = payload?.metadata;
            const itemId = String(metadata?.id || '').trim();
            const itemType = String(metadata?.type || '').trim().toLowerCase();
            if (!itemId || !itemType) {
                throw new Error('Could not parse Spotify URL.');
            }

            if (itemType === 'artist') {
                throw new Error('Artist links are not supported for soundtrack matching. Use album, playlist, or track.');
            }

            navigateToTracklist(itemId, itemType, 'spotify', { externalUrl: inputUrl });
            return;
        }

        if (host.includes('deezer.com') || host.includes('deezer.page.link')) {
            const parsed = await parseDeezerLinkDirectly(inputUrl);
            const itemId = String(parsed?.id || '').trim();
            const itemType = String(parsed?.type || '').trim().toLowerCase();
            if (!itemId || !itemType) {
                throw new Error('Could not parse Deezer URL.');
            }

            if (itemType === 'artist') {
                throw new Error('Artist links are not supported for soundtrack matching. Use album, playlist, or track.');
            }

            navigateToTracklist(itemId, itemType, 'deezer', { externalUrl: inputUrl });
            return;
        }

        showSoundtrackUrlError('Only Spotify and Deezer links are supported in this tab.');
    } catch (error) {
        console.error('Soundtrack URL open failed:', error);
        showSoundtrackUrlError(error?.message || 'Could not open that URL.');
    }
}

function initializeSoundtrackManualTab() {
    if (!soundtrackSearchMode) {
        return;
    }

    const { input, openButton } = getSoundtrackManualElements();
    if (!input || !openButton || input.dataset.bound === 'true') {
        return;
    }

    input.dataset.bound = 'true';
    openButton.addEventListener('click', () => {
        void openSoundtrackManualUrl(input.value);
    });
    input.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') {
            return;
        }
        event.preventDefault();
        void openSoundtrackManualUrl(input.value);
    });
    input.addEventListener('input', () => {
        clearSoundtrackUrlError();
    });

    if (isValidURL(currentSearchTerm)) {
        input.value = currentSearchTerm;
    }
}

/**
 * Pins the page header and the source tabs below the app topbar.
 *
 * <p>
 *     The topbar's height is not knowable from CSS - it changes with the theme, the viewport and whether the
 *     sidebar is collapsed - so it is measured and written into a custom property, exactly as the AutoTag page
 *     does it. Sticking to a guessed number is what puts a tab strip underneath the topbar on one screen size
 *     and leaves a gap on the next.
 * </p>
 */
function initializeSearchStickyShell() {
    const page = document.querySelector('.search-sticky-shell');
    if (!page) {
        return;
    }

    // The app's main region is its own scroller, and a sticky element inside a scroller sticks to that
    // scroller rather than to the window - the tabs simply scroll away with it. Handing the scroll back to
    // the window is what makes the shell stick, and the topbar is restyled to match, as on the AutoTag page.
    const mainContent = document.getElementById('mainContent');
    if (mainContent instanceof HTMLElement) {
        mainContent.classList.add('search-sticky-enabled');
    }

    const update = () => {
        const topbar = document.querySelector('.main-content > .topbar');
        const offset = topbar instanceof HTMLElement ? Math.max(0, Math.ceil(topbar.offsetHeight)) : 0;
        page.style.setProperty('--search-sticky-top', `${offset}px`);
        // The Soulseek side panel is sticky too, and it has to start below this shell or it slides under the
        // tabs while the reader scrolls the results.
        const shellHeight = page instanceof HTMLElement ? Math.ceil(page.offsetHeight) : 0;
        page.style.setProperty('--search-shell-height', `${shellHeight}px`);
    };

    update();
    window.requestAnimationFrame(update);
    window.setTimeout(update, 0);
    window.addEventListener('load', update);
    window.addEventListener('resize', update, { passive: true });
    window.addEventListener('orientationchange', update, { passive: true });

    const topbar = document.querySelector('.main-content > .topbar');
    if (topbar instanceof HTMLElement && typeof ResizeObserver !== 'undefined') {
        const observer = new ResizeObserver(() => window.requestAnimationFrame(update));
        observer.observe(topbar);
        observer.observe(page);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    setupInfiniteScroll();
    initializeSearchStickyShell();
    const urlParams = new URLSearchParams(window.location.search);
    const sourceParam = (urlParams.get('source') || '').toLowerCase();
    // Soulseek is not a catalogue source, so it never becomes currentSearchSource: that value drives the
    // streaming search path and displayResults(), which would wipe the Soulseek panel's markup. It can still
    // be the tab a link asks for, though, and it has to be - a shared link to a Soulseek search used to land
    // on Spotify with the Soulseek tab sitting there unopened. So the URL may name it here, where the tab is
    // opened directly, and nowhere else: it is restored as a view, never as a streaming source.
    const wantsSoulseek = sourceParam === 'soulseek';
    if (!wantsSoulseek && searchSources.includes(sourceParam)) {
        currentSearchSource = sourceParam;
    } else if (!wantsSoulseek && isRememberLastTabEnabled()) {
        const rememberedSource = readRememberedSearchSource();
        if (rememberedSource) {
            currentSearchSource = rememberedSource;
        } else {
            const activeSourceFromUi = getActiveSearchSourceFromTabUi();
            if (activeSourceFromUi) {
                currentSearchSource = activeSourceFromUi;
            }
        }
    }
    if (!searchSources.includes((currentSearchSource || '').toLowerCase())) {
        currentSearchSource = 'spotify';
    }
    initializeSoundtrackManualTab();
    currentSearchType = normalizeTypeForSource(currentSearchSource, currentSearchType);
    sourceTypeSelections[currentSearchSource] = currentSearchType;
    const restoredState = restoreSearchPageState();
    if (!restoredState.restored && !wantsSoulseek) {
        updateActiveSource(currentSearchSource);
    }
    
    // Perform initial search
    if (wantsSoulseek) {
        // The tab brings its own search: it queries the peer network and renders its own results, so no
        // catalogue source is warmed and performSearch is not involved at all.
        soulseekPanelOpen = true;
        setActiveSourceTab('soulseek');
        window.Soulseek?.searchCurrentTerm?.();
    } else if (currentSearchTerm && currentSearchSource !== 'manual' && !restoredState.restored) {
        if (isValidURL(currentSearchTerm)) {
            routeSearchUrlDirectly(currentSearchTerm)
                .catch(error => {
                    console.error('Search URL routing failed:', error);
                    showSearchUrlError(error?.message || 'Link could not be resolved.');
                });
        } else {
            performSearch(currentSearchTerm, currentSearchType, { preferTyped: shouldUseTypedSearch(currentSearchSource, currentSearchType) });
        }
    } else if (currentSearchTerm && currentSearchSource !== 'manual' && restoredState.expired) {
        performSearch(currentSearchTerm, currentSearchType, {
            showLoading: false,
            preferTyped: shouldUseTypedSearch(currentSearchSource, currentSearchType)
        });
    } else if (currentSearchTerm && currentSearchSource !== 'manual' && restoredState.restored) {
        scheduleSearchWarmup(currentSearchSource, currentSearchTerm);
    }
    
    // Filter click handlers
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (this.classList.contains('disabled')) {
                return;
            }
            const source = String(this.dataset.source || currentSearchSource || '').trim().toLowerCase();
            if (searchSources.includes(source)) {
                currentSearchSource = source;
            }
            const type = normalizeTypeForSource(currentSearchSource, this.dataset.type);
            currentSearchType = type;
            sourceTypeSelections[currentSearchSource] = type;
            updateActiveFilter(type);
            if (shouldRefetchSourceResults(currentSearchSource, currentSearchTerm, type)) {
                performSearch(currentSearchTerm, type, { preferTyped: shouldUseTypedSearch(currentSearchSource, type) });
            } else {
                saveSearchPageState();
            }
            
            // Update URL
            const url = new URL(window.location);
            url.searchParams.set('source', currentSearchSource);
            url.searchParams.set('type', type);
            window.history.pushState({}, '', url);
        });
    });

    document.querySelectorAll('.source-btn').forEach(btn => {
        const warmSource = () => {
            const source = String(btn.dataset.source || '').trim().toLowerCase();
            // Soulseek is not a catalogue search API. It has its own endpoint, its own results model and its
            // own scoring, so warming it through the streaming search path would only produce a dead request.
            if (source && source !== 'manual' && source !== 'soulseek') {
                void prefetchSearchResults(source, currentSearchTerm, getSelectedSearchTypeForSource(source));
            }
        };
        btn.addEventListener('mouseenter', warmSource);
        btn.addEventListener('focus', warmSource);
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (this.classList.contains('disabled')) {
                return;
            }
            const source = this.dataset.source;
            if (source === 'soulseek') {
                // Soulseek is not a catalogue source: it has no result cache, no type filters and its own
                // results model. It therefore never becomes currentSearchSource, because that value drives the
                // streaming search path and displayResults(), which would wipe the Soulseek panel's markup.
                // The tab is shown directly and the panel is handed control of rendering.
                soulseekPanelOpen = true;
                setActiveSourceTab('soulseek');
                // The URL is the view, not the search machinery, so it is updated to name the tab the reader
                // is actually looking at. Without this, reloading the page dropped the reader back on
                // Spotify and left the Soulseek results they were reading behind. The remembered-tab setting
                // is deliberately not touched: remembering Soulseek would start a streaming search on it.
                const soulseekUrl = new URL(window.location);
                soulseekUrl.searchParams.set('source', 'soulseek');
                soulseekUrl.searchParams.set('type', currentSearchType);
                window.history.pushState({}, '', soulseekUrl);
                window.Soulseek?.searchCurrentTerm?.();
                return;
            }
            soulseekPanelOpen = false;
            currentSearchSource = source;
            updateActiveSource(currentSearchSource);
            persistRememberedSearchSource(currentSearchSource);
            if (shouldRefetchSourceResults(currentSearchSource, currentSearchTerm, currentSearchType)) {
                performSearch(currentSearchTerm, currentSearchType, { preferTyped: shouldUseTypedSearch(currentSearchSource, currentSearchType) });
            } else {
                saveSearchPageState();
            }
            const url = new URL(window.location);
            url.searchParams.set('source', currentSearchSource);
            url.searchParams.set('type', currentSearchType);
            window.history.pushState({}, '', url);
        });
    });

    const offlineToggle = document.getElementById('offline-search');
    if (offlineToggle) {
        offlineToggle.addEventListener('change', () => {
            performSearch(currentSearchTerm, currentSearchType, {
                preferTyped: shouldUseTypedSearch(currentSearchSource, currentSearchType)
            });
        });
    }

});

function updateActiveFilter(type) {
    if (currentSearchSource === 'manual') {
        enforceAppleOnlySource(type);
        return;
    }

    const scope = document.getElementById(`search-source-${currentSearchSource}`) || document;
    scope.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
    });
    scope.querySelectorAll(`[data-type="${type}"]`).forEach(target => {
        target.classList.add('active');
        target.setAttribute('aria-selected', 'true');
    });
    enforceAppleOnlySource(type);
    if (cachedResults) {
        const items = getResultsForType(type, currentSearchSource);
        document.getElementById('search-count').textContent =
            items.length > 0 ? ` - ${items.length} results` : ' - No results';
        displayResults(items, type);
        ensureLibraryStatusForCurrentView();
        if (type !== 'video') {
            selectedVideoKeys.clear();
        }
    }
}

let cachedResults = null;

function createEmptySourceResults(source) {
    if (source === 'apple' || source === 'tidal') {
        return {
            tracks: [],
            albums: [],
            artists: [],
            playlists: [],
            stations: [],
            videos: [],
            hasMoreVideos: false,
            error: ''
        };
    }

    return {
        tracks: [],
        albums: [],
        artists: [],
        playlists: [],
        stations: [],
        error: ''
    };
}

function ensureCachedResults() {
    if (!cachedResults) {
        cachedResults = {};
    }

    for (const source of searchSources) {
        if (!cachedResults[source]) {
            cachedResults[source] = createEmptySourceResults(source);
        }
    }

    return cachedResults;
}

function hasAnySourceItems(sourceData, source) {
    if (!sourceData || typeof sourceData !== 'object') {
        return false;
    }

    const count = (items) => Array.isArray(items) ? items.length : 0;
    if (count(sourceData.tracks) > 0) return true;
    if (count(sourceData.albums) > 0) return true;
    if (count(sourceData.artists) > 0) return true;
    if (count(sourceData.playlists) > 0) return true;

    const normalizedSource = String(source || '').trim().toLowerCase();
    if ((normalizedSource === 'apple' || normalizedSource === 'tidal') && count(sourceData.videos) > 0) {
        return true;
    }

    return false;
}

function shouldRefetchSourceResults(source, term, type) {
    if (!term || source === 'manual') {
        return false;
    }

    const sourceData = cachedResults?.[source];
    if (!sourceData) {
        return true;
    }

    if (cachedSearchTerms[source] !== term) {
        return true;
    }

    if (Boolean(sourceData.error)) {
        return true;
    }

    const normalizedType = normalizeTypeForSource(source, type);
    if (!isSourceTypeLoaded(sourceData, source, normalizedType)) {
        return true;
    }

    return false;
}

function markSourceTypesLoaded(sourceData, source, types) {
    if (!sourceData || typeof sourceData !== 'object') {
        return sourceData;
    }

    const existing = Array.isArray(sourceData.__loadedTypes) ? sourceData.__loadedTypes : [];
    const loaded = new Set(existing.map(value => String(value || '').toLowerCase()));
    (Array.isArray(types) ? types : []).forEach(type => {
        const normalized = normalizeTypeForSource(source, type);
        if (normalized) {
            loaded.add(normalized);
        }
    });
    sourceData.__loadedTypes = Array.from(loaded);
    return sourceData;
}

function markBroadSourceResultsLoaded(sourceData, source) {
    const normalizedSource = String(source || '').trim().toLowerCase();
    const types = normalizedSource === 'apple'
        ? ['track', 'album', 'artist', 'playlist', 'station', 'atmos', 'video']
        : normalizedSource === 'tidal'
            ? ['track', 'album', 'artist', 'playlist', 'atmos', 'video']
        : normalizedSource === 'amazon'
            ? ['track', 'album', 'artist', 'playlist']
        : soundtrackSearchMode
            ? ['all', 'album', 'playlist', 'compilation']
            : ['track', 'album', 'artist', 'playlist'];
    return markSourceTypesLoaded(sourceData, source, types);
}

function isSourceTypeLoaded(sourceData, source, type) {
    const normalizedType = String(type || '').trim().toLowerCase();
    if (!normalizedType) {
        return false;
    }

    if (Array.isArray(sourceData?.__loadedTypes)) {
        return sourceData.__loadedTypes
            .map(value => String(value || '').toLowerCase())
            .includes(normalizedType);
    }

    return hasAnySourceItems(sourceData, source);
}

function shouldUseTypedSearch(source, type) {
    const normalizedSource = String(source || '').trim().toLowerCase();
    const normalizedType = normalizeTypeForSource(normalizedSource, type);
    if (!normalizedSource || !normalizedType) {
        return false;
    }

    if (soundtrackSearchMode && (normalizedType === 'all' || normalizedType === 'compilation')) {
        return false;
    }

    if (normalizedSource === 'spotify') {
        return ['track', 'album', 'artist', 'playlist'].includes(normalizedType);
    }

    if (normalizedSource === 'apple') {
        return ['track', 'album', 'artist', 'playlist', 'station', 'atmos', 'video'].includes(normalizedType);
    }

    if (normalizedSource === 'tidal') {
        return ['track', 'album', 'artist', 'playlist', 'atmos', 'video'].includes(normalizedType);
    }

    if (normalizedSource === 'amazon') {
        return ['track', 'album', 'artist', 'playlist'].includes(normalizedType);
    }

    return false;
}

function getSearchFetchKey(source, term, type) {
    return [
        String(source || '').trim().toLowerCase(),
        String(term || '').trim().toLowerCase(),
        normalizeTypeForSource(source, type)
    ].join('|');
}

function getVisibleSearchTypesForSource(source) {
    const normalizedSource = String(source || '').trim().toLowerCase();
    if (!searchSources.includes(normalizedSource) || normalizedSource === 'manual') {
        return [];
    }

    const scope = document.getElementById(`search-source-${normalizedSource}`);
    if (!scope) {
        return [normalizeTypeForSource(normalizedSource, sourceTypeSelections[normalizedSource] || currentSearchType)];
    }

    return Array.from(scope.querySelectorAll('.filter-btn[data-type]'))
        .map(button => normalizeTypeForSource(normalizedSource, button.dataset.type))
        .filter(Boolean)
        .filter((type, index, values) => values.indexOf(type) === index);
}

function getSelectedSearchTypeForSource(source) {
    const normalizedSource = String(source || '').trim().toLowerCase();
    return normalizeTypeForSource(normalizedSource, sourceTypeSelections[normalizedSource] || currentSearchType || 'track');
}

function scheduleSearchWarmup(source, term) {
    if (searchWarmupScheduled || !term || isValidURL(term)) {
        return;
    }

    searchWarmupScheduled = true;
    const run = () => {
        void warmSearchTabs(source, term)
            .finally(() => {
                searchWarmupScheduled = false;
            });
    };

    if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(run, { timeout: 1500 });
        return;
    }

    window.setTimeout(run, 250);
}

async function warmSearchTabs(activeSource, term) {
    // Soulseek is not a catalogue source, so it cannot ride the prefetch loop below: it runs its own peer
    // query against its own endpoint. It is kicked off first and never awaited, so the tab already holds an
    // answer whenever the user opens it, instead of only starting once they have navigated to it.
    void window.Soulseek?.searchInBackground?.(term);

    const normalizedActiveSource = String(activeSource || '').trim().toLowerCase();
    const sourceOrder = [
        normalizedActiveSource,
        ...searchSources.filter(source => source !== normalizedActiveSource && source !== 'manual')
    ].filter(Boolean);

    for (const source of sourceOrder) {
        if (source === 'manual') {
            continue;
        }

        const selectedType = getSelectedSearchTypeForSource(source);
        await prefetchSearchResults(source, term, selectedType);
        if (source === normalizedActiveSource) {
            const siblingTypes = getVisibleSearchTypesForSource(source)
                .filter(type => type !== selectedType);
            for (const type of siblingTypes) {
                await prefetchSearchResults(source, term, type);
            }
        }
    }
}

async function prefetchSearchResults(source, term, type) {
    const normalizedSource = String(source || '').trim().toLowerCase();
    const normalizedType = normalizeTypeForSource(normalizedSource, type);
    if (!term || !searchSources.includes(normalizedSource) || normalizedSource === 'manual') {
        return;
    }

    ensureCachedResults();
    if (!shouldRefetchSourceResults(normalizedSource, term, normalizedType)) {
        return;
    }

    const key = getSearchFetchKey(normalizedSource, term, normalizedType);
    if (searchPrefetchKeys.has(key)) {
        return;
    }

    searchPrefetchKeys.add(key);
    try {
        const typedOnly = shouldUseTypedSearch(normalizedSource, normalizedType);
        const sourceData = await fetchSourceResults(normalizedSource, term, normalizedType, { typedOnly });
        cachedResults[normalizedSource] = mergeSourceResults(
            cachedResults[normalizedSource],
            sourceData,
            normalizedSource,
            normalizedType,
            typedOnly);

        if (sourceData?.error) {
            delete cachedSearchTerms[normalizedSource];
        } else {
            cachedSearchTerms[normalizedSource] = term;
        }

        saveSearchPageState();
    } catch (error) {
        console.warn('Search tab prefetch failed:', error);
    } finally {
        searchPrefetchKeys.delete(key);
    }
}

function mapTypeToSourceResultField(type) {
    switch (String(type || '').trim().toLowerCase()) {
        case 'track':
            return 'tracks';
        case 'album':
            return 'albums';
        case 'artist':
            return 'artists';
        case 'playlist':
            return 'playlists';
        case 'station':
            return 'stations';
        case 'video':
            return 'videos';
        case 'atmos':
            return 'tracks';
        default:
            return '';
    }
}

function mergeSourceResults(existingData, incomingData, source, type, typedOnly) {
    if (!typedOnly) {
        return applyCachedLibraryStateToSourceResults(markBroadSourceResultsLoaded(incomingData, source));
    }

    const merged = {
        ...createEmptySourceResults(source),
        ...(existingData || {})
    };
    const normalizedType = normalizeTypeForSource(source, type);
    if (normalizedType === 'atmos' && (source === 'apple' || source === 'tidal')) {
        merged.tracks = incomingData.tracks || [];
        merged.albums = incomingData.albums || [];
        markSourceTypesLoaded(merged, source, ['atmos']);
        return applyCachedLibraryStateToSourceResults(merged);
    }

    const field = mapTypeToSourceResultField(normalizedType);
    if (field) {
        merged[field] = incomingData[field] || incomingData.items || [];
    }
    if (source === 'apple' && normalizedType === 'video') {
        merged.hasMoreVideos = Boolean(incomingData.hasMoreVideos);
    }
    markSourceTypesLoaded(merged, source, [normalizedType]);
    merged.error = incomingData.error || '';
    return applyCachedLibraryStateToSourceResults(merged);
}

async function fetchSourceResults(source, term, type, options = {}) {
    const normalizedSource = (source || '').toLowerCase();
    const normalizedType = (type || '').toLowerCase();
    const typedOnly = options.typedOnly === true;

    if (normalizedSource === 'apple') {
        const appleTypes = normalizedType === 'video'
            ? 'music-videos'
            : (normalizedType === 'atmos'
                ? 'songs,albums'
                : (typedOnly ? mapAppleSearchType(normalizedType) : ''));
        const appleUrl = appleTypes
            ? `/api/apple/search?term=${encodeURIComponent(term)}&types=${encodeURIComponent(appleTypes)}`
            : `/api/apple/search?term=${encodeURIComponent(term)}`;
        const appleResponse = await fetch(appleUrl);
        const appleData = await appleResponse.json().catch(() => null);
        if (!appleResponse.ok || appleData?.available === false) {
            return {
                ...createEmptySourceResults('apple'),
                error: appleData?.error || `Apple search unavailable (HTTP ${appleResponse.status})`
            };
        }
        return {
            ...createEmptySourceResults('apple'),
            ...appleData
        };
    }

    if (normalizedSource === 'tidal') {
        const tidalType = typedOnly ? mapTidalSearchType(normalizedType) : '';
        const tidalUrl = tidalType
            ? `/api/tidal/search?query=${encodeURIComponent(term)}&type=${encodeURIComponent(tidalType)}&limit=50`
            : `/api/tidal/search?query=${encodeURIComponent(term)}&limit=25`;
        const tidalResponse = await fetch(tidalUrl);
        const tidalData = await tidalResponse.json().catch(() => null);
        if (!tidalResponse.ok || tidalData?.available === false) {
            return {
                ...createEmptySourceResults('tidal'),
                error: tidalData?.error || `Tidal search unavailable (HTTP ${tidalResponse.status})`
            };
        }
        return {
            ...createEmptySourceResults('tidal'),
            ...tidalData
        };
    }

    if (normalizedSource === 'amazon') {
        const amazonType = typedOnly ? mapAmazonSearchType(normalizedType) : '';
        const amazonUrl = amazonType
            ? `/api/amazon/search?term=${encodeURIComponent(term)}&type=${encodeURIComponent(amazonType)}&limit=50`
            : `/api/amazon/search?term=${encodeURIComponent(term)}&limit=25`;
        const amazonResponse = await fetch(amazonUrl);
        const amazonData = await amazonResponse.json().catch(() => null);
        if (!amazonResponse.ok || amazonData?.available === false) {
            return {
                ...createEmptySourceResults('amazon'),
                error: amazonData?.error || `Amazon Music search unavailable (HTTP ${amazonResponse.status})`
            };
        }
        return {
            ...createEmptySourceResults('amazon'),
            ...amazonData
        };
    }

    if (normalizedSource === 'spotify') {
        const spotifyUrl = typedOnly
            ? `/api/spotify/search/type?query=${encodeURIComponent(term)}&type=${encodeURIComponent(normalizedType)}&limit=50`
            : `/api/spotify/search?query=${encodeURIComponent(term)}&limit=25`;
        const spotifyResponse = await fetch(spotifyUrl);
        if (!spotifyResponse.ok) {
            throw new Error(`Spotify search failed: HTTP ${spotifyResponse.status}`);
        }
        const spotifyData = await spotifyResponse.json();
        if (spotifyData?.available === false) {
            return {
                ...createEmptySourceResults('spotify'),
                error: spotifyData?.error || 'Spotify search unavailable.'
            };
        }
        return {
            ...createEmptySourceResults('spotify'),
            ...(typedOnly ? mapTypedSearchPayload('spotify', normalizedType, spotifyData) : spotifyData)
        };
    }

    const deezerUrl = typedOnly
        ? `/api/deezer/search/type?query=${encodeURIComponent(term)}&type=${encodeURIComponent(normalizedType)}&limit=50`
        : `/api/search?term=${encodeURIComponent(term)}&offline=false`;
    const deezerResponse = await fetch(deezerUrl);
    if (!deezerResponse.ok) {
        throw new Error(`Deezer search failed: HTTP ${deezerResponse.status}`);
    }
    const deezerData = await deezerResponse.json();
    if (deezerData?.error) {
        return {
            ...createEmptySourceResults(normalizedSource),
            ...deezerData,
            error: deezerData.error
        };
    }
    return {
        ...createEmptySourceResults(normalizedSource),
        ...(typedOnly ? mapTypedSearchPayload(normalizedSource, normalizedType, deezerData) : deezerData)
    };
}

function mapAppleSearchType(type) {
    switch (String(type || '').trim().toLowerCase()) {
        case 'track':
            return 'songs';
        case 'album':
            return 'albums';
        case 'artist':
            return 'artists';
        case 'playlist':
            return 'playlists';
        case 'station':
            return 'stations';
        case 'video':
            return 'music-videos';
        default:
            return '';
    }
}

function mapTidalSearchType(type) {
    switch (String(type || '').trim().toLowerCase()) {
        case 'track':
            return 'track';
        case 'album':
            return 'album';
        case 'artist':
            return 'artist';
        case 'playlist':
            return 'playlist';
        case 'video':
            return 'video';
        case 'atmos':
            return 'atmos';
        default:
            return '';
    }
}

function mapAmazonSearchType(type) {
    switch (String(type || '').trim().toLowerCase()) {
        case 'track':
        case 'album':
        case 'artist':
        case 'playlist':
            return type;
        default:
            return '';
    }
}

function mapTypedSearchPayload(source, type, payload) {
    if (!payload || typeof payload !== 'object') {
        return {};
    }
    const field = mapTypeToSourceResultField(type);
    if (!field) {
        return payload;
    }
    return {
        [field]: Array.isArray(payload.items) ? payload.items : []
    };
}

function enforceAppleOnlySource(type) {
    document.querySelectorAll('.source-btn').forEach(btn => {
        const isStaticDisabled = btn.dataset.staticDisabled === 'true';
        if (isStaticDisabled) {
            btn.classList.add('disabled');
            btn.setAttribute('aria-disabled', 'true');
            btn.setAttribute('disabled', '');
            return;
        }
        btn.classList.remove('disabled');
        btn.removeAttribute('aria-disabled');
        btn.removeAttribute('disabled');
    });
}

async function performSearch(term, type, options = {}) {
    if (!term) return;
    const source = currentSearchSource;
    if (source === 'manual') {
        document.getElementById('search-count').textContent = '';
        return;
    }
    // Defence in depth: while the Soulseek pane is on screen, a queued or replayed catalogue search must not
    // fire, because the streaming search API has no soulseek source and would only produce a failed request.
    if (soulseekPanelOpen) {
        return;
    }
    const requestId = ++activeSearchRequestId;
    const normalizedType = normalizeTypeForSource(source, type);
    const typedOnly = options.preferTyped === true && shouldUseTypedSearch(source, normalizedType);

    try {
        if (options.showLoading !== false) {
            const container = getResultsContainer();
            if (container) {
                container.innerHTML = `
                    <div class="loading-section">
                        <div class="loading-spinner"></div>
                        <p>Searching...</p>
                    </div>
                `;
            }
        }

        const sourceData = await fetchSourceResults(source, term, normalizedType, { typedOnly });
        if (requestId !== activeSearchRequestId) {
            return;
        }

        if (sourceData?.error) {
            if (typeof showToast === 'function') {
                showToast(sourceData.error, 'warning');
            } else {
                console.warn(sourceData.error);
            }
        }

        ensureCachedResults();
        cachedResults[source] = mergeSourceResults(cachedResults[source], sourceData, source, normalizedType, typedOnly);
        if (sourceData?.error) {
            delete cachedSearchTerms[source];
        } else {
            cachedSearchTerms[source] = term;
        }
        const mappedItems = getResultsForType(normalizedType, source);
        
        // Update search count
        document.getElementById('search-count').textContent =
            mappedItems.length > 0 ? ` - ${mappedItems.length} results` : ' - No results';
        
        // Display results
        displayResults(mappedItems, normalizedType);
        if (normalizedType !== 'video') {
            resetInfiniteScrollState(normalizedType);
        } else if (source === 'apple') {
            appleVideoOffset = (cachedResults.apple?.videos?.length) || 0;
            appleHasMoreVideos = Boolean(cachedResults.apple?.hasMoreVideos);
            appleLoadingMore = false;
        }

        void refreshLibraryExistence([source]);
        saveSearchPageState();
        scheduleSearchWarmup(source, term);
        
    } catch (error) {
        if (requestId !== activeSearchRequestId) {
            return;
        }
        console.error('Search error:', error);
        const container = getResultsContainer();
        if (!container) {
            return;
        }
        container.innerHTML = `
            <div class="error-section">
                <h3>Search Failed</h3>
                <p>${error.message}</p>
            </div>
        `;
    }
}

function getResultsForType(type, source) {
    if (!cachedResults) return [];

    const from = (data) => {
        switch (type) {
            case 'track': return data.tracks || [];
            case 'album': return data.albums || [];
            case 'artist': return data.artists || [];
            case 'playlist': return data.playlists || [];
            case 'station': return data.stations || [];
            case 'video': return data.videos || [];
            default: return [];
        }
    };

    const isAtmosOnly = (item) => Boolean(item && item.hasAtmos);
    if (soundtrackSearchMode && (source === 'spotify' || source === 'deezer')) {
        const sourceData = source === 'spotify'
            ? (cachedResults.spotify || {})
            : (cachedResults.deezer || {});
        const dedupeMixed = (rows) => {
            const seen = new Set();
            const unique = [];
            rows.forEach(item => {
                const key = `${item?.__kind || item?.type || ''}|${item?.spotifyId || item?.deezerId || item?.id || ''}|${item?.name || ''}`.toLowerCase();
                if (seen.has(key)) {
                    return;
                }
                seen.add(key);
                unique.push(item);
            });
            return unique;
        };
        const albums = (sourceData.albums || []).map(item => ({ ...item, __kind: 'album' }));
        const playlists = (sourceData.playlists || []).map(item => ({ ...item, __kind: 'playlist' }));
        const isCompilationLike = (item) => {
            const value = `${item?.name || ''} ${item?.album || ''} ${item?.artist || ''}`.toLowerCase();
            return value.includes('compilation')
                || value.includes('original motion picture soundtrack')
                || value.includes('music from')
                || value.includes('soundtrack')
                || value.includes('ost')
                || value.includes('score');
        };

        if (type === 'all') {
            return dedupeMixed([...albums, ...playlists]);
        }
        if (type === 'album') {
            return albums;
        }
        if (type === 'playlist') {
            return playlists;
        }
        if (type === 'compilation') {
            return dedupeMixed([...albums, ...playlists].filter(isCompilationLike));
        }
        return [];
    }

    if (type === 'atmos') {
        if (source !== 'apple' && source !== 'tidal') return [];
        const sourceData = cachedResults[source] || {};
        const tracks = (sourceData.tracks || []).filter(isAtmosOnly).map(t => ({ ...t, __kind: 'track' }));
        const albums = (sourceData.albums || []).filter(isAtmosOnly).map(a => ({ ...a, __kind: 'album' }));
        return [...tracks, ...albums];
    }

    if (type === 'video') {
        if (source !== 'apple' && source !== 'tidal') return [];
        return cachedResults[source]?.videos || [];
    }

    if (source === 'deezer') return from(cachedResults.deezer || {});
    if (source === 'apple') return from(cachedResults.apple || {}).filter(item => !item?.hasAtmos);
    if (source === 'amazon') return from(cachedResults.amazon || {});
    if (source === 'tidal') return from(cachedResults.tidal || {}).filter(item => !item?.hasAtmos);
    if (source === 'spotify') return from(cachedResults.spotify || {});

    return [];
}

function resetInfiniteScrollState(type) {
    if (type !== 'video') {
        appleVideoOffset = 0;
        appleHasMoreVideos = false;
        appleLoadingMore = false;
    }
}

function getResultsContainer() {
    return document.getElementById(`search-results-${currentSearchSource}`);
}

function setActiveSourceTab(source) {
    const target = document.querySelector(`.source-btn[data-source="${source}"]`);
    if (!target) return;

    if (window.bootstrap?.Tab) {
        const instance = bootstrap.Tab.getOrCreateInstance(target);
        instance.show();
        return;
    }

    document.querySelectorAll('.source-btn').forEach(btn => {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
    });
    target.classList.add('active');
    target.setAttribute('aria-selected', 'true');
    document.querySelectorAll('.tab-pane').forEach(pane => {
        pane.classList.remove('show', 'active');
    });
    const pane = document.getElementById(`search-source-${source}`);
    if (pane) {
        pane.classList.add('show', 'active');
    }
}

function setupInfiniteScroll() {
    let _scrollRafPending = false;
    window.addEventListener('scroll', () => {
        if (_scrollRafPending) return;
        _scrollRafPending = true;
        requestAnimationFrame(() => {
            _scrollRafPending = false;
            if (soulseekPanelOpen) return;
            if (currentSearchType !== 'video') return;
            if (appleLoadingMore || !appleHasMoreVideos) return;
            if (currentSearchSource !== 'apple') return;

            const nearBottom = (window.innerHeight + window.scrollY) >= (document.body.offsetHeight - 500);
            if (!nearBottom) return;

            loadMoreAppleVideos();
        });
    });
}

async function loadMoreAppleVideos() {
    if (appleLoadingMore || !currentSearchTerm) return;
    appleLoadingMore = true;

    try {
        const url = `/api/apple/search?term=${encodeURIComponent(currentSearchTerm)}&limit=30&offset=${appleVideoOffset}&types=music-videos`;
        const response = await fetch(url);
        if (!response.ok) throw new Error('Load more failed');

        const data = await response.json();
        const newVideos = data?.videos || [];
        const hasMore = Boolean(data?.hasMoreVideos);

        // Merge into cache
        ensureCachedResults();
        cachedResults.apple = cachedResults.apple || {};
        cachedResults.apple.videos = [...(cachedResults.apple.videos || []), ...newVideos];
        cachedResults.apple.hasMoreVideos = hasMore;

        appleVideoOffset = cachedResults.apple.videos.length;
        appleHasMoreVideos = hasMore;

        // Re-render only if we're still on videos
        if (currentSearchType === 'video') {
            const mappedItems = getResultsForType('video', currentSearchSource);
            document.getElementById('search-count').textContent =
                mappedItems.length > 0 ? ` - ${mappedItems.length} results` : ' - No results';
            displayResults(mappedItems, 'video');
        }
        saveSearchPageState();
    } catch (err) {
        console.warn('Load more videos failed:', err);
    } finally {
        appleLoadingMore = false;
    }
}

function updateActiveSource(source) {
    const previousSource = currentSearchSource;
    const normalizedSource = String(source || '').trim().toLowerCase();
    if (searchSources.includes(normalizedSource)) {
        currentSearchSource = normalizedSource;
    }
    if (previousSource !== currentSearchSource) {
        selectedVideoKeys.clear();
        showSelectedOnly = false;
    }
    setActiveSourceTab(currentSearchSource);
    if (currentSearchSource === 'manual') {
        document.getElementById('search-count').textContent = '';
        saveSearchPageState();
        return;
    }
    const selectedType = sourceTypeSelections[currentSearchSource] || currentSearchType;
    currentSearchType = normalizeTypeForSource(currentSearchSource, selectedType);
    sourceTypeSelections[currentSearchSource] = currentSearchType;
    updateActiveFilter(currentSearchType);
    if (cachedResults) {
        const items = getResultsForType(currentSearchType, currentSearchSource);
        document.getElementById('search-count').textContent =
            items.length > 0 ? ` - ${items.length} results` : ' - No results';
        displayResults(items, currentSearchType);
        ensureLibraryStatusForCurrentView();
    }
    saveSearchPageState();
}

function displayResults(results, type) {
    const container = getResultsContainer();
    if (!container) return;
    let list = results || [];
    if (type === 'video' && showSelectedOnly && selectedVideoKeys.size > 0) {
        list = list.filter(item => {
            const key = getVideoKey(item);
            return key && selectedVideoKeys.has(key);
        });
    }

    if (!list || list.length === 0) {
        if (type === 'atmos') {
            const anyTracks = getResultsForType('track', currentSearchSource);
            const sourceLabel = currentSearchSource === 'tidal' ? 'Tidal' : 'Apple';
            const hint = anyTracks.length > 0
                ? `No Atmos results found. Try the Tracks tab to see ${sourceLabel} results.`
                : 'No Atmos results found for this search.';
            container.innerHTML = `
                <div class="empty-results">
                    <h3>No Atmos Results Yet</h3>
                    <p>${hint}</p>
                </div>
            `;
            return;
        }
        container.innerHTML = `
            <div class="empty-results">
                <h3>No Results Found</h3>
                <p>Try searching with different keywords or check your spelling.</p>
            </div>
        `;
        updateVideoSelectionBar();
        return;
    }
    
    const gridClass = type === 'video' ? 'results-grid artist-video-style' : 'results-grid';
    container.innerHTML = `
        <div class="${gridClass}">
            ${list.map(item => renderResultCard(item, type)).join('')}
        </div>
    `;
    updateVideoSelectionBar();
}

function renderResultCard(item, type) {
    const resolvedType = (type === 'all' || type === 'compilation')
        ? String(item?.__kind || item?.type || 'album').toLowerCase()
        : type;
    let imageUrl = '';
    let title = '';
    let artist = '';
    let meta = '';
    let clickAction = '';
    let videoKey = '';
    let qobuzQualityHtml = '';
    let effectiveType = type;
    const itemTitle = getSearchItemTitle(item);
    const itemArtist = getSearchItemArtist(item);
    const itemAlbum = getSearchItemAlbum(item);
    
    switch (resolvedType) {
        case 'track':
        case 'atmos':
            effectiveType = item.__kind || (type === 'atmos' ? 'track' : type);
            if (effectiveType === 'album') {
                imageUrl = resolveResultImageUrl(item);
                title = itemTitle;
                artist = itemArtist;
                meta = item.release_date || '';
                clickAction = buildUnifiedClick(item, 'album');
            } else {
                imageUrl = resolveResultImageUrl(item);
                title = itemTitle;
                artist = itemArtist;
                meta = itemAlbum;
                clickAction = buildUnifiedClick(item, 'track');
            }
            if (currentSearchSource === 'qobuz') {
                qobuzQualityHtml = renderQobuzQuality(item);
            }
            break;
            
        case 'album':
            imageUrl = resolveResultImageUrl(item);
            title = itemTitle;
            artist = itemArtist;
            meta = item.release_date || '';
            clickAction = buildUnifiedClick(item, 'album');
            if (currentSearchSource === 'qobuz') {
                qobuzQualityHtml = renderQobuzQuality(item);
            }
            break;
            
        case 'artist':
            imageUrl = resolveResultImageUrl(item);
            title = itemTitle;
            artist = '';
            if (item.followers) {
                meta = `${item.followers} followers`;
            } else if (item.albumsCount) {
                meta = `${item.albumsCount} releases`;
            } else {
                meta = '';
            }
            if (currentSearchSource === 'qobuz' && item.qobuzId) {
                clickAction = `loadQobuzArtistDiscography('${escapeJsString(item.qobuzId)}', '${escapeJsString(itemTitle)}')`;
            } else {
                clickAction = buildUnifiedClick(item, 'artist');
            }
            break;
            
        case 'playlist':
            imageUrl = resolveResultImageUrl(item);
            title = itemTitle;
            artist = item.owner || '';
            const playlistTracks = item.nb_tracks ?? item.trackCount ?? item.track_count;
            const playlistFans = item.fans ?? item.followers;
            const playlistFlags = [];
            if (typeof item.public === 'boolean') {
                playlistFlags.push(item.public ? 'Public' : 'Private');
            }
            if (item.collaborative === true) {
                playlistFlags.push('Collaborative');
            }
            meta = [
                typeof playlistTracks === 'number' ? `${playlistTracks} tracks` : '',
                typeof playlistFans === 'number' ? `${playlistFans} followers` : '',
                playlistFlags.join(' • ')
            ].filter(Boolean).join(' • ');
            clickAction = buildUnifiedClick(item, 'playlist');
            break;

        case 'station':
            imageUrl = resolveResultImageUrl(item);
            title = itemTitle;
            artist = '';
            meta = 'Apple Music Station';
            clickAction = buildUnifiedClick(item, 'station');
            break;

        case 'video':
            imageUrl = resolveResultImageUrl(item);
            title = itemTitle;
            artist = itemArtist;
            videoKey = getVideoKey(item);
            clickAction = videoKey ? `toggleVideoSelection('${escapeJsString(videoKey)}')` : '';
            break;
    }
    
    const defaultIcon = effectiveType === 'artist'
        ? '👤'
        : effectiveType === 'album'
            ? '💿'
            : effectiveType === 'video'
                ? '🎬'
                : '🎵';
    
    const imgHtml = imageUrl
        ? `<img src="${escapeHtml(imageUrl)}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove();" />`
        : '';

    const selectedClass = (resolvedType === 'video' && videoKey && isVideoSelected(videoKey)) ? ' selected' : '';
    const extraClass = resolvedType === 'video' ? ' video' : '';
    const tidalUrl = item.tidalUrl || item.externalUrl || '';
    const tidalId = item.tidalId || '';
    const libKeyRaw = (resolvedType === 'track' || resolvedType === 'atmos') ? buildLibraryCheckKey(item) : '';
    const libKeyAttr = libKeyRaw ? ` data-lib-key="${escapeHtml(libKeyRaw).replace(/"/g, '&quot;')}"` : '';

    const isVideoCard = resolvedType === 'video';
    const showLibraryBadge = item?.inLibrary === true
        && (effectiveType === 'track' || resolvedType === 'track' || type === 'track' || type === 'atmos');
    const libraryBadge = showLibraryBadge
        ? `<div class="result-badge">In Library</div>`
        : '';

    if (isVideoCard) {
        const dateRaw = item.releaseDate || item.release_date || item.releaseDateUtc || '';
        const releaseYear = dateRaw ? new Date(dateRaw).getFullYear() : '';
        const yearText = Number.isFinite(releaseYear) ? String(releaseYear) : '';
        const subText = yearText && artist ? `${artist} · ${yearText}` : (artist || yearText);
        const hasManifestAtmos = item?.hasAtmosDownloadable === true;
        const hasCatalogAtmos = item?.hasAtmosDownloadable == null && item?.hasAtmos === true;
        const hasStereoOnly = item?.hasAtmosDownloadable === false;
        const hasAtmosCapability = hasManifestAtmos || hasCatalogAtmos;
        const capabilityBadge = hasManifestAtmos || hasCatalogAtmos
            ? `<div class="artist-video-capabilities"><span class="artist-video-badge atmos-verified">Atmos</span></div>`
            : hasStereoOnly
                ? `<div class="artist-video-capabilities"><span class="artist-video-badge stereo-only">Stereo</span></div>`
                : '';
        const cardClickAttr = clickAction ? ` onclick="${clickAction}"` : '';
        const source = String(item.source || currentSearchSource || '').trim().toLowerCase();
        const playablePreviewUrl = source === 'tidal' && tidalId
            ? `/api/tidal/download/videos/preview?id=${encodeURIComponent(tidalId)}`
            : (item.previewUrl || '');
        const previewButton = playablePreviewUrl
            ? `<button class="video-overlay-btn video-overlay-btn--play" type="button" aria-label="Play preview" onclick="event.stopPropagation(); playVideoPreview('${escapeJsString(playablePreviewUrl)}')">
                   <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
               </button>`
            : '';
        const downloadIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';
        const downloadButton = source === 'tidal'
            ? (tidalUrl
                ? `<button class="video-overlay-btn video-overlay-btn--download" type="button" aria-label="Download" onclick="event.stopPropagation(); downloadTidalVideoFromSearch('${escapeJsString(tidalUrl)}', '${escapeJsString(tidalId)}', '${escapeJsString(title)}', '${escapeJsString(artist)}', '${escapeJsString(imageUrl)}')">${downloadIcon}</button>`
                : '')
            : (item.appleUrl
                ? `<button class="video-overlay-btn video-overlay-btn--download" type="button" aria-label="Download" onclick="event.stopPropagation(); downloadAppleVideo('${escapeJsString(item.appleUrl)}', ${hasAtmosCapability ? 'true' : 'false'})">${downloadIcon}</button>`
                : '');
        return `
            <div class="result-card video apple-card${selectedClass}"${cardClickAttr}>
                <div class="apple-thumb">
                    ${imgHtml}
                    ${previewButton}
                    ${downloadButton}
                </div>
                <div class="apple-title">${escapeHtml(title)}</div>
                ${subText ? `<div class="apple-sub">${escapeHtml(subText)}</div>` : ''}
                ${libraryBadge}
                ${capabilityBadge}
            </div>
        `;
    }

    const cardClickAttr = clickAction ? ` onclick="${clickAction}"` : '';
    return `
        <div class="result-card${extraClass}${selectedClass}"${libKeyAttr}${cardClickAttr}>
            <div class="result-image ${imageUrl ? '' : 'no-img'}">
                ${imgHtml}
                <span class="result-image-placeholder">${defaultIcon}</span>
            </div>
            <div class="result-title">${escapeHtml(title)}</div>
            ${artist ? `<div class="result-artist">${escapeHtml(artist)}</div>` : ''}
            ${isVideoCard && meta ? `<div class="result-meta">${meta}</div>` : ''}
            ${isVideoCard ? qobuzQualityHtml : ''}
            ${libraryBadge}
        </div>
    `;
}

function resolveResultImageUrl(item) {
    if (!item || typeof item !== 'object') {
        return '';
    }

    const firstNonEmpty = (...values) => {
        for (const value of values) {
            const normalized = typeof value === 'string' ? value.trim() : '';
            if (normalized) {
                return normalized;
            }
        }
        return '';
    };

    const imageObject = (item.image && typeof item.image === 'object') ? item.image : null;
    const imageFromObject = imageObject
        ? firstNonEmpty(imageObject.url, imageObject.fullUrl, imageObject.full, imageObject.thumbUrl, imageObject.thumb)
        : '';
    const imageFromImagesArray = Array.isArray(item.images)
        ? firstNonEmpty(...item.images.map(entry => {
            if (typeof entry === 'string') {
                return entry;
            }
            if (!entry || typeof entry !== 'object') {
                return '';
            }
            return firstNonEmpty(entry.url, entry.imageUrl, entry.fullUrl, entry.full, entry.thumbUrl, entry.thumb);
        }))
        : '';

    return firstNonEmpty(
        item.image,
        imageFromObject,
        item.imageUrl,
        item.image_url,
        item.coverUrl,
        item.cover_url,
        item.cover,
        item.artwork,
        item.picture_xl,
        item.picture_big,
        item.picture_medium,
        item.picture,
        item.picture_small,
        imageFromImagesArray
    );
}

function toBoolish(value) {
    if (value === true || value === false) return value;
    if (typeof value === 'number') return value !== 0;
    if (typeof value === 'string') {
        const v = value.trim().toLowerCase();
        return v === 'true' || v === '1' || v === 'yes';
    }
    return false;
}

function renderQobuzQuality(item) {
    if (!item) {
        return '';
    }

    const hasHiRes = toBoolish(item.hasHiRes ?? item.hires ?? item.hires_streamable);
    const bitDepthValue = Number(item.bitDepth ?? item.maximum_bit_depth ?? 0);
    const sampleRateValue = Number(item.sampleRate ?? item.maximum_sampling_rate ?? 0);
    const hasNumericQuality = (Number.isFinite(bitDepthValue) && bitDepthValue > 0)
        || (Number.isFinite(sampleRateValue) && sampleRateValue > 0);
    if (!hasHiRes && !hasNumericQuality) {
        return '';
    }

    const bitDepth = Number.isFinite(bitDepthValue) && bitDepthValue > 0
        ? `${Math.round(bitDepthValue)}-bit`
        : '';
    const sampleRate = Number.isFinite(sampleRateValue) && sampleRateValue > 0
        ? `${sampleRateValue % 1 === 0 ? sampleRateValue.toFixed(0) : sampleRateValue.toFixed(1)} kHz`
        : '';
    const details = [bitDepth, sampleRate].filter(Boolean).join(' / ');
    const tier = hasHiRes ? 'Hi-Res' : 'CD';
    const title = details ? `${tier} • ${details}` : tier;

    return `
        <div class="qobuz-quality ${hasHiRes ? 'is-hires' : 'is-cd'}" title="${escapeHtml(title)}">
            <span class="qobuz-quality-tier">${tier}</span>
            ${details ? `<span class="qobuz-quality-details">${escapeHtml(details)}</span>` : ''}
        </div>
    `;
}

async function loadQobuzArtistDiscography(artistId, artistName) {
    const normalizedId = String(artistId || '').trim();
    if (!normalizedId) {
        return;
    }

    const qobuzStore = document.getElementById('qobuz-store')?.value || 'us-en';
    const endpoint = `/api/qobuz/artist/${encodeURIComponent(normalizedId)}/discography?store=${encodeURIComponent(qobuzStore)}`;

    try {
        const response = await fetch(endpoint);
        if (!response.ok) {
            throw new Error(`Qobuz discography failed: HTTP ${response.status}`);
        }

        const payload = await response.json();
        const albums = payload?.albums_without_last_release?.items || [];
        const mappedAlbums = albums.map(album => {
            const albumId = String(album?.id || '').trim();
            const releaseDate = album?.release_date_original || album?.release_date_stream || album?.release_date_download || '';
            const image = album?.image?.large || album?.image?.extralarge || album?.image?.medium || album?.image?.small || '';
            const artist = Array.isArray(album?.artists) && album.artists.length > 0
                ? (album.artists[0]?.name || '')
                : '';
            const qobuzUrl = album?.url || (albumId ? `https://play.qobuz.com/album/${encodeURIComponent(albumId)}` : '');

            return {
                source: 'qobuz',
                type: 'album',
                qobuzType: 'album',
                qobuzId: albumId,
                qobuzUrl,
                qobuzStore,
                name: [album?.title || '', album?.version || ''].filter(Boolean).join(' ').trim(),
                artist,
                image,
                release_date: releaseDate,
                trackCount: Number(album?.tracks_count || 0) || 0,
                hasHiRes: toBoolish(album?.hires ?? album?.hires_streamable),
                bitDepth: Number(album?.maximum_bit_depth || 0) || 0,
                sampleRate: Number(album?.maximum_sampling_rate || 0) || 0
            };
        });

        ensureCachedResults();
        const qobuzCached = cachedResults.qobuz || createEmptySourceResults('qobuz');
        qobuzCached.albums = mappedAlbums;
        qobuzCached.error = '';
        cachedResults.qobuz = qobuzCached;

        currentSearchType = 'album';
        updateActiveFilter('album');

        document.getElementById('search-count').textContent =
            mappedAlbums.length > 0 ? ` - ${mappedAlbums.length} releases` : ' - No releases';
        displayResults(mappedAlbums, 'album');

        const queryLabel = document.getElementById('search-query');
        if (queryLabel && artistName) {
            queryLabel.textContent = `Qobuz discography for "${artistName}"`;
        }
    } catch (error) {
        console.error('Qobuz discography error:', error);
        const container = getResultsContainer();
        if (container) {
            container.innerHTML = `
                <div class="error-section">
                    <h3>Discography Failed</h3>
                    <p>${error?.message || 'Failed to load Qobuz discography.'}</p>
                </div>
            `;
        }
    }
}

function buildUnifiedClick(item, type) {
    const source = String(item?.source || currentSearchSource || '').trim().toLowerCase();
    if (source === 'apple') {
        return buildAppleResultClick(item, type);
    }
    if (source === 'amazon' || source === 'amazonmusic') {
        return buildAmazonResultClick(item, type);
    }
    if (source === 'tidal') {
        return buildTidalResultClick(item, type);
    }

    const deezerId = item.deezerId || '';
    if (deezerId) {
        if (type === 'artist') {
            return `openUnifiedArtist('${deezerId}', 'deezer')`;
        }
        return `openUnifiedTracklist('${deezerId}', '${type}', 'deezer')`;
    }
    const spotifyId = item.spotifyId || '';
    if (spotifyId) {
        if (type === 'artist') {
            return `openUnifiedArtist('${spotifyId}', 'spotify')`;
        }
        return `openUnifiedTracklist('${spotifyId}', '${type}', 'spotify')`;
    }
    const appleClick = buildAppleResultClick(item, type);
    if (appleClick) return appleClick;
    const tidalClick = buildTidalResultClick(item, type);
    if (tidalClick) return tidalClick;
    const amazonClick = buildAmazonResultClick(item, type);
    if (amazonClick) return amazonClick;
    const qobuzUrl = item.qobuzUrl || buildQobuzUrlForItem(item.qobuzId || '', item.qobuzType || type || '');
    if (qobuzUrl) {
        return '';
    }
    return '';
}

function buildAppleResultClick(item, type) {
    const normalizedType = normalizeAppleCatalogResultType(item?.type || type || '');
    const appleId = item?.appleId || item?.id || '';
    const appleUrl = item?.appleUrl || item?.url || item?.sourceUrl || '';
    if (normalizedType === 'artist') {
        return appleId ? `openUnifiedArtist('${escapeJsString(appleId)}', 'apple')` : '';
    }
    if (appleId) {
        return `openAppleResult('${escapeJsString(appleId)}', '${escapeJsString(normalizedType || 'track')}', '${escapeJsString(appleUrl)}')`;
    }
    if (appleUrl) {
        return `openAppleResult('${escapeJsString(appleUrl)}', '${escapeJsString(normalizedType || 'track')}', '${escapeJsString(appleUrl)}')`;
    }
    return '';
}

function normalizeAppleCatalogResultType(type) {
    switch (String(type || '').trim().toLowerCase()) {
        case 'songs':
        case 'song':
        case 'track':
            return 'track';
        case 'albums':
        case 'album':
            return 'album';
        case 'artists':
        case 'artist':
            return 'artist';
        case 'playlists':
        case 'playlist':
            return 'playlist';
        case 'stations':
        case 'station':
            return 'station';
        case 'music-videos':
        case 'music-video':
        case 'video':
            return 'video';
        default:
            return String(type || '').trim().toLowerCase();
    }
}

function buildTidalResultClick(item, type) {
    const normalizedType = String(item?.type || type || '').trim().toLowerCase();
    const tidalId = item?.tidalId || item?.id || '';
    const tidalUrl = item?.tidalUrl || item?.externalUrl || item?.sourceUrl || item?.url || '';
    if (!tidalId && !tidalUrl) {
        return '';
    }
    return `openTidalResult('${escapeJsString(tidalId)}', '${escapeJsString(normalizedType || 'track')}', '${escapeJsString(tidalUrl)}', '${escapeJsString(getSearchItemTitle(item))}')`;
}

function buildAmazonResultClick(item, type) {
    const normalizedType = String(item?.type || type || '').trim().toLowerCase();
    const amazonId = item?.amazonId || item?.id || '';
    const amazonUrl = item?.sourceUrl || item?.url || '';
    if (!amazonId && !amazonUrl) {
        return '';
    }
    return `openAmazonResult('${escapeJsString(amazonId)}', '${escapeJsString(normalizedType || 'track')}', '${escapeJsString(amazonUrl)}', '${escapeJsString(getSearchItemTitle(item))}', '${escapeJsString(getSearchItemArtist(item))}', '${escapeJsString(getSearchItemAlbum(item) || getSearchItemTitle(item))}', '${escapeJsString(resolveResultImageUrl(item))}', '${escapeJsString(String(resolveSearchItemDurationMs(item) || ''))}', '${escapeJsString(String(item?.isrc || ''))}', ${item?.hasAtmos === true ? 'true' : 'false'})`;
}

function getVideoKey(item) {
    return (item.appleId && String(item.appleId))
        || (item.appleUrl || '')
        || (item.tidalId ? `tidal:${String(item.tidalId)}` : '')
        || (item.tidalUrl || item.externalUrl || '');
}

function isVideoSelected(key) {
    return selectedVideoKeys.has(key);
}

function toggleVideoSelection(key) {
    if (!key) return;
    if (selectedVideoKeys.has(key)) {
        selectedVideoKeys.delete(key);
    } else {
        selectedVideoKeys.add(key);
    }
    if (currentSearchType === 'video') {
        const mappedItems = getResultsForType('video', currentSearchSource);
        document.getElementById('search-count').textContent =
            mappedItems.length > 0 ? ` - ${mappedItems.length} results` : ' - No results';
        displayResults(mappedItems, 'video');
    }
    updateVideoSelectionBar();
    saveSearchPageState();
}

function openUnifiedArtist(id, source) {
    if (!id) {
        return;
    }
    saveSearchPageState();
    window.location.href = `/Artist?id=${encodeURIComponent(id)}&source=${encodeURIComponent(source)}`;
}

function openUnifiedTracklist(id, type, source) {
    if (!id) {
        return;
    }
    navigateToTracklist(id, type, source);
}

function openAppleResult(appleId, type, appleUrl) {
    const normalizedType = String(type || '').trim().toLowerCase();
    const normalizedId = String(appleId || '').trim();
    const normalizedUrl = String(appleUrl || '').trim();
    if (normalizedType === 'artist') {
        if (normalizedId) {
            openUnifiedArtist(normalizedId, 'apple');
        }
        return;
    }

    const id = normalizedId || normalizedUrl;
    if (!id) {
        return;
    }
    navigateToTracklist(id, normalizedType || 'track', 'apple', { externalUrl: normalizedUrl, appleUrl: normalizedUrl });
}

function openTidalResult(tidalId, type, tidalUrl, artistName = '') {
    const normalizedType = String(type || '').trim().toLowerCase();
    const normalizedId = String(tidalId || '').trim();
    const normalizedUrl = String(tidalUrl || '').trim() || buildTidalUrlForItem(normalizedId, normalizedType);
    if (normalizedType === 'artist') {
        if (normalizedId) {
            openUnifiedArtist(normalizedId, 'tidal');
        }
        return;
    }

    const id = normalizedId || normalizedUrl;
    if (!id) {
        return;
    }
    navigateToTracklist(id, normalizedType || 'track', 'tidal');
}

function openAmazonResult(amazonId, type, amazonUrl, title = '', artist = '', album = '', cover = '', durationMs = '', isrc = '', hasAtmos = false) {
    const normalizedType = String(type || '').trim().toLowerCase();
    const normalizedId = String(amazonId || '').trim();
    const normalizedUrl = String(amazonUrl || '').trim();
    if (normalizedType === 'artist') {
        if (normalizedId) {
            openUnifiedArtist(normalizedId, 'amazon');
        }
        return;
    }

    const id = normalizedId || normalizedUrl;
    if (!id) {
        return;
    }
    const amazonTrack = normalizedType === 'track'
        ? {
            title,
            artist,
            album,
            cover,
            durationMs,
            isrc,
            hasAtmos: hasAtmos === true ? 'true' : ''
        }
        : null;
    navigateToTracklist(id, normalizedType || 'track', 'amazon', { externalUrl: normalizedUrl, amazonTrack });
}

function buildTidalUrlForItem(id, type) {
    const normalizedId = String(id || '').trim();
    if (!normalizedId) {
        return '';
    }
    const normalizedType = String(type || 'track').trim().toLowerCase();
    if (normalizedType === 'album') {
        return `https://tidal.com/browse/album/${encodeURIComponent(normalizedId)}`;
    }
    if (normalizedType === 'artist') {
        return `https://tidal.com/browse/artist/${encodeURIComponent(normalizedId)}`;
    }
    if (normalizedType === 'playlist') {
        return `https://tidal.com/browse/playlist/${encodeURIComponent(normalizedId)}`;
    }
    return `https://tidal.com/browse/track/${encodeURIComponent(normalizedId)}`;
}

function showAppleResult(url) {
    if (!url) return;
    saveSearchPageState();
    // Open directly (no modal)
    window.open(url, '_blank', 'noopener');
}

function buildQobuzUrlForItem(id, type) {
    const qobuzId = String(id || '').trim();
    if (!qobuzId) {
        return '';
    }

    const normalizedType = String(type || 'track').trim().toLowerCase();
    if (normalizedType === 'artist') {
        return `https://play.qobuz.com/artist/${encodeURIComponent(qobuzId)}`;
    }
    if (normalizedType === 'album') {
        return `https://play.qobuz.com/album/${encodeURIComponent(qobuzId)}`;
    }
    return `https://play.qobuz.com/track/${encodeURIComponent(qobuzId)}`;
}

function openExternalResult(url) {
    if (!url) {
        return;
    }
    saveSearchPageState();
    window.open(url, '_blank', 'noopener');
}

const _htmlEscapeNode = document.createElement('div');
function escapeHtml(text) {
    if (!text) return '';
    _htmlEscapeNode.textContent = text;
    return _htmlEscapeNode.innerHTML;
}

function escapeJsString(value) {
    if (!value) return '';
    return String(value)
        .replaceAll('\\', '\\\\')
        .replaceAll("'", "\\'")
        .replaceAll('\n', '')
        .replaceAll('\r', '');
}

function normalizeTypeForSource(source, type) {
    const normalizedSource = String(source || '').trim().toLowerCase();
    const normalizedType = String(type || '').trim().toLowerCase();

    if (soundtrackSearchMode) {
        if (soundtrackSearchTypes.has(normalizedType)) {
            return normalizedType;
        }
        return 'all';
    }

    // Deezer search path does not return station entities; force tracks for deterministic results.
    if (normalizedSource === 'deezer' && normalizedType === 'station') {
        return 'track';
    }

    if (normalizedSource !== 'apple' && normalizedSource !== 'tidal' && (normalizedType === 'atmos' || normalizedType === 'video')) {
        return 'track';
    }

    return normalizedType || 'track';
}

function buildLibraryCheckKey(item) {
    if (!item) return '';
    const normalizeKeyValue = (value) => String(value ?? '').trim();
    const isrc = normalizeKeyValue(item.isrc);
    if (isrc) return `isrc:${isrc.toLowerCase()}`;
    const title = normalizeKeyValue(getSearchItemTitle(item)).toLowerCase();
    const artist = normalizeKeyValue(getSearchItemArtist(item)).toLowerCase();
    const duration = resolveSearchItemDurationMs(item);
    if (!title || !artist) return '';
    return `track:${title}|artist:${artist}|dur:${duration || 0}`;
}

function getSearchItemTitle(item) {
    if (!item || typeof item !== 'object') return '';
    return String(item.name || item.title || item.trackTitle || '').trim();
}

function getSearchItemArtist(item) {
    if (!item || typeof item !== 'object') return '';
    const artist = item.artist;
    if (typeof artist === 'string') return artist.trim();
    if (artist && typeof artist === 'object') {
        return String(artist.name || artist.title || '').trim();
    }
    return String(item.artistName || item.contributors || '').trim();
}

function getSearchItemAlbum(item) {
    if (!item || typeof item !== 'object') return '';
    const album = item.album || item.albumTitle || item.albumName;
    if (typeof album === 'string') return album.trim();
    if (album && typeof album === 'object') {
        return String(album.title || album.name || '').trim();
    }
    return '';
}

function resolveSearchItemDurationMs(item) {
    if (!item) return 0;
    const durationMs = Number(item.durationMs || item.duration_ms || 0);
    if (Number.isFinite(durationMs) && durationMs > 0) {
        return Math.round(durationMs);
    }

    const durationSeconds = Number(item.duration || item.durationSeconds || item.duration_seconds || 0);
    return Number.isFinite(durationSeconds) && durationSeconds > 0
        ? Math.round(durationSeconds * 1000)
        : 0;
}

async function refreshLibraryExistence(sourcesToCheck) {
    if (!cachedResults) return;
    const sources = Array.isArray(sourcesToCheck) && sourcesToCheck.length > 0
        ? sourcesToCheck
        : ['deezer', 'spotify', 'apple', 'amazon', 'tidal'];
    const tasks = sources.map(source => updateLibraryStatusForTracks(cachedResults[source]?.tracks || [], source));
    await Promise.all(tasks);
    if (currentSearchType === 'track' || currentSearchType === 'atmos') {
        displayResults(getResultsForType(currentSearchType, currentSearchSource), currentSearchType);
    }
    saveSearchPageState();
}

function ensureLibraryStatusForCurrentView() {
    if (!cachedResults || currentSearchType !== 'track') {
        return;
    }

    const tracks = cachedResults[currentSearchSource]?.tracks || [];
    if (!tracks.some(item => {
        const key = buildLibraryCheckKey(item);
        return key && !libraryExistenceCache.has(key);
    })) {
        return;
    }

    void refreshLibraryExistence([currentSearchSource]);
}

function applyCachedLibraryStateToSourceResults(sourceData) {
    if (!sourceData || typeof sourceData !== 'object') {
        return sourceData;
    }

    ['tracks', 'videos'].forEach(field => {
        if (!Array.isArray(sourceData[field])) {
            return;
        }

        sourceData[field].forEach(item => {
            const key = buildLibraryCheckKey(item);
            if (key && libraryExistenceCache.has(key)) {
                item.inLibrary = libraryExistenceCache.get(key) === true;
            }
        });
    });

    return sourceData;
}

async function updateLibraryStatusForTracks(items, source) {
    if (!items || items.length === 0) return;
    const normalizedSource = String(source || currentSearchSource || '').trim().toLowerCase();
    const requests = [];
    for (const item of items) {
        const key = buildLibraryCheckKey(item);
        if (!key) continue;
        if (libraryExistenceCache.has(key)) {
            item.inLibrary = libraryExistenceCache.get(key) === true;
            continue;
        }
        const req = {
            id: key,
            source: normalizedSource,
            sourceId: item.tidalId || item.appleId || item.spotifyId || item.deezerId || item.id || item.sourceId || '',
            isrc: item.isrc || '',
            trackTitle: getSearchItemTitle(item),
            artistName: getSearchItemArtist(item),
            albumTitle: getSearchItemAlbum(item),
            durationMs: resolveSearchItemDurationMs(item) || null
        };
        requests.push(req);
    }

    if (requests.length === 0) return;

    try {
        const resp = await fetch('/api/library/exists', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(requests)
        });
        if (!resp.ok) return;
        const data = await resp.json();
        if (!Array.isArray(data)) return;
        for (const row of data) {
            const key = row?.id;
            if (!key) continue;
            const exists = row?.exists === true;
            libraryExistenceCache.set(key, exists);
        }
        for (const item of items) {
            const key = buildLibraryCheckKey(item);
            if (!key) continue;
            if (libraryExistenceCache.has(key)) {
                item.inLibrary = libraryExistenceCache.get(key) === true;
            }
        }
    } catch (err) {
        console.warn('Library existence check failed:', err);
    }
}

async function playVideoPreview(url) {
    if (!url) return;
    await window.DeezSpoTagVideoPreview.play(url, {
        catchSetupError: true,
        onInvalidUrl: () => window.DeezSpoTag?.ui?.showToast?.('Invalid preview URL.', { type: 'error' }),
        onPlaybackError: () => window.DeezSpoTag?.ui?.showToast?.('Video preview failed.', { type: 'error' })
    });
}

async function downloadAppleVideo(appleUrl, hasAtmos = false) {
    if (!appleUrl) return;
    const videoMetadata = {
        isVideo: true,
        collectionType: 'music-video',
        contentType: 'video',
        hasAtmos: hasAtmos === true
    };
    try {
        if (window.DeezSpoTagDownload?.addToQueue) {
            await window.DeezSpoTagDownload.addToQueue(appleUrl, 0, null, { metadata: videoMetadata });
            return;
        }
        const resp = await fetch('/api/apple/videos/download', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                appleUrl,
                metadata: videoMetadata
            })
        });
        const data = await resp.json();
        if (!resp.ok || !data?.success) {
            throw new Error(data?.error || 'Download failed');
        }
        if (window.DeezSpoTag?.ui?.showToast) {
            window.DeezSpoTag.ui.showToast('Video download started');
        }
    } catch (err) {
        console.error('Video download failed', err);
        if (window.DeezSpoTag?.ui?.showToast) {
            window.DeezSpoTag.ui.showToast(err.message || 'Download failed', { type: 'error' });
        }
    }
}

async function downloadTidalVideoFromSearch(tidalUrl, tidalId = '', title = '', artist = '', image = '') {
    const normalizedUrl = String(tidalUrl || '').trim();
    if (!normalizedUrl) return;
    try {
        const response = await fetch('/api/tidal/download/videos/download', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                tracks: [{
                    sourceUrl: normalizedUrl,
                    tidalId,
                    title,
                    artist,
                    cover: image,
                    collectionType: 'music-video',
                    queueOrigin: 'search-videos'
                }]
            })
        });
        const data = await response.json().catch(() => null);
        if (!response.ok || data?.success === false) {
            throw new Error(data?.error || data?.message || 'Download failed');
        }
        if (window.DeezSpoTag?.ui?.showToast) {
            window.DeezSpoTag.ui.showToast('Video download started');
        }
    } catch (err) {
        console.error('Tidal video download failed', err);
        if (window.DeezSpoTag?.ui?.showToast) {
            window.DeezSpoTag.ui.showToast(err.message || 'Download failed', { type: 'error' });
        }
    }
}

function updateVideoSelectionBar() {
    const isTidal = currentSearchSource === 'tidal';
    const bar = document.getElementById(isTidal ? 'tidal-video-selection-bar' : 'video-selection-bar');
    const inactiveBar = document.getElementById(isTidal ? 'video-selection-bar' : 'tidal-video-selection-bar');
    const countEl = document.getElementById(isTidal ? 'tidal-selection-count' : 'selection-count');
    const viewToggle = document.getElementById(isTidal ? 'tidal-view-selected-toggle' : 'view-selected-toggle');
    const count = selectedVideoKeys.size;
    if (!bar || !countEl) return;
    if (inactiveBar) {
        inactiveBar.classList.remove('active');
    }

    countEl.textContent = `${count} selected`;
    if (count > 0 && currentSearchType === 'video' && (currentSearchSource === 'apple' || currentSearchSource === 'tidal')) {
        bar.classList.add('active');
    } else {
        bar.classList.remove('active');
        showSelectedOnly = false;
        if (viewToggle) {
            viewToggle.textContent = 'View selected only';
        }
    }

    if (viewToggle) {
        viewToggle.textContent = showSelectedOnly ? 'Show all videos' : 'View selected only';
    }
}

function clearVideoSelection() {
    selectedVideoKeys.clear();
    if (currentSearchType === 'video') {
        const mappedItems = getResultsForType('video', currentSearchSource);
        displayResults(mappedItems, 'video');
    }
    updateVideoSelectionBar();
    saveSearchPageState();
}

async function downloadSelectedVideos() {
    if (selectedVideoKeys.size === 0) return;
    const items = getResultsForType('video', currentSearchSource);
    const byKey = new Map();
    for (const item of items) {
        const key = getVideoKey(item);
        if (key) {
            byKey.set(key, item);
        }
    }

    let started = 0;
    for (const key of selectedVideoKeys) {
        const item = byKey.get(key);
        const appleUrl = item?.appleUrl;
        const tidalUrl = item?.tidalUrl || item?.externalUrl;
        if (!appleUrl && !tidalUrl) continue;
        started++;
        if (currentSearchSource === 'tidal') {
            downloadTidalVideoFromSearch(
                tidalUrl,
                item?.tidalId || '',
                item?.name || '',
                item?.artist || '',
                resolveResultImageUrl(item));
        } else {
            downloadAppleVideo(appleUrl);
        }
    }

    if (started > 0 && window.DeezSpoTag?.ui?.showToast) {
        window.DeezSpoTag.ui.showToast(`Started ${started} video download(s)`);
    }
}

function toggleViewSelected() {
    if (selectedVideoKeys.size === 0) return;
    showSelectedOnly = !showSelectedOnly;
    if (currentSearchType === 'video') {
        const mappedItems = getResultsForType('video', currentSearchSource);
        displayResults(mappedItems, 'video');
    }
    updateVideoSelectionBar();
    saveSearchPageState();
}
</script>
