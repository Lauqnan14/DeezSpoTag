                <!-- Progressive search header. A Soulseek search runs against the whole peer network, so the
                     header reports what the server is actually doing rather than a spinner over an empty list. -->
                <section class="soulseek-panel" id="soulseek-search-panel">
                    <!-- Shown only while Soulseek has no verified login. It carries the reason and the way out,
                         because an inactive source the reader cannot act on is worse than one that is visibly
                         switched off. Rendered by soulseek.js from the same availability value the API admits on. -->
                    <div class="soulseek-login-required" id="soulseek-login-required" role="status" hidden>
                        <span class="soulseek-login-required-text">Log in to enable Soulseek.</span>
                        <span class="soulseek-login-required-reason" id="soulseek-login-required-reason"></span>
                        <a class="soulseek-login-required-link" href="/Login">Open Soulseek login</a>
                    </div>
                    <div class="soulseek-search-head">
                        <div class="soulseek-spinner" id="soulseek-spinner" hidden aria-hidden="true"></div>
                        <div class="soulseek-search-what">
                            <h3 id="soulseek-search-title">Search Soulseek</h3>
                            <div class="soulseek-sub" id="soulseek-search-query"></div>
                        </div>
                        <button type="button" class="btn-danger action-btn action-btn-sm" id="soulseek-stop" hidden>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2" /></svg>
                            <span>Stop Search</span>
                        </button>
                    </div>
                    <div class="soulseek-search-stats" id="soulseek-search-stats"></div>
                    <!-- Arrivals over time. The counts come from responseCount on each search_update, so this
                         is presentation of data the panel already receives. -->
                    <div class="soulseek-hist" id="soulseek-hist" hidden>
                        <div class="soulseek-hist-head"><span>Peers answering over time</span><span id="soulseek-hist-phase"></span></div>
                        <div class="soulseek-hist-chart">
                            <div class="soulseek-hist-scale" aria-hidden="true"><span>20</span><span>10</span><span>0</span></div>
                            <div class="soulseek-hist-scroll" tabindex="0" role="region" aria-label="Peer response timeline">
                                <div class="soulseek-hist-plot">
                                    <div class="soulseek-hist-bars" id="soulseek-hist-bars"></div>
                                    <div class="soulseek-hist-cursor" id="soulseek-hist-cursor" aria-hidden="true"></div>
                                </div>
                                <div class="soulseek-hist-axis" id="soulseek-hist-axis" aria-hidden="true"></div>
                            </div>
                        </div>
                        <p class="soulseek-hist-note">New responses each second · Fixed scale: 0–20. Higher counts are labelled. Completed bars keep their position and height.</p>
                    </div>
                </section>

                <section class="soulseek-panel">
                    <!-- Quality groups. These are the Soulseek qualities enabled in Download, in the order the
                         download ladder walks them, sent by the server from DownloadSourceOrder. -->
                    <div class="soulseek-results-head"><h3>Search results</h3><span class="soulseek-results-badge" id="soulseek-results-badge" role="status">Ready</span></div>
                    <div class="soulseek-status" id="soulseek-search-status" role="status"></div>
                    <div class="soulseek-results-toolbar" id="soulseek-results-toolbar" aria-label="Soulseek result controls" hidden>
