        gap: 8px;
    }
}

@@media (max-width: 768px) {
    .results-grid {
        grid-template-columns: repeat(auto-fill, minmax(min(140px, 45vw), 1fr));
        justify-content: stretch;
        gap: 10px;
    }

    .results-grid.artist-video-style {
        grid-template-columns: repeat(auto-fill, minmax(min(180px, 47vw), 1fr));
        gap: 12px;
    }
    
