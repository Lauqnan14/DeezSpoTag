                                    <div class="checkbox-group" id="synthesizeTtmlFromLrcGroup">
                                        <input type="checkbox" id="synthesizeTtmlFromLrc" checked />
                                        <label for="synthesizeTtmlFromLrc">
                                            Synthesize word-synced TTML
                                            <span class="autotag-tooltip-icon ms-1" title="Enabled by default. When a provider supplies word-timed .lrc and no word-timed .ttml, write a word-synchronized .ttml sidecar." aria-label="Enabled by default. When a provider supplies word-timed .lrc and no word-timed .ttml, write a word-synchronized .ttml sidecar.">
                                                <i class="fas fa-question-circle"></i>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="checkbox-group" id="synthesizeLrcFromTtmlGroup" style="display: none;">
                                        <input type="checkbox" id="synthesizeLrcFromTtml" />
                                        <label for="synthesizeLrcFromTtml">
                                            Synthesize LRC from TTML
                                            <span class="autotag-tooltip-icon ms-1" title="Disabled by default. Uses line-synchronized TTML when available, or word-synchronized TTML when necessary, to create a standard .lrc file." aria-label="Disabled by default. Uses line-synchronized TTML when available, or word-synchronized TTML when necessary, to create a standard .lrc file.">
                                                <i class="fas fa-question-circle"></i>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <input type="hidden" id="lrcFormat" value="lrc,ttml" />
                                <div class="form-group mt-3" id="lrcTimingPreferenceGroup">
                                    <label>
                                        Synchronized .lrc timing
                                        <span class="autotag-tooltip-icon ms-1" title="Chooses what timing is written into the .lrc sidecar for downloads, manual enrichment, and enhancement. Enhanced lyrics only write when the provider supplies word timing." aria-label="Chooses what timing is written into the .lrc sidecar for downloads, manual enrichment, and enhancement. Enhanced lyrics only write when the provider supplies word timing.">
                                            <i class="fas fa-question-circle"></i>
                                        </span>
                                    </label>
                                    <div class="lyrics-timing-card-grid" id="lrcTimingPreferenceOptions">
                                        <div class="checkbox-group">
                                            <input type="radio" name="lrcTimingPreferenceRadio" id="lrcTiming-prefer-enhanced" value="prefer-enhanced" checked />
                                            <label for="lrcTiming-prefer-enhanced">Prefer word-enhanced, else line</label>
                                        </div>
                                        <div class="checkbox-group">
                                            <input type="radio" name="lrcTimingPreferenceRadio" id="lrcTiming-word-enhanced" value="word-enhanced" />
                                            <label for="lrcTiming-word-enhanced">Word-enhanced .lrc only</label>
                                        </div>
                                        <div class="checkbox-group">
                                            <input type="radio" name="lrcTimingPreferenceRadio" id="lrcTiming-line" value="line" />
                                            <label for="lrcTiming-line">Line-timed .lrc</label>
                                        </div>
                                    </div>
                                    <input type="hidden" id="lrcTimingPreference" value="prefer-enhanced" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ID3 & Format Settings -->
            <div class="card bg-darker border-secondary mb-4 autotag-quality-background">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-file-audio me-2"></i>ID3 & Format Settings
                    </h5>
                </div>
                <div class="card-body autotag-card-body">
                    <div class="download-section">
                        <div class="download-section-title">Version</div>
                        <div class="download-grid download-grid-3 technical-checkbox-grid">
                            <div class="checkbox-group">
                                <input type="checkbox" id="autotag-id3v24" />
                                <label for="autotag-id3v24">Use ID3v2.4 (vs ID3v2.3)</label>
                            </div>
                            <div class="checkbox-group">
                                <input type="checkbox" id="autotag-edition-conflict-review" />
                                <label for="autotag-edition-conflict-review">
                                    Flag album edition conflicts for review
                                    <span class="autotag-tooltip-icon ms-1"
                                          title="When a provider matches a different edition of the same album (standard vs deluxe, remaster), keep the downloaded edition and flag the file for review instead of rewriting it."
                                          aria-label="When a provider matches a different edition of the same album (standard vs deluxe, remaster), keep the downloaded edition and flag the file for review instead of rewriting it.">
                                        <i class="fas fa-question-circle"></i>
                                    </span>
                                </label>
                            </div>
                            <div class="checkbox-group">
                                <input type="checkbox" id="saveID3v1" checked />
                                <label for="saveID3v1">Save ID3v1</label>
                            </div>
                            <div class="checkbox-group">
                                <input type="checkbox" id="useNullSeparator" />
                                <label for="useNullSeparator">Use Null Separator</label>
                            </div>
                        </div>
                    </div>

                    <div class="download-section">
                        <div class="download-section-title">Separators</div>
                        <div class="download-grid download-grid-3">
                            <div class="form-group">
                                <label for="autotag-sep-id3">ID3 Separator</label>
                                <input type="text" id="autotag-sep-id3" value=", " placeholder="ID3 separator" />
                            </div>
                            <div class="form-group">
                                <label for="autotag-sep-vorbis">Vorbis Separator</label>
                                <input type="text" id="autotag-sep-vorbis" placeholder="(optional)" />
                            </div>
                            <div class="form-group">
                                <label for="autotag-sep-mp4">MP4 Separator</label>
                                <input type="text" id="autotag-sep-mp4" value=", " placeholder="MP4 separator" />
                            </div>
                        </div>
                    </div>

                    <div class="download-section">
                        <div class="download-section-title">Language</div>
                        <div class="form-group">
                            <label for="autotag-id3-lang">ID3 COMM language (3 letters)</label>
                            <input type="text" id="autotag-id3-lang" placeholder="eng" maxlength="3" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Text Processing -->
            <div class="card bg-darker border-secondary mb-4 autotag-quality-background">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-font me-2"></i>Text Processing
                    </h5>
                </div>
                <div class="card-body autotag-card-body">
                    <div class="download-section">
                        <div class="download-section-title">Casing</div>
                        <div class="download-grid download-grid-2">
                            <div class="form-group">
                                <label for="titleCasing">Title Casing</label>
                                <select id="titleCasing">
                                    <option value="nothing">Nothing</option>
                                    <option value="capitalize">Capitalize</option>
                                    <option value="uppercase">UPPERCASE</option>
                                    <option value="lowercase">lowercase</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="artistCasing">Artist Casing</label>
                                <select id="artistCasing">
                                    <option value="nothing">Nothing</option>
                                    <option value="capitalize">Capitalize</option>
                                    <option value="uppercase">UPPERCASE</option>
                                    <option value="lowercase">lowercase</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="download-section">
                        <div class="download-section-title">Formatting</div>
                        <div class="download-grid download-grid-2">
                            <div class="form-group">
                                <label for="dateFormat">Date Format</label>
                                <select id="dateFormat">
                                    <option value="Y-M-D">Year-Month-Day</option>
                                    <option value="D-M-Y">Day-Month-Year</option>
                                    <option value="M-D-Y">Month-Day-Year</option>
                                    <option value="Y">Year only</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="featuredToTitle">Featured To Title</label>
                                <select id="featuredToTitle">
                                    <option value="0">No</option>
                                    <option value="1">Copy to title</option>
                                    <option value="2">Move to title</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="download-section">
                        <div class="download-section-title">Options</div>
                        <div class="download-grid download-grid-3 technical-checkbox-grid">
                            <div class="checkbox-group">
                                <input type="checkbox" id="removeAlbumVersion" />
                                <label for="removeAlbumVersion">Remove Album Version</label>
                            </div>
                            <div class="checkbox-group">
                                <input type="checkbox" id="removeFeaturedFromAlbumTitle" />
                                <label for="removeFeaturedFromAlbumTitle">
                                    Remove featured artists from album title
                                    <span class="autotag-tooltip-icon ms-1"
                                          title="Enabled: drops featured artists from the album name, so &quot;Rise Up (feat. Falz)&quot; is tagged and filed as &quot;Rise Up&quot;. Useful for singles, where the album name repeats the track name. The album folder is renamed to match, because the default album folder template is %album%. Independent of Featured To Title, so it works with any of its options."
                                          aria-label="Enabled: drops featured artists from the album name, so the album is tagged and filed without the featured artist. The album folder is renamed to match. Independent of Featured To Title.">
                                        <i class="fas fa-question-circle"></i>
                                    </span>
                                </label>
                            </div>
                            <div class="checkbox-group">
                                <input type="checkbox" id="autotag-short-title" />
                                <label for="autotag-short-title">Use short title (Beatport/Traxsource)</label>
                            </div>
                            <div class="checkbox-group">
                                <input type="checkbox" id="autotag-capitalize-genres" />
                                <label for="autotag-capitalize-genres">Capitalize genres</label>
                            </div>
                        </div>
                    </div>

                    <div class="download-section">
                        <div class="download-section-title">Cleanup</div>
                        <div class="form-group">
                            <label for="autotag-title-regex">Title cleanup regex</label>
                            <input type="text" id="autotag-title-regex" placeholder="e.g. \s*\(.*?\)\s*$" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Style/Genre Handling -->
            <div class="card bg-darker border-secondary mb-4 autotag-quality-background">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-music me-2"></i>Style/Genre Handling
                    </h5>
                </div>
                <div class="card-body autotag-card-body">
                    <div class="download-section">
                        <div class="download-section-title">Handling</div>
                        <div class="form-group">
                            <label for="autotag-styles-options">Style/Genre handling</label>
                            <select id="autotag-styles-options">
                                <option value="default">Default (all)</option>
                                <option value="onlyGenres">Only genres</option>
                                <option value="onlyStyles">Only styles</option>
                                <option value="mergeToGenres">Merge to Genre</option>
                                <option value="mergeToStyles">Merge to Style</option>
                                <option value="stylesToGenre">Write Style to Genre</option>
                                <option value="genresToStyle">Write Genre to Style</option>
                                <option value="customTag">Write Style to Custom tag</option>
                            </select>
                        </div>

                        <div class="form-group" id="autotag-styles-custom-group" style="display: none;">
                            <div class="form-label">Custom tag (style)</div>
                            <div class="download-grid download-grid-3">
                                <input type="text" id="autotag-styles-id3" placeholder="ID3" />
                                <input type="text" id="autotag-styles-vorbis" placeholder="Vorbis" />
                                <input type="text" id="autotag-styles-mp4" placeholder="MP4" />
                            </div>
                        </div>
                    </div>

                    <div class="download-section">
                        <div class="download-section-title">Options</div>
                        <div class="download-grid download-grid-2 technical-checkbox-grid">
                            <div class="checkbox-group">
                                <input type="checkbox" id="autotag-merge-genres" />
                                <label
                                    for="autotag-merge-genres"
                                    title="Merge genres/styles applies only when Genre overwrite is enabled in Tag Overwrite Settings.">
                                    Merge genres/styles instead of overwrite
                                </label>
                            </div>
                            <div class="checkbox-group">
                                <input type="checkbox" id="autotag-camelot" />
                                <label for="autotag-camelot">Use Camelot key notation</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tag Overwrite Settings -->
            <div class="card bg-darker border-secondary mb-4 autotag-quality-background">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-edit me-2"></i>Tag Overwrite Settings
                    </h5>
                </div>
                <div class="card-body autotag-card-body">
                    <div class="download-section">
                        <div class="download-section-title">Overwrite</div>
                        <div class="checkbox-group">
                            <input type="checkbox" id="autotag-overwrite" />
                            <label for="autotag-overwrite">Overwrite existing tags</label>
                        </div>
                    </div>
                    <div class="download-section">
                        <div class="download-section-title">Tags</div>
                        <div class="form-group" id="autotag-overwrite-tags-group">
                            <div class="form-label">Overwrite only these tags</div>
                            <div class="tags-grid gap-fill-tags-grid" id="autotag-overwrite-tags"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
(function ensureAutoTagMaterialIconsReveal() {
    const selector = '.autotag-page.material-icons-pending';
    const invokeReveal = () => {
        if (typeof window.DeezSpoTagRevealMaterialIconsWhenReady === 'function') {
            window.DeezSpoTagRevealMaterialIconsWhenReady(selector);
            return true;
        }
        return false;
    };

    if (invokeReveal()) {
        return;
    }

    window.addEventListener('load', () => {
        if (!invokeReveal()) {
            document.querySelector(selector)?.classList.remove('material-icons-pending');
        }
    }, { once: true });
})();

// Pipeline tab activation helper
function activatePipelineTab(tabId) {
    const tab = document.getElementById(tabId);
    if (tab) {
        const bsTab = new bootstrap.Tab(tab);
        bsTab.show();
    }
}

// Update pipeline visual when tabs change
document.addEventListener('DOMContentLoaded', function() {
    // Enrichment timing radio buttons
    document.querySelectorAll('input[name="enrichmentTiming"]').forEach(radio => {
        radio.addEventListener('change', function() {
            document.getElementById('enrichmentScheduleGroup').style.display =
                this.value === 'scheduled' ? 'block' : 'none';
        });
    });

    // Download source toggles

});
</script>

