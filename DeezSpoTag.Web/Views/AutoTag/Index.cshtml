@{
    ViewData["Title"] = "AutoTag Flow";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lyricsProviders = DeezSpoTag.Services.Download.Utils.LyricsProviderRegistry.All;
    var lyricsProviderJson = System.Text.Json.JsonSerializer.Serialize(
        lyricsProviders.Select(provider => new
        {
            id = provider.Id,
            label = provider.DisplayName,
            aliases = provider.Aliases
        }));
    var defaultLyricsProviderOrder = string.Join(
        ",",
        DeezSpoTag.Services.Download.Utils.LyricsProviderRegistry.DefaultOrder);
}

@section Styles {
<link rel="stylesheet" href="@AssetUrl.Versioned(ViewContext, Url, "~/css/autotag.css")" />
<style>
/* Stage Header */
.stage-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-secondary);
}

.stage-number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--primary-color);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
}

.stage-title {
    flex: 1;
}

.stage-title h5 {
    margin: 0;
    font-size: 16px;
}

.stage-title p {
    margin: 4px 0 0 0;
    font-size: 12px;
    color: var(--text-muted);
}

/* Maintenance Stats */
.maintenance-stats {
    display: flex;
    gap: 16px;
    padding: 16px;
    background: var(--bg-tertiary);
    border-radius: 8px;
    margin-top: 20px;
}

.maintenance-stat {
    flex: 1;
    text-align: center;
}

.maintenance-stat-label {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 4px;
}

.maintenance-stat-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
}

/* Responsive */
/* Enrichment Source Items */
.enrichment-source-item {
    padding: 16px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-secondary);
    border-radius: 10px;
}

.enrichment-source-item .source-header {
    display: flex;
    align-items: center;
}

.enrichment-source-item .source-header i {
    font-size: 18px;
}

.enrichment-source-item .source-options {
    padding: 16px;
    background: var(--bg-secondary);
    border-radius: 8px;
    border: 1px solid var(--border-secondary);
}

.manual-tagging-run-actions {
    width: 100%;
    justify-content: flex-end;
}

.enrichment-source-item .form-row-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px 16px;
}

/* Prevent hard-refresh flash of hidden tabs before shared CSS loads */
#autotagTabsContent > .tab-pane {
    display: none;
}

#autotagTabsContent > .tab-pane.active {
    display: block;
}

/* Keep icon glyph names hidden until Material Icons font is ready */
.autotag-page.material-icons-pending .material-icons {
    visibility: hidden;
}

@@media (max-width: 768px) {
    .enrichment-source-item .form-row-3 {
        grid-template-columns: repeat(2, 1fr);
    }

}
</style>
}

<div class="container-fluid autotag-page material-icons-pending">
    <div class="autotag-sticky-shell" id="autotagStickyShell">
        <div class="autotag-hero">
            <div class="autotag-hero-copy">
                <h1 class="welcome-title mb-2">AutoTag Flow</h1>
                <p class="text-muted mb-0">Configure music tagging flow and folder structure</p>
            </div>
            <div class="autotag-actions autotag-hero-actions">
                <button type="button" class="action-btn action-btn-sm" id="autotag-save">Save Preferences</button>
                <a class="action-btn action-btn-sm" id="autotag-view-status" href="/Activities?tab=autotag-status-content">View Status</a>
                <a class="action-btn action-btn-sm" id="autotag-tag-editor" href="/AutoTag/QuickTag">Tag Editor</a>
                <button type="button" class="action-btn action-btn-sm" id="autotag-reset">Reset</button>
                <button type="button" class="action-btn action-btn-sm" id="autotag-stop">Stop AutoTag</button>
            </div>
        </div>

        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs nav-fill mb-4 ds-mobile-tabs" id="autotagTabs">
            <li class="nav-item">
                <button class="nav-link active" id="autotag-profiles-tab" data-bs-toggle="tab" data-bs-target="#autotag-profiles-panel" type="button" role="tab">
                    <i class="fas fa-layer-group me-2"></i>Profiles
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="autotag-folders-tab" data-bs-toggle="tab" data-bs-target="#autotag-folders-panel" type="button" role="tab">
                    <i class="fas fa-folder-tree me-2"></i>Folders
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="autotag-platforms-tab" data-bs-toggle="tab" data-bs-target="#autotag-platforms-panel" type="button" role="tab">
                    <i class="fas fa-globe me-2"></i>Platforms
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="autotag-stage1-tab" data-bs-toggle="tab" data-bs-target="#autotag-stage1-panel" type="button" role="tab">
                    <i class="fas fa-download me-2"></i>Download
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="autotag-stage2-tab" data-bs-toggle="tab" data-bs-target="#autotag-stage2-panel" type="button" role="tab">
                    <i class="fas fa-magic me-2"></i>Enrichment
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="autotag-stage3-tab" data-bs-toggle="tab" data-bs-target="#autotag-stage3-panel" type="button" role="tab">
                    <i class="fas fa-book me-2"></i>Enhancement
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="autotag-genre-intelligence-tab" data-bs-toggle="tab" data-bs-target="#autotag-genre-intelligence-panel" type="button" role="tab" aria-controls="autotag-genre-intelligence-panel" aria-selected="false">
                    <i class="fas fa-tags me-2"></i>Genre Intelligence
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="autotag-technical-tab" data-bs-toggle="tab" data-bs-target="#autotag-technical-panel" type="button" role="tab">
                    <i class="fas fa-cog me-2"></i>Technical
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content" id="autotagTabsContent">
        <!-- ==================== TAB 1: PROFILES ==================== -->
        <div class="tab-pane fade show active" id="autotag-profiles-panel" role="tabpanel">
            <div class="stage-header">
                <div class="stage-number"><i class="fas fa-layer-group"></i></div>
                <div class="stage-title">
                    <h5>Profiles</h5>
                    <p>Save and load configuration presets for all AutoTag stages</p>
                </div>
            </div>

            <div class="card bg-darker border-secondary mb-4 autotag-quality-background">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-layer-group me-2"></i>Profile Manager
                    </h5>
                </div>
                <div class="card-body autotag-card-body">
                    <div class="download-section">
                        <div class="download-section-title">Profiles</div>
                        <div class="download-grid download-grid-2">
                            <div class="form-group" id="lyricsTypeGroup">
                                <label for="autotag-profile-select">Saved profiles</label>
                                <select id="autotag-profile-select"></select>
                            </div>
                            <div class="form-group">
                                <label for="autotag-profile-name">Profile name</label>
                                <input type="text" id="autotag-profile-name" placeholder="My Tagging Profile" />
                            </div>
                        </div>
                        <span class="helper" id="autotag-profile-summary">No active profile loaded.</span>
                    </div>
                    <div class="download-section">
                        <div class="download-section-title">Actions</div>
                        <div class="autotag-actions">
                            <button type="button" class="action-btn action-btn-sm" id="autotag-profile-load">Load</button>
                            <button type="button" class="action-btn action-btn-sm" id="autotag-profile-save">Save</button>
                            <button type="button" class="action-btn action-btn-sm" id="autotag-profile-copy">Copy</button>
                            <button type="button" class="btn-danger action-btn action-btn-sm" id="autotag-profile-delete">Delete</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ==================== TAB 2: FOLDERS ==================== -->
        <div class="tab-pane fade" id="autotag-folders-panel" role="tabpanel">
            <script>
                window.LibraryFolderQualityOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    DeezSpoTag.Services.Download.QualityCatalog.GetLibraryFolderQualityOptions()
                        .Select(option => new { value = option.Value, label = option.Label })
                        .ToList()));
            </script>

            <div class="stage-header">
                <div class="stage-number"><i class="fas fa-folder-open"></i></div>
                <div class="stage-title">
                    <h5>Folders</h5>
                    <p>Configure library folders and organize file structure for downloads</p>
                </div>
            </div>

            <!-- Library Folders -->
            <div class="card bg-darker border-secondary mb-4 autotag-quality-background">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-folder-open me-2"></i>Library Folders
                    </h5>
                    <button type="button" class="action-btn action-btn-sm" id="addFolderBtn">
                        <i class="fas fa-plus me-1"></i>Add Folder
                    </button>
                </div>
                <div class="card-body autotag-card-body">
                    <div class="download-section">
                        <div class="download-section-title">Folders</div>
                        <!-- Folder List -->
                        <div class="folder-table-scroll">
                            <div class="folder-table-header">
                                <span>Folder</span>
                                <span>Path</span>
                                <span>Quality</span>
                                <span>Profile</span>
                                <span>Enhancement</span>
                                <span>Status</span>
                                <span>Actions</span>
                                <span class="folder-soulseek-heading" title="Soulseek">
                                    <svg class="folder-soulseek-logo" viewBox="0 0 24 24" fill="currentColor" focusable="false" aria-hidden="true"><path d="M9.21 0.32 9.16 0.48 9.32 0.81 9.74 1.35 9.84 1.67 9.79 1.72 9.58 1.72 9.00 1.45 8.79 1.51 8.79 1.72 9.00 2.10 9.16 2.26 9.16 2.37 9.05 2.48 8.63 2.48 8.58 2.53 8.58 2.69 8.68 2.85 8.63 3.44 8.53 3.61 8.37 3.61 8.26 3.71 8.53 4.20 8.32 4.41 8.26 4.57 8.32 4.63 8.32 5.22 8.37 5.38 8.21 5.65 8.21 5.81 8.84 6.24 9.21 6.62 9.58 7.21 9.63 7.59 9.58 7.64 9.53 8.39 9.74 8.93 9.95 9.26 9.95 9.36 9.84 9.47 9.47 9.47 9.42 9.42 9.00 9.42 8.95 9.36 8.58 9.36 8.53 9.31 7.84 9.26 7.79 9.20 7.58 9.20 7.53 9.15 6.74 8.99 6.68 8.93 6.47 8.93 6.42 8.88 6.05 8.83 5.68 8.66 5.58 8.56 5.21 8.39 5.11 8.29 4.74 8.13 4.63 8.02 3.84 7.59 2.21 5.92 2.00 5.60 1.58 5.17 1.47 5.17 1.42 5.27 1.68 6.08 1.58 6.19 1.16 6.19 1.05 6.35 1.05 6.51 1.11 6.57 1.11 7.32 0.95 7.48 0.89 7.96 0.79 8.13 0.79 8.29 0.89 8.56 0.89 8.88 0.74 9.20 0.74 9.63 0.95 10.01 0.95 10.17 0.74 10.44 0.74 10.60 0.84 10.82 1.63 11.89 2.89 13.40 3.11 13.72 3.74 14.37 5.37 15.71 5.79 15.93 5.89 15.93 6.05 16.04 6.16 16.04 6.32 16.14 6.42 16.14 6.58 16.25 6.84 16.30 7.16 16.47 7.32 16.47 7.37 16.52 7.95 16.52 8.00 16.57 8.63 16.57 8.79 16.63 8.89 16.74 8.89 16.90 8.58 17.17 6.63 18.24 4.68 19.48 4.37 19.80 4.37 19.96 4.47 20.02 4.53 19.96 4.89 19.91 5.37 19.70 5.53 19.70 5.58 19.75 5.32 20.02 5.16 20.07 4.26 20.66 4.00 20.99 4.00 21.20 4.11 21.26 4.47 21.20 5.05 20.99 5.21 21.04 5.21 21.15 5.11 21.26 4.26 21.79 4.00 22.06 4.00 22.17 4.26 22.17 4.84 21.96 5.11 22.01 5.26 22.17 5.26 22.28 5.05 22.60 5.05 22.82 5.32 22.82 5.84 22.60 6.05 22.60 6.21 22.71 6.32 23.09 6.37 23.14 6.58 23.14 7.21 22.82 7.58 22.76 7.74 22.92 7.84 23.19 8.05 23.19 8.21 23.09 9.32 22.17 11.95 19.59 12.00 19.59 14.63 16.90 15.05 16.57 15.47 16.36 15.74 16.14 15.89 16.09 16.95 15.39 17.42 14.96 19.37 13.45 21.58 11.52 22.11 10.98 22.26 10.71 22.37 10.22 22.95 9.47 22.89 8.93 23.32 8.39 23.42 8.18 23.37 8.