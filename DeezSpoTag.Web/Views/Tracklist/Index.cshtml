        deezerId: track.id || '',
        deezer_id: track.id || '',
        recommendationStationId: payload.station?.id || tracklistId || '',
        recommendationLibraryId: tracklistLibraryId || '',
        recommendationStatus: payload.status || payload.station?.status || '',
        title: track.title || 'Unknown',
        artist: {
            id: track.artist?.id || '',
            name: track.artist?.name || 'Unknown'
        },
        album: {
