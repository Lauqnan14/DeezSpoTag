function normalizeCoverUrl(value) {
    if (typeof value !== 'string') {
        return '';
    }

    const trimmed = value.trim();
    if (!trimmed) {
        return '';
    }

    if (/^https?:\/\//i.test(trimmed) || /^data:image\//i.test(trimmed) || trimmed.startsWith('/')) {
        return trimmed;
    }

    if (trimmed.startsWith('//')) {
        return `https:${trimmed}`;
    }

    return '';
}

function mapLibraryStyleTracks(tracks) {
    return (tracks || []).map((track, index) => ({
        id: track.trackId || '',
        title: track.title || 'Unknown',
        artist: { name: track.artistName || 'Unknown', id: '' },
        album: { title: track.albumTitle || 'Unknown', cover_medium: normalizeCoverUrl(track.coverPath || '') },
        duration: track.durationMs ? Math.round(track.durationMs / 1000) : 0,
        durationMs: track.durationMs || 0,
        preview: '',
        track_position: index + 1
    }));
}

async function loadRecommendationsTracklist() {
    if (!tracklistLibraryId) {
        throw new Error('Library is required for recommendations.');
    }

    const params = new URLSearchParams({
        libraryId: tracklistLibraryId,
        limit: '50'
    });
    if (tracklistId) {
        params.set('stationId', tracklistId);
    }
    if (recommendationType) {
        params.set('type', recommendationType);
    }
    if (recommendationValue) {
        params.set('value', recommendationValue);
    }

    const response = await fetch(`/api/library/recommendations?${params.toString()}`);
    if (!response.ok) {
        throw new Error(`Failed to load recommendations (HTTP ${response.status})`);
    }

    const payload = await response.json();
    if (!payload?.station || !Array.isArray(payload.tracks)) {
        throw new Error('Recommendations unavailable.');
    }

    const mapped = mapRecommendationsTracklist(payload);
    await loadIgnoredTracks();
    const status = String(payload.status || payload.station?.status || '').trim().toLowerCase();
    const isGenerating = status === 'generating';
    renderTracklist(mapped, { allowEmptyTracks: isGenerating });
    if (isGenerating) {
        const message = payload.message || payload.station?.message || 'Recommendation generation is running in the background.';
        setTracksEmptyMessage(message);
        scheduleRecommendationsReload();
    } else {
        globalThis.recommendationReloadAttempt = 0;
    }
}

function scheduleRecommendationsReload() {
    const currentAttempt = Number.parseInt(String(globalThis.recommendationReloadAttempt || '0'), 10) || 0;
    if (currentAttempt >= 24) {
        return;
    }

    globalThis.recommendationReloadAttempt = currentAttempt + 1;
    setTimeout(() => {
        if (tracklistSource === 'recommendations') {
            void loadRecommendationsTracklist();
        }
    }, 5000);
}

function mapRecommendationsTracklist(payload) {
    const tracks = (payload.tracks || []).map((track, index) => ({
