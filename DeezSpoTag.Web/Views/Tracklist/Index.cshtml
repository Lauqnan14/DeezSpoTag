            ${renderTracksTable(tracks, isPlaylistLike, isLocalSource, fallbackAlbumTitle, { allowEmptyTracks })}
            <div id="spotify-recommendations" class="spotify-recommendations is-hidden"></div>
        </div>
    `;

    bindTracklistHeaderActions();
    bindSoundtrackTracklistMatchButton();
    if (!isLocalSource) {
        void updateMonitorButtonState();
    }
    applyIgnoredTrackState();
    bindIgnoreButtons();
    bindRecommendationRejectButtons();
    scheduleAvailabilityChecks(tracks, isLocalSource);

    const externalSource = (tracklistSource || '').toLowerCase();
    if (externalSource && externalSource !== 'deezer' && !isRecommendationTracklistContext()) {
        scheduleExternalTracklistMatches(tracks, externalSource);
    }

    preloadDeezerPlaybackContextsForVisibleRows();
    void loadTracklistRecommendations();
}

async function loadTracklistRecommendations() {
    const container = document.getElementById('spotify-recommendations');
    if (!container) {
        return;
    }

    const source = (tracklistSource || requestSource || '').toLowerCase();
    if (source === 'spotify') {
        await loadSpotifyRecommendations(container);
        return;
    }

    if (source === 'boomplay') {
        await loadBoomplayRecommendations(container);
        return;
    }

    container.classList.add('is-hidden');
    container.innerHTML = '';
}

async function loadSpotifyRecommendations(container) {
    if (tracklistType !== 'playlist' && tracklistType !== 'album') {
        container.classList.add('is-hidden');
        container.innerHTML = '';
        return;
    }
    if (tracklistType === 'playlist' && isSpotifyHomeTrendingTracklistView()) {
        container.classList.add('is-hidden');
        container.innerHTML = '';
        return;
    }

    const spotifyUrl = buildSpotifyTracklistUrl();
    if (!spotifyUrl) {
        container.classList.add('is-hidden');
        container.innerHTML = '';
        return;
    }

    if (spotifyRecommendationState?.url === spotifyUrl && spotifyRecommendationState?.sections?.length) {
        renderSpotifyRecommendationSections(spotifyRecommendationState.sections);
        return;
    }

    spotifyRecommendationState = { url: spotifyUrl, loaded: false };

    try {
        const response = await fetch(`/api/spotify/tracklist/recommendations?url=${encodeURIComponent(spotifyUrl)}&limit=12`);
        if (!response.ok) {
            throw new Error(`Recommendations failed: ${response.status}`);
        }
        const payload = await response.json();
        if (!payload?.available || !Array.isArray(payload.sections) || payload.sections.length === 0) {
            container.classList.add('is-hidden');
            container.innerHTML = '';
            spotifyRecommendationState.loaded = true;
            return;
        }
        spotifyRecommendationState.sections = payload.sections;
        renderSpotifyRecommendationSections(payload.sections);
        spotifyRecommendationState.loaded = true;
    } catch (error) {
        console.warn('Spotify recommendations unavailable:', error);
        container.classList.add('is-hidden');
        container.innerHTML = '';
    }
}

async function loadBoomplayRecommendations(container) {
    if (tracklistType !== 'playlist' && tracklistType !== 'trending') {
        container.classList.add('is-hidden');
        container.innerHTML = '';
        return;
    }

    const recommendationType = tracklistType === 'trending' ? 'trending' : 'playlist';
    const cacheKey = `${recommendationType}:${tracklistId || ''}`;
    if (boomplayRecommendationState?.key === cacheKey && boomplayRecommendationState?.sections?.length) {
        renderSpotifyRecommendationSections(boomplayRecommendationState.sections);
        return;
    }

    boomplayRecommendationState = { key: cacheKey, loaded: false };

    try {
        const qs = new URLSearchParams();
        qs.set('type', recommendationType);
        qs.set('id', tracklistId || '');
        qs.set('limit', '12');

        const response = await fetch(`/api/boomplay/playlist/recommendations?${qs.toString()}`);
        if (!response.ok) {
            throw new Error(`Recommendations failed: ${response.status}`);
        }

        const payload = await response.json();
        if (!payload?.available || !Array.isArray(payload.sections) || payload.sections.length === 0) {
            container.classList.add('is-hidden');
            container.innerHTML = '';
            boomplayRecommendationState.loaded = true;
            return;
        }

        boomplayRecommendationState.sections = payload.sections;
        renderSpotifyRecommendationSections(payload.sections);
        boomplayRecommendationState.loaded = true;
    } catch (error) {
        console.warn('Boomplay recommendations unavailable:', error);
        container.classList.add('is-hidden');
        container.innerHTML = '';
    }
}

function buildSpotifyTracklistUrl() {
    if (!tracklistId || !tracklistType) {
        return '';
    }
    if (tracklistId.startsWith('spotify:')) {
        return tracklistId;
    }
    if (tracklistId.includes('open.spotify.com/')) {
        return tracklistId;
    }
    return `https://open.spotify.com/${tracklistType}/${tracklistId}`;
}

function renderSpotifyRecommendationSections(sections) {
    const container = document.getElementById('spotify-recommendations');
    if (!container) {
        return;
    }

    const html = sections.map(section => {
        const title = escapeHtml(section.title || 'Recommended');
        const items = Array.isArray(section.items) ? section.items : [];
        const cards = items.map(renderSpotifyRecommendationItem).join('');
        return `
            <div class="home-section">
                <div class="home-section-title">${title}</div>
                <div class="spotify-home-row">${cards}</div>
            </div>
        `;
    }).join('');

    if (!html.trim()) {
        container.classList.add('is-hidden');
        container.innerHTML = '';
        return;
    }

    container.innerHTML = html;
    container.classList.remove('is-hidden');
}

function renderSpotifyRecommendationItem(item) {
    if (!item) {
        return '';
    }
    const source = (item.source || 'spotify').toString().toLowerCase();
    const sourceType = (item.type || 'playlist').toString().toLowerCase();
    const sourceId = (item.id || '').toString();
    const sourceUrl = (item.url || item.sourceUrl || '').toString();
    const title = escapeHtml(item.name || '');
    const rawSubtitle = (item.artists || item.description || '').toString().trim();
    const subtitleIsGeneric = ['spotify', 'playlist'].includes(rawSubtitle.toLowerCase());
    const subtitle = subtitleIsGeneric ? '' : escapeHtml(rawSubtitle);
    const cover = item.coverUrl || item.imageUrl || item.image_url || '';
    const type = escapeHtml(item.type || '');
    const hideGenericPlaylistMeta = (source === 'spotify' || source === 'boomplay') && sourceType === 'playlist';
    const meta = hideGenericPlaylistMeta ? '' : (type ? `${type}` : '');
    const artStyle = cover ? `style="background-image: url('${cover}');"` : '';
    return `
        <div class="spotify-card"
             data-source="${escapeHtml(source)}"
             data-source-type="${escapeHtml(sourceType)}"
             data-source-id="${escapeHtml(sourceId)}"
             data-source-url="${escapeHtml(sourceUrl)}"
             data-spotify-uri="${escapeHtml(item.uri || '')}">
            <div class="spotify-card-art" ${artStyle}>${cover ? '' : '🎵'}</div>
            <div class="spotify-card-title">${title}</div>
            ${subtitle ? `<div class="spotify-card-subtitle">${subtitle}</div>` : ''}
            ${meta ? `<div class="spotify-card-meta"><span>${meta}</span></div>` : ''}
        </div>
    `;
}

function parseSpotifyUri(uri) {
    if (!uri) return null;
    const trimmed = uri.trim();
    if (trimmed.startsWith('spotify:')) {
        const parts = trimmed.split(':').filter(Boolean);
        if (parts.length >= 3) {
            return { type: parts[1], id: parts[2] };
        }
    }
    const match = trimmed.match(/open\.spotify\.com\/(album|playlist|track|artist|show|episode)\/([A-Za-z0-9]+)/i);
    if (match) {
        return { type: match[1], id: match[2] };
    }
    return null;
}

function showTracklistNotice(message) {
    const notice = document.getElementById('tracklist-notice');
    if (!notice) {
        return;
    }
    if (!message) {
        notice.classList.add('is-hidden');
        notice.textContent = '';
        return;
    }
    notice.textContent = message;
    notice.classList.remove('is-hidden');
}

function normalizeSpotifyMatchNoticeState(state) {
    if (!state || typeof state !== 'object') {
        return state;
    }

    const normalized = {
        pending: typeof state.pending === 'number' ? Math.max(0, state.pending) : state.pending,
        matched: typeof state.matched === 'number' ? Math.max(0, state.matched) : state.matched,
        failed: typeof state.failed === 'number' ? Math.max(0, state.failed) : state.failed,
        rechecking: typeof state.rechecking === 'number' ? Math.max(0, state.rechecking) : state.rechecking
    };

    const total = Number(spotifyLazyState?.total || currentTracklistMeta?.nb_tracks || 0);
    if (!Number.isFinite(total) || total <= 0) {
        return normalized;
    }

    if (typeof normalized.matched !== 'number' || typeof normalized.failed !== 'number') {
        return normalized;
    }

    const cappedFailed = Math.min(normalized.failed, total);
    const cappedMatched = Math.min(normalized.matched, Math.max(0, total - cappedFailed));
    const remainingFromTotals = Math.max(0, total - cappedMatched - cappedFailed);
    const currentPending = typeof normalized.pending === 'number' ? normalized.pending : null;

    normalized.failed = cappedFailed;
    normalized.matched = cappedMatched;
    normalized.pending = currentPending === null
        ? remainingFromTotals
        : Math.min(currentPending, remainingFromTotals);
    normalized.rechecking = typeof normalized.rechecking === 'number'
        ? Math.min(normalized.rechecking, normalized.pending)
        : normalized.rechecking;

    return normalized;
}

function updateSpotifyNotice() {
    const parts = [];
    let hasActiveWork = false;
    let hasCompletionOnlyState = false;
    if (spotifyLazyState && (spotifyLazyState.isLoading || spotifyLazyState.hasMore)) {
        hasActiveWork = true;
        const total = spotifyLazyState.total || 0;
        const loaded = spotifyLazyState.loaded || 0;
        const progress = total > 0
            ? `${loaded.toLocaleString()} / ${total.toLocaleString()}`
            : `${loaded.toLocaleString()}`;
        parts.push(`Loading tracks… ${progress}`);
    }

    if (spotifyMatchState) {
        hasActiveWork = true;
        const normalizedMatchState = normalizeSpotifyMatchNoticeState(spotifyMatchState);
        const remaining = typeof normalizedMatchState?.pending === 'number' ? normalizedMatchState.pending : null;
        const matched = typeof normalizedMatchState?.matched === 'number' ? normalizedMatchState.matched : null;
        const failed = typeof normalizedMatchState?.failed === 'number' ? normalizedMatchState.failed : null;
        const rechecking = typeof normalizedMatchState?.rechecking === 'number' ? normalizedMatchState.rechecking : null;
        if (remaining !== null) {
            if (matched !== null && failed !== null) {
                const recheckPart = rechecking !== null && rechecking > 0
                    ? `, ${rechecking} rechecking`
                    : '';
                parts.push(`Matching Deezer tracks… ${remaining} remaining (${matched} matched, ${failed} failed${recheckPart}).`);
            } else {
                parts.push(`Matching Deezer tracks… ${remaining} remaining.`);
            }
        }
    } else if (spotifyMatchCompletion) {
        hasCompletionOnlyState = true;
        parts.push(spotifyMatchCompletion);
    }

    if (externalMatchState) {
        const remaining = externalMatchState.pending || 0;
        const matched = externalMatchState.matched || 0;
        const failed = externalMatchState.failed || 0;
        const source = externalMatchState.source || 'External';
        if (remaining > 0) {
            hasActiveWork = true;
            parts.push(`Matching Deezer tracks… ${remaining} remaining (${matched} matched, ${failed} failed).`);
        } else if (externalMatchState.done) {
            hasCompletionOnlyState = true;
            parts.push(`Matching complete: ${matched} matched, ${failed} failed.`);
        }
    }

    if (parts.length === 0) {
        clearTracklistNoticeAutoHide();
        showTracklistNotice('');
        return;
    }

    const message = parts.join(' • ');
    showTracklistNotice(message);
    if (hasActiveWork || !hasCompletionOnlyState) {
        clearTracklistNoticeAutoHide();
        return;
    }

    scheduleTracklistNoticeAutoHide(message);
}

function setTracksEmptyMessage(message) {
    const tableBody = document.getElementById('tracks-table-body');
    if (!tableBody) {
        return;
    }
    const isPlaylistLike = tracklistLayoutIsPlaylistLike;
    const monitorSource = (requestSource || tracklistSource || 'deezer').toLowerCase();
    const isLocalSource = monitorSource === 'plex' || monitorSource === 'mix' || monitorSource === 'radio';
    const columnCount = getTracklistColumnCount(isPlaylistLike, isLocalSource);
    tableBody.innerHTML = `<tr class="tracks-empty"><td colspan="${columnCount}">${escapeHtml(message)}</td></tr>`;
}

function appendExternalTrackRows(tracks, options = {}) {
    if (!tracks || tracks.length === 0) {
        return [];
    }
    const tableBody = document.getElementById('tracks-table-body');
    if (!tableBody) {
        return [];
    }
    tableBody.querySelectorAll('.tracks-loading, .tracks-empty').forEach(row => row.remove());

    const monitorSource = (requestSource || tracklistSource || 'deezer').toLowerCase();
    const isLocalSource = monitorSource === 'plex' || monitorSource === 'mix' || monitorSource === 'radio';
    const isPlaylistLike = tracklistLayoutIsPlaylistLike;
    const base = Number.isFinite(options.baseOffset) ? options.baseOffset : 0;

    const existingTrackIndices = new Set(
        Array.from(tableBody.querySelectorAll('tr[data-track-index]'))
            .map(row => Number.parseInt(row.dataset.trackIndex || '', 10))
            .filter(Number.isFinite)
    );
    const filtered = [];
    const appendedIndices = [];
    tracks.forEach((track, index) => {
        const trackIndex = typeof track.index === 'number' ? track.index : base + index;
        if (existingTrackIndices.has(trackIndex)) {
            return;
        }
        existingTrackIndices.add(trackIndex);
        filtered.push(track);
        appendedIndices.push(trackIndex);
    });
    if (filtered.length === 0) {
        return [];
    }
    const rows = renderTrackRows(filtered, isPlaylistLike, isLocalSource);
    if (!rows) {
        return [];
    }
    tableBody.insertAdjacentHTML('beforeend', rows);
    const appendedRows = getTrackRowsByIndices(appendedIndices);
    applyIgnoredTrackStateForRows(appendedRows);
    bindIgnoreButtonsForRows(appendedRows);
    scheduleAvailabilityChecks(filtered, isLocalSource);
    preloadDeezerPlaybackContextsForRows(appendedRows, 32);
    if (options.applySpotifyMatches) {
        applySpotifyMatchesToRows(appendedIndices);
    }
    return filtered;
}

function appendSpotifyTrackRows(tracks) {
    appendExternalTrackRows(tracks, {
        baseOffset: spotifyLazyState?.offset ?? 0,
        applySpotifyMatches: true
    });
}

function reconcileExternalMatchesFromCache() {
    const tableBody = document.getElementById('tracks-table-body');
    if (!tableBody) {
        return 0;
    }

    let applied = 0;
    tableBody.querySelectorAll('tr[data-track-index]').forEach((row) => {
        const checkbox = row.querySelector('.track-checkbox');
        if (!checkbox) {
            return;
        }

        const existing = String(checkbox.getAttribute('data-track-id') || '').trim();
        if (existing) {
            return;
        }

        const link = String(row.dataset.availabilityUrl || checkbox.getAttribute('data-track-link') || '').trim();
        if (!link || !externalDeezerMatchCache.has(link)) {
            return;
        }

        const deezerId = String(externalDeezerMatchCache.get(link) || '').trim();
        if (!/^\d+$/.test(deezerId)) {
            return;
        }

        applyExternalMatchToRow(row, deezerId);
        applied += 1;
    });

    return applied;
}

function markUnresolvedExternalRowsAsUnmatched(indices) {
    if (!(indices instanceof Set) || indices.size === 0) {
        return;
    }

    indices.forEach((index) => {
        const row = getTracklistRowByIndex(index);
        if (!row) {
            return;
        }

        const source = getRowTrackSource(row);
        if (!isDeezerMatchedExternalSource(source)) {
            return;
        }

        const deezerId = String(row.querySelector('.track-checkbox')?.dataset.trackId || row.dataset.availabilityDeezerId || '').trim();
        if (/^\d+$/.test(deezerId)) {
            return;
        }

        applyUnmatchedRowState(row);
    });
}

async function hydrateLibrespotTrackDetails(tracks) {
    if (!tracks || tracks.length === 0) {
        return;
    }

    const ids = [];
    tracks.forEach(track => {
        const id = getSpotifyTrackId(track);
        if (!id || librespotHydratedIds.has(id)) {
            return;
        }
        ids.push(id);
    });

    if (ids.length === 0) {
        return;
    }

    try {
        const response = await fetch(`/api/spotify/tracklist/librespot/tracks?ids=${encodeURIComponent(ids.join(','))}`);
        if (!response.ok) {
            throw new Error(`Failed to hydrate librespot tracks (HTTP ${response.status})`);
        }
        const payload = await response.json();
        if (!payload.available || !Array.isArray(payload.tracks)) {
            return;
        }

        const hydratedNow = new Set();
        payload.tracks.forEach(track => {
            if (!track || !track.id) {
                return;
            }
            const hasUsefulData = Boolean(
                (track.name && track.name.trim()) ||
                (track.artists && track.artists.trim()) ||
                (track.album && track.album.trim()) ||
                (track.durationMs && Number(track.durationMs) > 0)
            );
            if (!hasUsefulData) {
                return;
            }

            const mapped = {
                title: track.name || 'Unknown',
                artist: { name: track.artists || 'Unknown', id: '' },
                album: { title: track.album || 'Unknown', cover_medium: normalizeCoverUrl(track.imageUrl || '') },
                duration: track.durationMs ? Math.round(track.durationMs / 1000) : 0,
                durationMs: track.durationMs || 0,
                isrc: track.isrc || '',
                link: track.sourceUrl || `https://open.spotify.com/track/${track.id}`
            };
            const row = document.querySelector(`tr[data-spotify-id="${track.id}"]`);
            if (row) {
                applyLibrespotTrackDetailsToRow(row, mapped);
            }
            hydratedNow.add(track.id);
        });

        hydratedNow.forEach((id) => librespotHydratedIds.add(id));
    } catch (error) {
        console.warn('Librespot track hydration failed', error);
    }
}

function applyLibrespotTrackDetailsToRow(row, track) {
    if (!row || !track) {
        return;
    }
    const hasUsefulData = Boolean(
        (track.title && track.title.trim()) ||
        (track.artist?.name && track.artist.name.trim()) ||
        (track.album?.title && track.album.title.trim())
    );
    if (!hasUsefulData) {
        return;
    }

    const durationSeconds = resolveTrackDurationSeconds(track);
    const durationMs = durationSeconds > 0 ? durationSeconds * 1000 : 0;

    const titleCell = row.querySelector('.track-title');
    if (titleCell) {
        titleCell.innerHTML = renderTrackTitleHtml(track);
    }

    const artistCell = row.querySelector('.track-artist');
    if (artistCell) {
        artistCell.textContent = track.artist?.name || 'Unknown';
    }

    const albumCell = row.querySelector('.track-album');
    if (albumCell) {
        albumCell.textContent = track.album?.title || 'Unknown';
    }

    const durationCell = row.querySelector('.track-duration');
    if (durationCell) {
        durationCell.textContent = formatTrackDurationSeconds(durationSeconds);
    }

    const checkbox = row.querySelector('.track-checkbox');
    if (checkbox) {
        checkbox.setAttribute('data-track-link', track.link || track.sourceUrl || track.appleUrl || '');
        checkbox.setAttribute('data-track-title', escapeHtml(track.title || ''));
        checkbox.setAttribute('data-track-artist', escapeHtml(track.artist?.name || ''));
        checkbox.setAttribute('data-track-album', escapeHtml(track.album?.title || ''));
        checkbox.setAttribute('data-track-cover', escapeHtml(normalizeCoverUrl(track.album?.cover_medium || '')));
        checkbox.setAttribute('data-track-isrc', escapeHtml(track.isrc || ''));
        checkbox.setAttribute('data-track-duration-ms', durationMs);
    }

    const ignoreButton = row.querySelector('.track-ignore-btn');
    if (ignoreButton) {
        ignoreButton.setAttribute('data-ignore-track-isrc', escapeHtml(track.isrc || ''));
    }

    const availabilityKey = buildAvailabilityKeyFromTrack(track, getSpotifyTrackId(track));
    if (availabilityKey) {
        row.dataset.availabilityKey = availabilityKey;
        row.dataset.availabilityUrl = track.link || '';
        row.dataset.availabilityIsrc = track.isrc || '';
        row.dataset.availabilitySpotifyId = getSpotifyTrackId(track) || '';
        row.dataset.availabilityAppleId = track.appleId || track.apple_id || '';
        row.dataset.availabilityTidalId = track.tidalId || track.tidal_id || '';
        row.dataset.availabilityQobuzId = track.qobuzId || track.qobuz_id || '';
        row.dataset.availabilityAmazonId = track.amazonId || track.amazon_id || track.amazonMusicId || track.amazon_music_id || '';
        row.dataset.availabilityDeezerId = track.id || '';
        row.dataset.availabilityTitle = track.title || '';
        row.dataset.availabilityArtist = (track.artist && track.artist.name) || track.artists || track.artist_name || '';
        row.dataset.availabilityDuration = durationMs > 0 ? String(durationMs) : '';
        scheduleAvailabilityChecks([track], false);
    }
}

async function startSpotifyMatchPolling(token, pendingCount) {
    if (spotifyMatchTimer) {
        clearInterval(spotifyMatchTimer);
    }

    let remaining = pendingCount;
    spotifyMatchCompletion = null;
    spotifyMatchState = { pending: remaining, matched: null, failed: null, rechecking: null };
    updateSpotifyNotice();
    const pollMatches = async () => {
        try {
            const response = await fetch(`/api/spotify/tracklist/matches?token=${encodeURIComponent(token)}`);
            if (!response.ok) {
                return;
            }
            const payload = await response.json();
            if (!payload.available) {
                return;
            }
            if (Array.isArray(payload.matches)) {
                applySpotifyMatches(payload.matches);
            }
            if (typeof payload.pending === 'number') {
                remaining = payload.pending;
            }
            const matched = typeof payload.matched === 'number' ? payload.matched : null;
            const failed = typeof payload.failed === 'number' ? payload.failed : null;
            const rechecking = typeof payload.rechecking === 'number' ? payload.rechecking : null;
            const normalizedMatchState = normalizeSpotifyMatchNoticeState({
                pending: remaining,
                matched,
                failed,
                rechecking
            });
            remaining = typeof normalizedMatchState?.pending === 'number' ? normalizedMatchState.pending : remaining;
            const normalizedMatched = typeof normalizedMatchState?.matched === 'number' ? normalizedMatchState.matched : matched;
            const normalizedFailed = typeof normalizedMatchState?.failed === 'number' ? normalizedMatchState.failed : failed;
            const normalizedRechecking = typeof normalizedMatchState?.rechecking === 'number' ? normalizedMatchState.rechecking : rechecking;

            if (remaining <= 0) {
                clearInterval(spotifyMatchTimer);
                spotifyMatchTimer = null;
                spotifyMatchState = null;
                if (normalizedMatched !== null && normalizedFailed !== null) {
                    spotifyMatchCompletion = `Matching complete: ${normalizedMatched} matched, ${normalizedFailed} failed.`;
                    if (normalizedFailed > 0
                        && isSpotifyPlaylistDeezerMatchContext()
                        && !spotifyMatchFailureToastShown
                        && window.DeezSpoTag?.ui?.showToast) {
                        spotifyMatchFailureToastShown = true;
                        DeezSpoTag.ui.showToast(`Deezer matching failed for ${normalizedFailed} playlist track(s).`, { type: 'warning' });
                    }
                } else {
                    spotifyMatchCompletion = 'All Deezer matches are ready.';
                }
                updateSpotifyNotice();
            } else {
                spotifyMatchState = { pending: remaining, matched: normalizedMatched, failed: normalizedFailed, rechecking: normalizedRechecking };
                updateSpotifyNotice();
            }
        } catch (error) {
            console.warn('Spotify match polling failed', error);
        }
    };

    await pollMatches();
    spotifyMatchTimer = setInterval(pollMatches, 1000);
}

function applySpotifyMatchesToRows(indices) {
    if (!Array.isArray(indices) || indices.length === 0) {
        return;
    }
    indices.forEach(index => {
        if (!spotifyMatchCache.has(index)) {
            return;
        }
        const row = document.querySelector(`tr[data-track-index="${index}"]`);
        if (!row) {
            return;
        }
            applyExternalMatchToRow(row, spotifyMatchCache.get(index) || '');
    });
}

function applySpotifyMatches(matches) {
    matches.forEach(match => {
        if (!match) {
            return;
        }
        const status = String(match.status || '').toLowerCase();
        const spotifyId = match.spotifyId || match.spotifyID || '';
        const byIndex = (match.index !== undefined && match.index !== null)
            ? document.querySelector(`tr[data-track-index="${match.index}"]`)
            : null;
        const bySpotifyId = !byIndex && spotifyId
            ? document.querySelector(`tr[data-spotify-id="${spotifyId}"]`)
            : null;
        const row = byIndex || bySpotifyId;
        const rawDeezerId = String(match.deezerId || match.deezerID || '').trim();
        const deezerId = /^\d+$/.test(rawDeezerId) ? rawDeezerId : '';
        if (match.index !== undefined && match.index !== null && deezerId) {
            spotifyMatchCache.set(match.index, deezerId || '');
        }
        if (row && (deezerId || status === 'matched')) {
            applyExternalMatchToRow(row, deezerId);
        } else if (row && status) {
            applyUnmatchedRowState(row);
        }
    });
}

function getRowTrackSource(row) {
    if (!row) {
        return '';
    }
    const rowSource = String(row.dataset.trackSource || '').trim().toLowerCase();
    if (rowSource) {
        return rowSource;
    }
    const checkbox = row.querySelector('.track-checkbox');
    return String(checkbox?.dataset.trackSource || '').trim().toLowerCase();
}

function isDeezerMatchedExternalSource(source) {
    const normalizedSource = String(source || '').trim().toLowerCase();
    return deezerMatchedExternalSources.has(normalizedSource);
}

function buildExternalMatchRequestFromTrack(track, source, fallbackIndex) {
    if (!track) {
        return null;
    }

    let link = track.link || track.sourceUrl || track.appleUrl || '';
    if (!link && source === 'spotify') {
        const spotifyId = getSpotifyTrackId(track);
        if (spotifyId) {
            link = `https://open.spotify.com/track/${spotifyId}`;
        }
    }
    if (!link) {
        return null;
    }

    return {
        link,
        index: track.index ?? fallbackIndex,
        title: track.title || '',
        artist: resolveArtistName(track) || '',
        album: track.album?.title || '',
        isrc: track.isrc || '',
        durationMs: resolveTrackDurationMs(track)
    };
}

function buildSpotifyTrackResolveRequestFromRow(row) {
    if (!row) {
        return null;
    }

    const checkbox = row.querySelector('.track-checkbox');
    const sourceLink = String(row.dataset.availabilityUrl || checkbox?.dataset.trackLink || '').trim();
    const source = getRowTrackSource(row);
    let link = sourceLink;
    if (!link && source === 'spotify') {
        const spotifyId = String(row.dataset.spotifyId || checkbox?.dataset.spotifyId || '').trim();
        if (spotifyId) {
            link = `https://open.spotify.com/track/${spotifyId}`;
        }
    }
    if (!link) {
        return null;
    }

    const durationMsRaw = Number(row.dataset.availabilityDuration || checkbox?.dataset.trackDurationMs || 0);
    return {
        link,
        index: parseInt(row.dataset.trackIndex || '-1', 10),
        title: row.dataset.availabilityTitle || checkbox?.dataset.trackTitle || '',
        artist: row.dataset.availabilityArtist || checkbox?.dataset.trackArtist || '',
        album: checkbox?.dataset.trackAlbum || '',
        isrc: row.dataset.availabilityIsrc || checkbox?.dataset.trackIsrc || '',
        durationMs: Number.isFinite(durationMsRaw) && durationMsRaw > 0 ? Math.round(durationMsRaw) : 0
    };
}

function buildExternalMatchRequestFromRow(row) {
    return buildSpotifyTrackResolveRequestFromRow(row);
}

function getTracklistRowByIndex(index) {
    if (index === undefined || index === null) {
        return null;
    }

    return document.querySelector(`tr[data-track-index="${index}"]`);
}

function getTracklistPlaybackFacade() {
    const facade = window.DeezerPlaybackFacade;
    if (!facade || typeof facade !== 'object') {
        return null;
    }
    if (typeof facade.resolveTrackBySpotifyUrl !== 'function') {
        return null;
    }
    if (typeof facade.resolvePlayableStreamUrl !== 'function') {
        return null;
    }
    if (typeof facade.resolvePlayablePreviewUrl !== 'function') {
        return null;
    }
    return facade;
}

function buildExternalDeezerResolveQuery(current, source) {
    const qs = new URLSearchParams();
    qs.set('url', current.link);
    if (current.title) {
        qs.set('title', current.title);
    }
    if (current.artist) {
        qs.set('artist', current.artist);
    }
    if (current.album) {
        qs.set('album', current.album);
    }
    if (current.isrc) {
        qs.set('isrc', current.isrc);
    }
    if (current.durationMs && Number.isFinite(current.durationMs) && current.durationMs > 0) {
        qs.set('durationMs', String(current.durationMs));
    }
    return qs;
}

async function resolveExternalRequestToDeezer(current, source, row, options = {}) {
    if (!current || !current.link) {
        return '';
    }

    const cacheKey = String(current.link || '').trim();
    if (!cacheKey) {
        return '';
    }

    const priority = options?.priority === 'high' ? 'high' : 'low';
    let inFlightEntry = externalDeezerMatchInFlight.get(cacheKey);
    const shouldPromotePriority = priority === 'high'
        && inFlightEntry
        && inFlightEntry.priority !== 'high';

    if (!inFlightEntry || shouldPromotePriority) {
        const inFlightPromise = runExternalResolverTask(async () => {
            let deezerId = '';
            if (source === 'spotify') {
                const facade = getTracklistPlaybackFacade();
                const request = buildSpotifyTrackResolveRequestFromRow(row);
                if (facade) {
                    const resolved = request
                        ? await facade.resolveTrackBySpotifyRequest(request)
                        : null;
                    deezerId = resolved?.deezerId || '';
                }
            }

            if (!deezerId) {
                const qs = buildExternalDeezerResolveQuery(current, source);
                const data = await fetchJsonWithRetry(`/api/resolve/deezer?${qs.toString()}`, 3);
                deezerId = data?.deezerId || '';
            }

            externalDeezerMatchCache.set(cacheKey, deezerId);
            return { deezerId };
        }, priority);

        inFlightEntry = {
            promise: inFlightPromise,
            priority
        };
        externalDeezerMatchInFlight.set(cacheKey, inFlightEntry);
    }

    try {
        const result = await inFlightEntry.promise;
        const deezerId = String(result?.deezerId || '').trim();
        if (deezerId && row) {
            applyExternalMatchToRow(row, deezerId);
        }
        return deezerId;
    } finally {
        if (externalDeezerMatchInFlight.get(cacheKey) === inFlightEntry) {
            externalDeezerMatchInFlight.delete(cacheKey);
        }
    }
}

async function resolveDeezerPlaybackUrlForRow(row, deezerId, playbackType = '') {
    const normalizedId = String(deezerId || '').trim();
    if (!normalizedId || !/^\d+$/.test(normalizedId)) {
        return '';
    }

    const facade = getTracklistPlaybackFacade();
    if (facade) {
        const resolvedViaFacade = await facade.resolvePlayableStreamUrl(normalizedId, {
            type: playbackType,
            element: row,
            cache: deezerPlaybackContextCache,
            requests: deezerPlaybackContextRequests,
            fetchContext: true
        });
        if (resolvedViaFacade) {
            return await facade.resolvePlayablePreviewUrl(resolvedViaFacade, {
                type: playbackType,
                element: row,
                cache: deezerPlaybackContextCache,
                requests: deezerPlaybackContextRequests
            });
        }
    }

    const context = getDeezerPlaybackContextForRow(row, normalizedId);
    const streamUrl = buildDeezerStreamUrl(normalizedId, {
        type: playbackType,
        context
    });
    return window.DeezerPlaybackFacade?.resolvePlayablePreviewUrl
        ? await window.DeezerPlaybackFacade.resolvePlayablePreviewUrl(streamUrl, {
            type: playbackType,
            element: row,
            cache: deezerPlaybackContextCache,
            requests: deezerPlaybackContextRequests
        })
        : streamUrl;
}

function applyExternalMatchToRow(row, deezerId) {
    const source = getRowTrackSource(row);
    if (source === 'boomplay') {
        applyBoomplayMatchToRow(row, deezerId);
        return;
    }
    applySpotifyMatchToRow(row, deezerId);
}

function applySpotifyMatchToRow(row, deezerId) {
    applyMatchedRowState(row, deezerId);
}

function applyBoomplayMatchToRow(row, deezerId) {
    applyMatchedRowState(row, deezerId);
}

function updateMatchedRowPreviewControl(row, deezerId) {
    const previewControl = row?.querySelector('.preview-controls');
    if (!previewControl) {
        return;
    }

    const normalizedId = String(deezerId || '').trim();
    const source = getRowTrackSource(row);
    const canRetryMatch = !normalizedId
        && isDeezerMatchedExternalSource(source)
        && !!buildSpotifyTrackResolveRequestFromRow(row);
    const playbackContext = normalizedId
        ? getDeezerPlaybackContextForRow(row, normalizedId)
        : null;
    const isPreparingPlayback = !!normalizedId
        && isDeezerMatchedExternalSource(source)
        && !playbackContext;
    const preview = normalizedId && playbackContext
        ? buildDeezerStreamUrl(normalizedId, {
            type: getRowPlaybackTypeHint(row),
            context: playbackContext
        })
        : '';

    previewControl.setAttribute('data-preview', preview);
    if (preview) {
        previewControl.classList.remove('is-disabled');
        previewControl.classList.remove('is-pending');
        previewControl.setAttribute('title', getRowPlaybackTypeHint(row) === 'episode' ? 'Play Episode' : 'Play Track');
        return;
    }

    previewControl.classList.toggle('is-disabled', !canRetryMatch && !isPreparingPlayback);
    previewControl.classList.toggle('is-pending', canRetryMatch || isPreparingPlayback);
    previewControl.setAttribute('title', isPreparingPlayback
        ? 'Preparing Deezer playback'
        : (canRetryMatch ? 'Resolving Deezer match' : 'No Deezer match'));
}

function applyMatchedRowState(row, deezerId) {
    updateMatchedRowCheckbox(row, deezerId);
    const source = getRowTrackSource(row);
    const canRetryMatch = !deezerId
        && isDeezerMatchedExternalSource(source)
        && !!buildSpotifyTrackResolveRequestFromRow(row);
    row.dataset.availabilityDeezerId = deezerId;
    row.classList.toggle('track-row-dead', !deezerId && !canRetryMatch);
    updateMatchedRowPreviewControl(row, deezerId);

    if (deezerId) {
        const availabilityTrack = buildAvailabilityTrackFromRow(row, deezerId);
        if (availabilityTrack) {
            const availabilityKey = buildAvailabilityKeyFromTrack(availabilityTrack);
            if (availabilityKey) {
                row.dataset.availabilityKey = availabilityKey;
            }
            scheduleAvailabilityChecks([availabilityTrack], false);
        }
        void ensureDeezerPlaybackContextForRow(row, deezerId);
    }
}

function applyUnmatchedRowState(row) {
    if (!row) {
        return;
    }

    row.dataset.availabilityDeezerId = '';
    row.classList.add('track-row-dead');
    updateMatchedRowCheckbox(row, '');
    updateMatchedRowPreviewControl(row, '');
}

function updateMatchedRowCheckbox(row, deezerId) {
    const checkbox = row.querySelector('.track-checkbox');
    if (!checkbox) {
        return;
    }

    checkbox.setAttribute('data-track-id', deezerId);
    if (deezerId) {
        checkbox.disabled = false;
        checkbox.removeAttribute('aria-disabled');
        checkbox.setAttribute('title', 'Select track');
        return;
    }

    checkbox.checked = false;
    checkbox.disabled = true;
    checkbox.setAttribute('aria-disabled', 'true');
    checkbox.setAttribute('title', 'Unavailable');
}

function buildAvailabilityTrackFromRow(row, deezerId) {
    if (!row || !deezerId) {
        return null;
    }
    return {
        id: deezerId,
        link: row.dataset.availabilityUrl || '',
        isrc: row.dataset.availabilityIsrc || '',
        spotifyId: row.dataset.availabilitySpotifyId || '',
        appleId: row.dataset.availabilityAppleId || '',
        tidalId: row.dataset.availabilityTidalId || '',
        qobuzId: row.dataset.availabilityQobuzId || '',
        amazonId: row.dataset.availabilityAmazonId || '',
        title: row.dataset.availabilityTitle || '',
        artist: row.dataset.availabilityArtist || '',
        durationMs: row.dataset.availabilityDuration ? Number(row.dataset.availabilityDuration) : 0
    };
}

async function fetchJsonWithRetry(url, attempts = 3) {
    let lastError = null;
    for (let attempt = 1; attempt <= attempts; attempt++) {
        try {
            const response = await fetch(url);
            if (response.ok) {
                return await response.json();
            }

            // Retry only transient response codes.
            if (response.status === 429 || response.status >= 500) {
                if (attempt < attempts) {
                    await new Promise(resolve => setTimeout(resolve, Math.min(2000, attempt * 350)));
                    continue;
                }
                return null;
            }

            // Non-transient response (4xx except 429) - do not retry.
            return null;
        } catch (error) {
            lastError = error;
            if (attempt < attempts) {
                await new Promise(resolve => setTimeout(resolve, Math.min(2000, attempt * 350)));
                continue;
            }
            throw lastError;
        }
    }

    return null;
}

function drainExternalResolverQueue() {
    while ((externalResolverScheduler.activeHigh + externalResolverScheduler.activeLow) < externalMatchMaxConcurrent) {
        let priority = '';
        let task = null;

        if (externalResolverScheduler.queueHigh.length > 0) {
            priority = 'high';
            task = externalResolverScheduler.queueHigh.shift();
        } else if (externalResolverScheduler.queueLow.length > 0
            && externalResolverScheduler.activeLow < externalMatchLowConcurrencyCap) {
            priority = 'low';
            task = externalResolverScheduler.queueLow.shift();
        } else {
            return;
        }

        if (!task) {
            continue;
        }

        if (priority === 'high') {
            externalResolverScheduler.activeHigh += 1;
        } else {
            externalResolverScheduler.activeLow += 1;
        }

        Promise.resolve()
            .then(task.work)
            .then(task.resolve, task.reject)
            .finally(() => {
                if (priority === 'high') {
                    externalResolverScheduler.activeHigh = Math.max(0, externalResolverScheduler.activeHigh - 1);
                } else {
                    externalResolverScheduler.activeLow = Math.max(0, externalResolverScheduler.activeLow - 1);
                }
                drainExternalResolverQueue();
            });
    }
}

function runExternalResolverTask(work, priority = 'low') {
    return new Promise((resolve, reject) => {
        const task = { work, resolve, reject };
        if (priority === 'high' && externalResolverScheduler.activeHigh < externalMatchHighConcurrencyCap) {
            externalResolverScheduler.activeHigh += 1;
            Promise.resolve()
                .then(task.work)
                .then(task.resolve, task.reject)
                .finally(() => {
                    externalResolverScheduler.activeHigh = Math.max(0, externalResolverScheduler.activeHigh - 1);
                    drainExternalResolverQueue();
                });
            return;
        }

        if (priority === 'high') {
            externalResolverScheduler.queueHigh.push(task);
        } else {
            externalResolverScheduler.queueLow.push(task);
        }
        drainExternalResolverQueue();
    });
}

async function resolveExternalTracklistMatches(tracks, source, options = {}) {
    if (!Array.isArray(tracks) || tracks.length === 0) {
        return;
    }
    const normalizedSource = String(source || '').trim().toLowerCase();
    const isAppleAudioTracklist = normalizedSource === 'apple'
        && tracks.some(track => track?.isVideo !== true);
    if (isAppleAudioTracklist) {
        return;
    }
    const incremental = options?.incremental === true;
    const finalize = options?.finalize !== false;

    const queue = [];
    const processedIndices = new Set();
    tracks.forEach((track, index) => {
        const resolvedIndex = track?.index ?? index;
        processedIndices.add(resolvedIndex);
        const request = buildExternalMatchRequestFromTrack(track, normalizedSource, index);
        if (!request) {
            applyUnmatchedRowState(getTracklistRowByIndex(resolvedIndex));
            return;
        }
        const deezerHint = String(track.deezerId || track.deezer_id || '').trim();
        const trackIdHint = String(track.id || '').trim();
        const hasResolvedDeezerId = /^\d+$/.test(deezerHint)
            || (normalizedSource === 'spotify' && /^\d+$/.test(trackIdHint));
        if (hasResolvedDeezerId) {
            return;
        }
        const cacheKey = request.link;
        if (externalDeezerMatchCache.has(cacheKey)) {
            const cached = externalDeezerMatchCache.get(cacheKey) || '';
            const row = document.querySelector(`tr[data-track-index="${request.index}"]`);
            if (cached) {
                if (row) {
                    applyExternalMatchToRow(row, cached);
                }
                return;
            }

            // Empty-cache entries are transient misses; allow a fresh re-resolve.
            externalDeezerMatchCache.delete(cacheKey);
        }
        queue.push(request);
    });

    if (queue.length === 0) {
        return;
    }

    const showProgress = normalizedSource === 'boomplay'
        || normalizedSource === 'apple'
        || normalizedSource === 'tidal'
        || normalizedSource === 'amazon'
        || normalizedSource === 'youtube'
        || normalizedSource === 'soundcloud'
        || normalizedSource === 'qobuz'
        || normalizedSource === 'bandcamp'
        || normalizedSource === 'pandora';
    if (showProgress) {
        if (incremental && externalMatchState && externalMatchState.source === source) {
            externalMatchState.pending = (externalMatchState.pending || 0) + queue.length;
            externalMatchState.done = false;
        } else {
            externalMatchState = { source, pending: queue.length, matched: 0, failed: 0, done: false };
        }
        updateSpotifyNotice();
    }

    const concurrency = 4;
    let cursor = 0;
    const workers = Array.from({ length: Math.min(concurrency, queue.length) }, async () => {
        while (cursor < queue.length) {
            const current = queue[cursor++];
            const row = document.querySelector(`tr[data-track-index="${current.index}"]`);
            if (!row) {
                if (showProgress) {
                    externalMatchState.pending = Math.max(0, externalMatchState.pending - 1);
                    externalMatchState.failed++;
                    updateSpotifyNotice();
                }
                continue;
            }
            try {
                const deezerId = await resolveExternalRequestToDeezer(current, normalizedSource, row, { priority: 'low' });
                if (!deezerId) {
                    applyUnmatchedRowState(row);
                }
                if (showProgress) {
                    externalMatchState.pending = Math.max(0, externalMatchState.pending - 1);
                    if (deezerId) {
                        externalMatchState.matched++;
                    } else {
                        externalMatchState.failed++;
                    }
                    updateSpotifyNotice();
                }
            } catch (error) {
                console.warn('External Deezer match failed', error);
                applyUnmatchedRowState(row);
                if (showProgress) {
                    externalMatchState.pending = Math.max(0, externalMatchState.pending - 1);
                    externalMatchState.failed++;
                    updateSpotifyNotice();
                }
            }
        }
    });

    await Promise.all(workers);
    if (source === 'boomplay') {
        reconcileExternalMatchesFromCache();
    }
    markUnresolvedExternalRowsAsUnmatched(processedIndices);

        if (showProgress) {
            if (externalMatchState) {
                externalMatchState.pending = Math.max(0, externalMatchState.pending || 0);
                const canFinalizeNow = finalize;
                externalMatchState.done = canFinalizeNow && externalMatchState.pending === 0;
            }
            updateSpotifyNotice();
        }
    }

async function updateMonitorButtonState() {
    if (monitorMutationInFlight) {
        return;
    }

    const isMonitorable = tracklistType === 'playlist'
        || tracklistType === 'trending'
        || tracklistType === 'smarttracklist'
        || tracklistType === 'recommendation'
        || tracklistType === 'show'
        || isSpotifyArtistTopTracksView();
    const isPodcastShow = String(tracklistType || '').toLowerCase() === 'show';
    const monitorDefaultLabel = isSpotifyArtistTopTracksView()
        ? 'Monitor Top Songs'
        : (isSpotifyHomeTrendingTracklistView()
            ? 'Monitor Trending Songs'
            : (String(tracklistType || '').toLowerCase() === 'recommendation'
                ? 'Monitor Recommendations'
                : (isPodcastShow ? 'Monitor Podcast' : 'Monitor Playlist')));
    const headerActions = document.getElementById('tracklist-header-actions');
    const hideMonitorAndHeaderActions = () => {
        if (headerActions) {
            headerActions.style.display = 'none';
            closeTracklistHeaderActionsMenu();
        }
    };
    const applyDefaultMonitorState = (disabled) => {
        if (monitorLabel) {
            monitorLabel.textContent = monitorDefaultLabel;
        }
        monitorButton.disabled = disabled;
        hideMonitorAndHeaderActions();
        setIgnoreVisibility(false);
    };

    if (!monitorButton || !currentTracklistMeta) {
        if (monitorButton) {
            if (monitorLabel) {
                monitorLabel.textContent = monitorDefaultLabel;
            }
            monitorButton.disabled = true;
        }
        hideMonitorAndHeaderActions();
        setIgnoreVisibility(false);
        return;
    }

    if (!isMonitorable) {
        applyDefaultMonitorState(true);
        return;
    }

    const requestSeq = ++monitorStatusRequestSeq;
    try {
        const status = await fetchJson(`/api/library/playlists/${encodeURIComponent(currentTracklistMeta.source)}/${encodeURIComponent(currentTracklistMeta.sourceId)}`);
        if (requestSeq !== monitorStatusRequestSeq || monitorMutationInFlight) {
            return;
        }
        if (status?.watching) {
            if (monitorLabel) {
                monitorLabel.textContent = 'Monitored';
            }
            monitorButton.disabled = true;
            if (headerActions) {
                headerActions.style.display = '';
            }
            setIgnoreVisibility(false);
        } else {
            applyDefaultMonitorState(false);
        }
    } catch {
        if (requestSeq !== monitorStatusRequestSeq || monitorMutationInFlight) {
            return;
        }
        applyDefaultMonitorState(false);
    }
}

function setIgnoreVisibility(enabled) {
    watchlistIgnoreEnabled = Boolean(enabled);
    document.querySelectorAll('.track-ignore-btn, .track-ignore-toggle').forEach(element => {
        element.classList.toggle('is-hidden', !watchlistIgnoreEnabled);
    });
}

function closeTracklistHeaderActionsMenu() {
    const dropdown = document.getElementById('tracklist-header-actions-dropdown');
    const toggle = document.getElementById('tracklist-header-actions-toggle');
    if (dropdown) {
        dropdown.hidden = true;
    }
    if (toggle) {
        toggle.setAttribute('aria-expanded', 'false');
    }
}

function resolveTracklistBackgroundUrl(url) {
    const normalizedUrl = String(url || '').trim();
    if (!normalizedUrl) {
        return '';
    }

    try {
        const parsed = new URL(normalizedUrl, globalThis.location.origin);
        const protocol = parsed.protocol.toLowerCase();
        if (protocol !== 'http:' && protocol !== 'https:') {
            return normalizedUrl;
        }

        // Keep same-origin artwork direct to avoid routing local proxy URLs
        // through playlist-cover background processing.
        if (parsed.origin === globalThis.location.origin) {
            return parsed.toString();
        }

        return `/api/playlist/cover/background?url=${encodeURIComponent(parsed.toString())}`;
    } catch {
        return normalizedUrl;
    }
}

function applyTracklistArtworkSelection(url) {
    if (!url) {
        return;
    }

    const normalizedUrl = String(url).trim();
    const coverImage = document.querySelector('.tracklist-header .tracklist-cover img');
    if (coverImage) {
        coverImage.src = normalizedUrl;
    }

    const header = document.querySelector('.tracklist-header');
    if (header) {
        const backgroundUrl = resolveTracklistBackgroundUrl(normalizedUrl);
        header.style.backgroundImage = `url('${backgroundUrl}')`;
    }

    if (currentTracklistMeta) {
        currentTracklistMeta.imageUrl = normalizedUrl;
    }
}

async function openPlaylistArtworkHistoryModal() {
    if (!currentTracklistMeta?.source || !currentTracklistMeta?.sourceId) {
        return;
    }

    if (typeof globalThis.openSharedPlaylistArtworkPicker === 'function') {
        await globalThis.openSharedPlaylistArtworkPicker(
            currentTracklistMeta.source,
            currentTracklistMeta.sourceId,
            currentTracklistMeta.name || 'Playlist',
            { onApplied: applyTracklistArtworkSelection, silent: true }
        );
        return;
    }

    DeezSpoTag.ui.alert('Artwork picker unavailable on this page.', { title: 'Playlist Artwork' });
}

function bindTracklistHeaderActions() {
    const actions = document.getElementById('tracklist-header-actions');
    const toggle = document.getElementById('tracklist-header-actions-toggle');
    const dropdown = document.getElementById('tracklist-header-actions-dropdown');
    if (!actions || !toggle || !dropdown) {
        return;
    }

    toggle.addEventListener('click', (event) => {
        event.stopPropagation();
        const shouldOpen = dropdown.hidden;
        closeTracklistHeaderActionsMenu();
        dropdown.hidden = !shouldOpen;
        toggle.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
    });

    dropdown.querySelectorAll('[data-playlist-action]').forEach(button => {
        button.addEventListener('click', async () => {
            const action = button.getAttribute('data-playlist-action');
            closeTracklistHeaderActionsMenu();
            if (action === 'settings') {
                await openPlaylistManagementPage();
                return;
            }

            if (!currentTracklistMeta?.source || !currentTracklistMeta?.sourceId) {
                return;
            }

            try {
                if (action === 'sync') {
                    const result = await fetchJson(`/api/library/playlists/${encodeURIComponent(currentTracklistMeta.source)}/${encodeURIComponent(currentTracklistMeta.sourceId)}/sync`, { method: 'POST' });
                    DeezSpoTag.ui.showToast(result?.message || 'Playlist sync scheduled.');
                    return;
                }

                if (action === 'refresh-artwork') {
                    await fetchJson(`/api/library/playlists/${encodeURIComponent(currentTracklistMeta.source)}/${encodeURIComponent(currentTracklistMeta.sourceId)}/refresh-artwork`, { method: 'POST' });
                    DeezSpoTag.ui.showToast('Playlist artwork refresh started.');
                    return;
                }

                if (action === 'choose-artwork') {
                    await openPlaylistArtworkHistoryModal();
                    return;
                }

                if (action === 'remove') {
                    await fetchJson(`/api/library/playlists/${encodeURIComponent(currentTracklistMeta.source)}/${encodeURIComponent(currentTracklistMeta.sourceId)}`, { method: 'DELETE' });
                    await updateMonitorButtonState();
                    DeezSpoTag.ui.showToast('Playlist removed from monitoring.');
                }
            } catch (error) {
                DeezSpoTag.ui.alert(`${String(action || 'Action')} failed: ${error.message}`, { title: 'Playlist Actions' });
            }
        });
    });

    document.addEventListener('click', (event) => {
        if (!actions.contains(event.target)) {
            closeTracklistHeaderActionsMenu();
        }
    });
}

async function openPlaylistManagementPage() {
    if (!currentTracklistMeta?.source || !currentTracklistMeta?.sourceId) {
        return;
    }

    if (typeof openPlaylistSettingsPanel !== 'function') {
        DeezSpoTag.ui.alert('Playlist settings panel is unavailable on this page.', { title: 'Playlist Settings' });
        return;
    }

    const source = String(currentTracklistMeta.source || '').trim();
    const sourceId = String(currentTracklistMeta.sourceId || '').trim();
    if (!source || !sourceId) {
        return;
    }

    let playlistPrefs = {};
    try {
        if (typeof hydratePlaylistPreferences === 'function') {
            const hydrated = await hydratePlaylistPreferences();
            playlistPrefs = hydrated && typeof hydrated === 'object' ? hydrated : {};
        }
    } catch (error) {
        DeezSpoTag.ui.alert(`Failed to load playlist settings: ${error.message}`, { title: 'Playlist Settings' });
        return;
    }

    try {
        await openPlaylistSettingsPanel(
            source,
            sourceId,
            currentTracklistMeta.name || 'Playlist',
            playlistPrefs
        );
    } catch (error) {
        DeezSpoTag.ui.alert(`Failed to open playlist settings: ${error.message}`, { title: 'Playlist Settings' });
    }
}

if (monitorButton) {
    monitorButton.addEventListener('click', async () => {
        if (!currentTracklistMeta) {
            return;
        }
        if (monitorMutationInFlight) {
            return;
        }
        monitorMutationInFlight = true;
        monitorStatusRequestSeq++;
        if (monitorLabel) {
            monitorLabel.textContent = 'Updating...';
        }
        monitorButton.disabled = true;
        try {
            await fetchJson('/api/library/playlists', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    source: currentTracklistMeta.source,
                    sourceId: currentTracklistMeta.sourceId,
                    name: currentTracklistMeta.name,
                    imageUrl: currentTracklistMeta.imageUrl,
                    description: currentTracklistMeta.description,
                    trackCount: currentTracklistMeta.trackCount
                })
            });
            if (monitorLabel) {
                monitorLabel.textContent = 'Monitored';
            }
            monitorButton.disabled = true;
            const headerActions = document.getElementById('tracklist-header-actions');
            if (headerActions) {
                headerActions.style.display = '';
            }
            setIgnoreVisibility(false);
        } catch (error) {
            monitorMutationInFlight = false;
            await updateMonitorButtonState();
            DeezSpoTag.ui.alert(`Monitor failed: ${error.message}`, { title: 'Monitor Playlist' });
            return;
        } finally {
            monitorMutationInFlight = false;
        }
    });
}

function getTracklistColumnCount(isPlaylistLike, isLocalSource) {
    // Base columns: number, title, artist, [album if playlist], duration, actions
    let base = isPlaylistLike ? 7 : 6;
    if (!shouldShowQualityColumn()) {
        base -= 1;
    }
    return base
        + (shouldShowMonitoredStateColumn(isLocalSource) ? 1 : 0)
        + (shouldShowAvailabilityColumn(isLocalSource) ? 1 : 0)
        + (shouldShowQuickDownloadColumn(isLocalSource) ? 1 : 0);
}

function shouldShowMonitoredStateColumn(isLocalSource) {
    return monitoredPlaylistTracklistActive && !isLocalSource && tracklistLayoutIsPlaylistLike;
}

function shouldShowAvailabilityColumn(isLocalSource) {
    if (!availabilityChecksEnabled) {
        return false;
    }
    const isPodcastView = String(tracklistType || '').toLowerCase() === 'show'
        || String(tracklistType || '').toLowerCase() === 'episode';
    return !isLocalSource && !tracklistIsAtmosView && !isPodcastView;
}

function shouldShowQuickDownloadColumn(isLocalSource) {
    return !isLocalSource;
}

function shouldShowQualityColumn() {
    return tracklistIsAtmosView;
}

function isAtmosTrackRow(track) {
    return track?.hasAtmos === true
        || track?.hasAtmos === 'true'
        || track?.hasAtmos === 1
        || (tracklistRequestsTidalAtmos && (tracklistSource || '').toLowerCase() === 'tidal');
}

function renderTrackLocationStatusCell(status) {
    const normalizedStatus = normalizeTrackLocationStatus(status?.status);
    if (normalizedStatus === 'missing') {
        return '';
    }
    const label = String(status?.label || '').trim() || resolveTrackLocationStatusLabel(normalizedStatus);
    const detail = String(status?.detail || '').trim();
    return `<span class="track-location-status-pill track-location-status-pill--${escapeHtml(normalizedStatus)}" title="${escapeHtml(detail)}">${escapeHtml(label)}</span>`;
}

function resolveMonitoredTrackLocationStatus(track, source) {
    if (!monitoredPlaylistTracklistActive || !track) {
        return null;
    }

    const normalizedSource = String(source || '').trim().toLowerCase();
    let sourceTrackId = '';
    switch (normalizedSource) {
        case 'spotify':
            sourceTrackId = String(track.spotifyId || track.spotify_id || track.sourceTrackId || track.id || '').trim();
            break;
        case 'apple':
            sourceTrackId = String(track.appleId || track.apple_id || track.sourceTrackId || track.id || '').trim();
            break;
        case 'tidal':
            sourceTrackId = String(track.tidalId || track.tidal_id || track.sourceTrackId || track.id || '').trim();
            break;
        case 'qobuz':
            sourceTrackId = String(track.qobuzId || track.qobuz_id || track.sourceTrackId || track.id || '').trim();
            break;
        case 'amazon':
        case 'amazonmusic':
            sourceTrackId = String(track.amazonId || track.amazon_id || track.sourceTrackId || track.id || '').trim();
            break;
        case 'deezer':
            sourceTrackId = String(track.deezerId || track.deezer_id || track.sourceTrackId || track.id || '').trim();
            break;
        default:
            sourceTrackId = String(track.sourceTrackId || track.id || '').trim();
            break;
    }

    return sourceTrackId ? monitoredPlaylistTrackStatuses.get(sourceTrackId) || null : null;
}

function normalizeTrackLocationStatus(status) {
    const normalized = String(status || '').trim().toLowerCase();
    return ['target', 'library', 'queued', 'downloading', 'paused', 'retrying', 'failed', 'cancelled', 'blocked', 'unavailable', 'missing'].includes(normalized)
        ? normalized
        : 'missing';
}

function resolveTrackLocationStatusLabel(status) {
    switch (normalizeTrackLocationStatus(status)) {
        case 'target':
            return 'Plex library';
        case 'library':
            return 'Library';
        case 'queued':
            return 'Queued';
        case 'downloading':
            return 'Downloading';
        case 'paused':
            return 'Paused';
        case 'retrying':
            return 'Retrying';
        case 'failed':
            return 'Failed';
        case 'cancelled':
            return 'Cancelled';
        case 'blocked':
            return 'Blocked';
        case 'unavailable':
            return 'Unavailable';
        default:
            return 'Missing';
    }
}

function renderAvailabilityCell() {
    return `
        <div class="availability-icons">
            <span class="availability-icon availability-deezer is-loading" data-platform="deezer" title="Deezer"></span>
            <span class="availability-icon availability-spotify is-loading" data-platform="spotify" title="Spotify"></span>
            <span class="availability-icon availability-tidal is-loading" data-platform="tidal" title="Tidal"></span>
            <span class="availability-icon availability-amazon is-loading" data-platform="amazon" title="Amazon Music"></span>
            <span class="availability-icon availability-qobuz is-loading" data-platform="qobuz" title="Qobuz"></span>
            <span class="availability-icon availability-apple is-loading" data-platform="apple" title="Apple Music"></span>
        </div>
    `;
}

const availabilityChecksEnabled = @trackAvailabilityColumnEnabled.ToString().ToLowerInvariant();
const availabilityCache = new Map();
const availabilityQueue = [];
let availabilityActive = 0;
const availabilityMaxConcurrent = 4;
let apiTokenCache = null;
const availabilityDelayMs = 1200;
const availabilityMinIntervalMs = 1500;
const availabilitySuccessTtlMs = 10 * 60 * 1000;
const availabilityFailureTtlMs = 2 * 60 * 1000;
let availabilityNextAllowedAt = 0;
let availabilityDelayTimer = null;
let availabilityDeferred = [];

async function getApiToken() {
    if (apiTokenCache !== null) {
        return apiTokenCache;
    }
    try {
        const response = await fetch('/api/getSettings');
        if (!response.ok) {
            apiTokenCache = '';
            return apiTokenCache;
        }
        const payload = await response.json();
        apiTokenCache = payload?.settings?.apiToken || '';
        return apiTokenCache;
    } catch {
        apiTokenCache = '';
        return apiTokenCache;
    }
}

function buildAvailabilityKeyFromTrack(track, spotifyIdOverride) {
    const currentSource = (tracklistSource || requestSource || '').toLowerCase();
    const ids = resolveTrackPlatformIds(track, spotifyIdOverride);
    const keyParts = [];
    if (ids.deezerId) {
        keyParts.push(`deezer:${ids.deezerId}`);
    }
    if (ids.spotifyId) {
        keyParts.push(`spotify:${ids.spotifyId}`);
    }
    if (ids.appleId) {
        keyParts.push(`apple:${ids.appleId}`);
    }
    if (ids.tidalId) {
        keyParts.push(`tidal:${ids.tidalId}`);
    }
    if (ids.qobuzId) {
        keyParts.push(`qobuz:${ids.qobuzId}`);
    }
    if (ids.amazonId) {
        keyParts.push(`amazon:${ids.amazonId}`);
    }
    if (keyParts.length > 0) {
        return keyParts.join('|');
    }
    const link = String(track.link || track.sourceUrl || '').trim();
    if (link) {
        return `url:${link}`;
    }
    const isrc = String(track.isrc || '').trim();
    if (isrc) {
        return `isrc:${isrc}`;
    }
    return '';
}

function scheduleAvailabilityChecks(tracks, isLocalSource) {
    if (!availabilityChecksEnabled) {
        return;
    }
    if (!tracks || tracks.length === 0 || !shouldShowAvailabilityColumn(isLocalSource)) {
        return;
    }

    const eligibleTracks = tracks.filter(track => !!buildAvailabilityKeyFromTrack(track));
    if (eligibleTracks.length === 0) {
        return;
    }

    deferAvailabilityChecks(eligibleTracks);
}

function deferAvailabilityChecks(tracks) {
    if (!tracks || tracks.length === 0) {
        return;
    }

    availabilityDeferred = availabilityDeferred.concat(tracks);
    if (availabilityDelayTimer) {
        return;
    }

    const hasMatchedDeezerIds = isSpotifySource() && tracks.some(track =>
        (track?.id || track?.deezerId || track?.deezer_id || '').toString().trim()
    );
    const delayMs = hasMatchedDeezerIds ? 100 : availabilityDelayMs;

    availabilityDelayTimer = setTimeout(() => {
        availabilityDelayTimer = null;
        const batch = availabilityDeferred;
        availabilityDeferred = [];
        enqueueAvailabilityChecks(batch);
    }, delayMs);
}

function enqueueAvailabilityChecks(tracks) {
    tracks.forEach(track => {
        const key = buildAvailabilityKeyFromTrack(track);
        if (!key) {
            return;
        }
        const cached = getCachedAvailability(key);
        if (cached !== undefined) {
            applyAvailabilityToRows(key, cached);
            return;
        }
        if (availabilityQueue.some(entry => entry.key === key)) {
            return;
        }
        availabilityQueue.push({ key, track });
    });

    drainAvailabilityQueue();
}

function drainAvailabilityQueue() {
    if (availabilityActive >= availabilityMaxConcurrent) {
        return;
    }
    while (availabilityActive < availabilityMaxConcurrent && availabilityQueue.length > 0) {
        const now = Date.now();
        if (now < availabilityNextAllowedAt) {
            const waitMs = availabilityNextAllowedAt - now;
            setTimeout(drainAvailabilityQueue, waitMs);
            return;
        }
        const next = availabilityQueue.shift();
        if (!next) {
            break;
        }
        availabilityActive++;
        availabilityNextAllowedAt = Date.now() + availabilityMinIntervalMs;
        fetchAvailability(next.track)
            .then(result => {
                const normalized = mergeAvailabilityWithTrackEvidence(next.track, result);
                if (normalized !== null && normalized !== undefined) {
                    availabilityCache.set(next.key, { stamp: Date.now(), value: normalized });
                }
                applyAvailabilityToRows(next.key, normalized);
            })
            .catch(() => {
                const normalized = mergeAvailabilityWithTrackEvidence(next.track, null);
                availabilityCache.set(next.key, { stamp: Date.now(), value: normalized });
                applyAvailabilityToRows(next.key, normalized);
            })
            .finally(() => {
                availabilityActive--;
                drainAvailabilityQueue();
            });
    }
}

function getCachedAvailability(key) {
    if (!availabilityCache.has(key)) {
        return undefined;
    }
    const cached = availabilityCache.get(key);
    if (!cached || typeof cached !== 'object') {
        availabilityCache.delete(key);
        return undefined;
    }
    const age = Date.now() - (cached.stamp || 0);
    const ttl = cached.value === null ? availabilityFailureTtlMs : availabilitySuccessTtlMs;
    if (age > ttl) {
        availabilityCache.delete(key);
        return undefined;
    }
    return cached.value;
}

async function fetchAvailability(track) {
    const ids = resolveTrackPlatformIds(track);
    const link = (track.link || track.sourceUrl || '').trim();
    const isrc = (track.isrc || '').trim();
    const qs = new URLSearchParams();
    if (ids.deezerId) {
        qs.set('deezerId', ids.deezerId);
    }
    if (ids.spotifyId) {
        qs.set('spotifyId', ids.spotifyId);
    }
    if (ids.appleId) {
        qs.set('appleId', ids.appleId);
    }
    if (ids.tidalId) {
        qs.set('tidalId', ids.tidalId);
    }
    if (ids.qobuzId) {
        qs.set('qobuzId', ids.qobuzId);
    }
    if (ids.amazonId) {
        qs.set('amazonId', ids.amazonId);
    }
    if (link) {
        qs.set('url', link);
    }
    if (isrc) {
        qs.set('isrc', isrc);
    }
    if ([...qs.keys()].length === 0) {
        return null;
    }
    if (track.title) {
        qs.set('title', track.title);
    }
    const artistValue = typeof track.artist === 'object' && track.artist !== null
        ? (track.artist.name || '')
        : (track.artist || '');
    if (artistValue) {
        qs.set('artist', artistValue);
    }
    const albumValue = typeof track.album === 'object' && track.album !== null
        ? (track.album.title || track.album.name || '')
        : (track.album || '');
    if (albumValue) {
        qs.set('album', albumValue);
    }
    if (track.durationMs && Number.isFinite(track.durationMs)) {
        qs.set('durationMs', String(track.durationMs));
    }

    const apiToken = await getApiToken();
    const headers = apiToken ? { Authorization: `Bearer ${apiToken}` } : {};
    const response = await fetch(`/api/availability/track?${qs.toString()}`, { headers });
    if (!response.ok) {
        return null;
    }
    return await response.json();
}

function mergeAvailabilityWithTrackEvidence(track, availability) {
    const status = availability && typeof availability === 'object'
        ? { ...availability }
        : {};
    const ids = resolveTrackPlatformIds(track);
    const link = String(track?.link || track?.sourceUrl || '').trim();
    const source = (tracklistSource || requestSource || '').toLowerCase();

    if (ids.deezerId || isPlatformSourceUrl(link, 'deezer') || source === 'deezer') {
        status.deezer = true;
    }
    if (ids.spotifyId || isPlatformSourceUrl(link, 'spotify') || source === 'spotify') {
        status.spotify = true;
    }
    if (ids.tidalId || isPlatformSourceUrl(link, 'tidal') || source === 'tidal') {
        status.tidal = true;
    }
    if (ids.qobuzId || isPlatformSourceUrl(link, 'qobuz') || source === 'qobuz') {
        status.qobuz = true;
    }
    if (ids.appleId || isPlatformSourceUrl(link, 'apple') || source === 'apple') {
        status.apple = true;
    }
    if (ids.amazonId || isPlatformSourceUrl(link, 'amazon') || source === 'amazon') {
        status.amazon = true;
    }

    return status;
}

function isPlatformSourceUrl(url, platform) {
    if (!url) {
        return false;
    }

    const normalized = url.toLowerCase();
    switch (platform) {
        case 'deezer':
            return normalized.includes('deezer.com/track/');
        case 'spotify':
            return normalized.includes('open.spotify.com/track/') || normalized.startsWith('spotify:track:');
        case 'tidal':
            return normalized.includes('tidal.com/track/') || normalized.includes('tidal.com/browse/track/');
        case 'qobuz':
            return normalized.includes('qobuz.com/') && normalized.includes('/track/');
        case 'apple':
            return normalized.includes('music.apple.com/') && (normalized.includes('/song/') || normalized.includes('?i='));
        case 'amazon':
            return normalized.includes('music.amazon.');
        default:
            return false;
    }
}

function applyAvailabilityToRows(key, availability) {
    const rows = document.querySelectorAll(`tr[data-availability-key="${CSS.escape(key)}"]`);
    if (!rows.length) {
        return;
    }
    rows.forEach(row => applyAvailabilityToRow(row, availability));
}

function applyAvailabilityToRow(row, availability) {
    const container = row.querySelector('.availability-icons');
    if (!container) {
        return;
    }
    const status = availability || {};
    updateAvailabilityTag(container, 'deezer', resolvePlatformAvailability(row, status, 'deezer'));
    updateAvailabilityTag(container, 'spotify', resolvePlatformAvailability(row, status, 'spotify'));
    updateAvailabilityTag(container, 'tidal', resolvePlatformAvailability(row, status, 'tidal'));
    updateAvailabilityTag(container, 'amazon', resolvePlatformAvailability(row, status, 'amazon'));
    updateAvailabilityTag(container, 'qobuz', resolvePlatformAvailability(row, status, 'qobuz'));
    updateAvailabilityTag(container, 'apple', resolvePlatformAvailability(row, status, 'apple'));
}

function resolvePlatformAvailability(row, status, platform) {
    if (!row || !status) {
        return undefined;
    }

    if (status[platform] === true) {
        return true;
    }

    if (platform === 'spotify' && (status.spotifyId || status.spotifyUrl)) {
        return true;
    }

    if (platform === 'deezer' && (status.deezerId || status.deezerUrl)) {
        return true;
    }

    if (platform === 'tidal' && (status.tidalId || status.tidalUrl)) {
        return true;
    }

    if (platform === 'amazon' && (status.amazonId || status.amazonUrl)) {
        return true;
    }

    if (platform === 'qobuz' && (status.qobuzId || status.qobuzUrl)) {
        return true;
    }

    if (platform === 'apple' && (status.appleId || status.appleUrl)) {
        return true;
    }

    const rowSource = getRowTrackSource(row);
    const sourceUrl = String(row.dataset.availabilityUrl || '').trim();
    if (platform === 'spotify'
        && rowSource === 'spotify'
        && (row.dataset.availabilitySpotifyId || extractSpotifyTrackId(sourceUrl))) {
        return true;
    }

    if (platform === 'deezer'
        && rowSource === 'deezer'
        && row.dataset.availabilityDeezerId) {
        return true;
    }

    if (platform === 'tidal'
        && rowSource === 'tidal'
        && row.dataset.availabilityTidalId) {
        return true;
    }

    if (platform === 'qobuz'
        && rowSource === 'qobuz'
        && row.dataset.availabilityQobuzId) {
        return true;
    }

    if (platform === 'apple'
        && rowSource === 'apple'
        && row.dataset.availabilityAppleId) {
        return true;
    }

    if (platform === 'amazon'
        && (rowSource === 'amazon' || rowSource === 'amazonmusic')
        && row.dataset.availabilityAmazonId) {
        return true;
    }

    return status[platform] === false ? false : undefined;
}

function isDeezerSource() {
    return (currentTracklistMeta?.source || tracklistSource || '').toLowerCase() === 'deezer';
}

function isSpotifySource() {
    return (currentTracklistMeta?.source || tracklistSource || requestSource || '').toLowerCase() === 'spotify';
}

function updateAvailabilityTag(container, platform, available) {
    const tag = container.querySelector(`[data-platform="${platform}"]`);
    if (!tag) {
        return;
    }
    tag.classList.remove('is-loading', 'is-available', 'is-unavailable');
    if (available === true) {
        tag.classList.add('is-available');
    } else if (available === false) {
        tag.classList.add('is-unavailable');
    } else {
        tag.classList.add('is-loading');
    }
}

function extractSpotifyTrackId(value) {
    if (!value) {
        return '';
    }
    const trimmed = value.trim();
    if (trimmed.startsWith('spotify:track:')) {
        return trimmed.split(':')[2] || '';
    }
    const match = trimmed.match(/open\.spotify\.com\/track\/([a-zA-Z0-9]+)/);
    if (match && match[1]) {
        return match[1];
    }
    return '';
}

function getSpotifyTrackId(track) {
    if (!track) {
        return '';
    }
    if (track.spotifyId) {
        return track.spotifyId;
    }
    return extractSpotifyTrackId(track.link || track.sourceUrl || '');
}

function resolveTrackPlatformIds(track, spotifyIdOverride = '') {
    if (!track) {
        return {};
    }

    const currentSource = (tracklistSource || requestSource || '').toLowerCase();
    const deezerIdKeys = currentSource === 'deezer' || currentSource === 'spotify'
        ? ['deezerId', 'deezer_id', 'id']
        : ['deezerId', 'deezer_id'];
    const appleIdKeys = currentSource === 'apple'
        ? ['appleId', 'apple_id', 'id']
        : ['appleId', 'apple_id'];
    const tidalIdKeys = currentSource === 'tidal'
        ? ['tidalId', 'tidal_id', 'id']
        : ['tidalId', 'tidal_id'];
    const qobuzIdKeys = currentSource === 'qobuz'
        ? ['qobuzId', 'qobuz_id', 'id']
        : ['qobuzId', 'qobuz_id'];

    const deezerId = firstTrackValue(track, deezerIdKeys);
    return {
        deezerId: /^\d+$/.test(deezerId) ? deezerId : '',
        spotifyId: spotifyIdOverride || firstTrackValue(track, ['spotifyId', 'spotify_id']) || extractSpotifyTrackId(track.link || track.sourceUrl || ''),
        appleId: firstTrackValue(track, appleIdKeys),
        tidalId: firstTrackValue(track, tidalIdKeys),
        qobuzId: firstTrackValue(track, qobuzIdKeys),
        amazonId: firstTrackValue(track, ['amazonId', 'amazon_id', 'amazonMusicId', 'amazon_music_id'])
    };
}

function firstTrackValue(track, keys) {
    for (const key of keys) {
        const value = String(track?.[key] || '').trim();
        if (value) {
            return value;
        }
    }
    return '';
}

function isBoomplayTracklistSource() {
    const source = (requestSource || tracklistSource || '').toLowerCase();
    return source === 'boomplay';
}

function normalizeBoomplayLabelForDisplay(value, options = {}) {
    if (!value) {
        return '';
    }

    let cleaned = String(value)
        .replace(/[\u0000-\u001F\u007F]/g, ' ')
        .replace(/\u00A0/g, ' ')
        .trim();

    if (!cleaned) {
        return '';
    }

    const isArtist = options?.isArtist === true;
    const artist = String(options?.artist || '').trim();

    if (!isArtist && artist) {
        const lower = cleaned.toLowerCase();
        const artistLower = artist.toLowerCase();
        if (lower.startsWith(`${artistLower} - `)) {
            cleaned = cleaned.slice(artist.length + 3).trim();
        } else if (lower.startsWith(`${artistLower} – `)) {
            cleaned = cleaned.slice(artist.length + 3).trim();
        }
    }

    cleaned = cleaned
        .replace(/([A-Za-z])_([A-Za-z])/g, '$1 $2')
        .replace(/[_]{2,}/g, ' ')
        .replace(/\s*[\(\[]\s*master\s*[\)\]]\s*$/i, '')
        .replace(/\s*-\s*master\s*$/i, '')
        .replace(/\s*[!\x40#$%^&*+=~`|<>]{2,}\s*$/g, '')
        .replace(/\s*[\.\-_,]{2,}\s*$/g, '')
        .replace(/\s+/g, ' ')
        .trim();

    return cleaned || String(value).trim();
}

function renderTrackTitleHtml(track) {
    const cover = normalizeCoverUrl(track.album?.cover_medium);
    const explicit = track.explicit_lyrics;
    const rawTitle = track.title || 'Loading…';
    const rawArtist = resolveArtistName(track);
    const titleText = isBoomplayTracklistSource()
        ? normalizeBoomplayLabelForDisplay(rawTitle, { artist: rawArtist })
        : rawTitle;
    const isMobileView = window.matchMedia && window.matchMedia('(max-width: 640px)').matches;
    const showCover = cover && (isMobileView || useUnifiedTracklistView || tracklistType === 'playlist' || tracklistIsAtmosView || isDeezerSource());
    return `
        <span class="track-title-content">
            ${showCover
                ? `<img class="track-album-art" src="${cover}" alt="" loading="lazy">`
                : ''}
            ${explicit ? '<span class="material-icons track-explicit">explicit</span>' : ''}
            <span class="track-title-text">${escapeHtml(titleText)}</span>
        </span>
    `;
}

function resolveArtistName(track) {
    if (!track) {
        return 'Unknown';
    }
    if (track.artist && typeof track.artist === 'object' && track.artist.name) {
        return track.artist.name;
    }
    if (typeof track.artist === 'string') {
        return track.artist;
    }
    if (typeof track.artists === 'string') {
        return track.artists;
    }
    if (Array.isArray(track.artists)) {
        return track.artists.filter(Boolean).join(', ');
    }
    if (track.artist_name) {
        return track.artist_name;
    }
    return 'Unknown';
}

function normalizeDeezerPlaybackContext(context) {
    if (!window.DeezerPlaybackContext || typeof window.DeezerPlaybackContext.normalize !== 'function') {
        return null;
    }
    return window.DeezerPlaybackContext.normalize(context);
}

function extractDeezerPlaybackContextFromTrack(track) {
    return normalizeDeezerPlaybackContext(track || {});
}

function getRowPlaybackTypeHint(row) {
    const contentType = String(row?.querySelector('.track-checkbox')?.dataset.trackContentType || '').trim().toLowerCase();
    if (contentType === 'podcast' || isPodcastTracklistContext()) {
        return 'episode';
    }
    return '';
}

function buildDeezerStreamUrl(deezerId, options = {}) {
    if (!window.DeezerPlaybackContext || typeof window.DeezerPlaybackContext.buildStreamUrl !== 'function') {
        return '';
    }
    return window.DeezerPlaybackContext.buildStreamUrl(deezerId, options);
}

function getDeezerPlaybackContextForRow(row, deezerId = '') {
    if (!row) {
        return null;
    }

    const inlineContext = normalizeDeezerPlaybackContext({
        streamTrackId: row.dataset.streamTrackId || '',
        trackToken: row.dataset.trackToken || '',
        md5origin: row.dataset.md5Origin || row.dataset.md5origin || '',
        mv: row.dataset.mediaVersion || ''
    });
    if (inlineContext) {
        return inlineContext;
    }

    const normalizedId = String(deezerId || row.dataset.availabilityDeezerId || row.querySelector('.track-checkbox')?.dataset.trackId || '').trim();
    if (!normalizedId) {
        return null;
    }

    const cached = deezerPlaybackContextCache.get(normalizedId) || null;
    return normalizeDeezerPlaybackContext(cached);
}

function setDeezerPlaybackContextOnRow(row, deezerId, context) {
    const normalizedContext = normalizeDeezerPlaybackContext(context);
    if (!row || !normalizedContext) {
        return;
    }

    const normalizedId = String(deezerId || row.dataset.availabilityDeezerId || row.querySelector('.track-checkbox')?.dataset.trackId || '').trim();
    if (normalizedId) {
        deezerPlaybackContextCache.set(normalizedId, normalizedContext);
    }

    row.dataset.streamTrackId = normalizedContext.streamTrackId;
    row.dataset.trackToken = normalizedContext.trackToken;
    row.dataset.md5Origin = normalizedContext.md5origin || '';
    row.dataset.mediaVersion = normalizedContext.mv || '';

    const checkbox = row.querySelector('.track-checkbox');
    if (checkbox) {
        checkbox.dataset.streamTrackId = normalizedContext.streamTrackId;
        checkbox.dataset.trackToken = normalizedContext.trackToken;
        checkbox.dataset.md5Origin = normalizedContext.md5origin || '';
        checkbox.dataset.mediaVersion = normalizedContext.mv || '';
    }

    const previewControl = row.querySelector('.preview-controls');
    if (previewControl && normalizedId) {
        previewControl.setAttribute('data-preview', buildDeezerStreamUrl(normalizedId, {
            type: getRowPlaybackTypeHint(row),
            context: normalizedContext
        }));
    }

    updateMatchedRowPreviewControl(row, normalizedId);
}

async function fetchDeezerPlaybackContext(deezerId) {
    if (!window.DeezerPlaybackContext || typeof window.DeezerPlaybackContext.fetchContext !== 'function') {
        return null;
    }
    return await window.DeezerPlaybackContext.fetchContext(deezerId, {
        cache: deezerPlaybackContextCache,
        requests: deezerPlaybackContextRequests
    });
}

async function ensureDeezerPlaybackContextForRow(row, deezerId) {
    if (!row) {
        return null;
    }

    const normalizedId = String(deezerId || '').trim();
    if (!normalizedId || !/^\d+$/.test(normalizedId)) {
        return null;
    }

    const existing = getDeezerPlaybackContextForRow(row, normalizedId);
    if (existing) {
        setDeezerPlaybackContextOnRow(row, normalizedId, existing);
        return existing;
    }

    const context = await fetchDeezerPlaybackContext(normalizedId);
    if (!context) {
        return null;
    }

    setDeezerPlaybackContextOnRow(row, normalizedId, context);
    return context;
}

function preloadDeezerPlaybackContextsForVisibleRows(limit = 48) {
    const rows = Array.from(document.querySelectorAll('#tracks-table-body tr[data-track-index]'));
    preloadDeezerPlaybackContextsForRows(rows, limit);
}

function preloadDeezerPlaybackContextsForRows(rows, limit = 48) {
    if (!Array.isArray(rows) || rows.length === 0) {
        return;
    }
    const targets = [];
    for (const row of rows) {
        if (targets.length >= limit) {
            break;
        }
        const deezerId = String(row.querySelector('.track-checkbox')?.dataset.trackId || row.dataset.availabilityDeezerId || '').trim();
        if (!deezerId || !/^\d+$/.test(deezerId)) {
            continue;
        }
        const existing = getDeezerPlaybackContextForRow(row, deezerId);
        if (existing) {
            setDeezerPlaybackContextOnRow(row, deezerId, existing);
            continue;
        }
        const previewControl = row.querySelector('.preview-controls');
        if (previewControl) {
            targets.push(previewControl);
        }
    }

    if (!targets.length) {
        return;
    }

    if (window.DeezerPlaybackContext?.primePlaybackTargets) {
        void window.DeezerPlaybackContext.primePlaybackTargets(targets, {
            includeSession: true,
            cache: deezerPlaybackContextCache,
            requests: deezerPlaybackContextRequests
        });
        return;
    }

    const concurrency = 4;
    let cursor = 0;
    const workers = Array.from({ length: Math.min(concurrency, targets.length) }, async () => {
        while (cursor < targets.length) {
            const target = targets[cursor++];
            const row = target?.closest?.('tr');
            const deezerId = String(row?.querySelector('.track-checkbox')?.dataset.trackId || row?.dataset.availabilityDeezerId || '').trim();
            if (!row || !deezerId) {
                continue;
            }
            await ensureDeezerPlaybackContextForRow(row, deezerId);
        }
    });

    void Promise.all(workers);
}

function renderTrackRows(tracks, isPlaylistLike, isLocalSource, fallbackAlbumTitle) {
    if (!tracks || tracks.length === 0) {
        return '';
    }

    const playbackSource = normalizeTrackRowPlaybackSource(requestSource || tracklistSource || 'deezer');
    const isPodcastShow = String(tracklistType || '').toLowerCase() === 'show';
    const forceFullStream = playbackSource === 'deezer' || isDeezerSource();
    const resolveExternalDeezerId = (track) => {
        if (!track) {
            return '';
        }

        if (playbackSource === 'apple') {
            const mappedAppleDeezerId = String(track.deezerId || track.deezer_id || '').trim();
            return /^\d+$/.test(mappedAppleDeezerId) ? mappedAppleDeezerId : '';
        }

        const candidate = playbackSource === 'spotify'
            ? String(track.deezerId || track.deezer_id || track.id || '').trim()
            : String(track.deezerId || track.deezer_id || '').trim();
        return /^\d+$/.test(candidate) ? candidate : '';
    };
    tracks.forEach((track) => {
        if (!track.id && !track.deezerId && !track.deezer_id) {
            return;
        }
        if (playbackSource === 'apple' && (track.hasAtmos || track.isVideo)) {
            return;
        }
        if (playbackSource !== 'apple') {
            const deezerCandidate = resolveExternalDeezerId(track);
            if (deezerCandidate) {
                const playbackContext = extractDeezerPlaybackContextFromTrack(track);
                if (playbackContext) {
                    deezerPlaybackContextCache.set(deezerCandidate, playbackContext);
                }
                track.preview = buildDeezerStreamUrl(deezerCandidate, {
                    type: isPodcastShow ? 'episode' : '',
                    context: playbackContext
                });
            }
        }
    });

    const shouldShowIgnore = isPlaylistLike && !isLocalSource && currentTracklistMeta?.source && watchlistIgnoreEnabled;
    const ignoreToggleClass = shouldShowIgnore ? '' : 'is-hidden';
    const isSpotifyExternalSource = playbackSource === 'spotify';
    const isBoomplayExternalSource = playbackSource === 'boomplay';
    const isRecommendationSource = isRecommendationTracklistContext();
    const isGenericExternalSource = playbackSource === 'youtube'
        || playbackSource === 'soundcloud'
        || playbackSource === 'tidal'
        || playbackSource === 'qobuz'
        || playbackSource === 'amazon'
        || playbackSource === 'bandcamp'
        || playbackSource === 'pandora';

    return tracks.map((track, index) => {
        const spotifyId = getSpotifyTrackId(track);
        const artistIdsRaw = track.artist_ids ?? track.artistIds;
        const artistId = track.artist?.id || (Array.isArray(artistIdsRaw) ? artistIdsRaw[0] : artistIdsRaw) || '';
        const artistName = resolveArtistName(track);
        const artistDisplayName = isBoomplayTracklistSource()
            ? normalizeBoomplayLabelForDisplay(artistName, { isArtist: true })
            : artistName;
        const albumId = track.album?.id || track.album_id || track.albumId || '';
        const availabilityKey = buildAvailabilityKeyFromTrack(track, spotifyId);
        const availabilityKeyAttr = availabilityKey ? ` data-availability-key="${availabilityKey}"` : '';
        const availabilitySpotifyAttr = spotifyId ? ` data-availability-spotify-id="${spotifyId}"` : '';
        const platformIds = resolveTrackPlatformIds(track, spotifyId);
        const availabilityAppleAttr = platformIds.appleId ? ` data-availability-apple-id="${escapeHtml(platformIds.appleId)}"` : '';
        const availabilityTidalAttr = platformIds.tidalId ? ` data-availability-tidal-id="${escapeHtml(platformIds.tidalId)}"` : '';
        const availabilityQobuzAttr = platformIds.qobuzId ? ` data-availability-qobuz-id="${escapeHtml(platformIds.qobuzId)}"` : '';
        const availabilityAmazonAttr = platformIds.amazonId ? ` data-availability-amazon-id="${escapeHtml(platformIds.amazonId)}"` : '';
        const availabilityUrlAttr = track.link ? ` data-availability-url="${escapeHtml(track.link)}"` : '';
        const availabilityIsrcAttr = track.isrc ? ` data-availability-isrc="${escapeHtml(track.isrc)}"` : '';
        const availabilityTitleAttr = track.title ? ` data-availability-title="${escapeHtml(track.title)}"` : '';
        const availabilityArtistAttr = artistName ? ` data-availability-artist="${escapeHtml(artistName)}"` : '';
        const durationSeconds = resolveTrackDurationSeconds(track);
        const availabilityDurationAttr = durationSeconds > 0 ? ` data-availability-duration="${Math.round(durationSeconds * 1000)}"` : '';
        const deezerId = playbackSource === 'deezer'
            ? String(track.deezerId || track.deezer_id || track.id || '').trim()
            : resolveExternalDeezerId(track);
        const availabilityDeezerAttr = deezerId ? ` data-availability-deezer-id="${escapeHtml(deezerId)}"` : '';
        const playbackContext = extractDeezerPlaybackContextFromTrack(track);
        if (deezerId && playbackContext) {
            deezerPlaybackContextCache.set(deezerId, playbackContext);
        }
        const streamTrackIdAttr = playbackContext?.streamTrackId
            ? ` data-stream-track-id="${escapeHtml(playbackContext.streamTrackId)}"`
            : '';
        const trackTokenAttr = playbackContext?.trackToken
            ? ` data-track-token="${escapeHtml(playbackContext.trackToken)}"`
            : '';
        const md5OriginAttr = playbackContext?.md5origin
            ? ` data-md5-origin="${escapeHtml(playbackContext.md5origin)}"`
            : '';
        const mediaVersionAttr = playbackContext?.mv
            ? ` data-media-version="${escapeHtml(playbackContext.mv)}"`
            : '';
        const isDeadSpotifyRow = isSpotifyExternalSource && !deezerId;
        const isDeadBoomplayRow = isBoomplayExternalSource && !deezerId;
        const isDeadGenericExternalRow = isGenericExternalSource && !deezerId;
        const supportsOnDemandMatch = isDeezerMatchedExternalSource(playbackSource);
        const hasResolvableExternalLink = !!String(track.link || track.sourceUrl || track.appleUrl || '').trim()
            || (isSpotifyExternalSource && !!spotifyId);
        const isPendingExternalRow = (isDeadSpotifyRow || isDeadBoomplayRow || isDeadGenericExternalRow)
            && supportsOnDemandMatch
            && hasResolvableExternalLink;
        const isDeadExternalRow = isDeadSpotifyRow || isDeadBoomplayRow || isDeadGenericExternalRow;
        const rowSourceAttr = escapeHtml(playbackSource);
        const rowClass = isDeadExternalRow ? ' class="track-row-dead"' : '';
        const checkboxDisabledAttr = isDeadExternalRow ? ' disabled aria-disabled="true" title="Waiting for Deezer match"' : ' title="Select track"';
        const recommendationRejectButton = isRecommendationSource
            ? `<button class="track-recommendation-reject-btn" type="button"
                    data-recommendation-track-id="${escapeHtml(track.id || deezerId || '')}"
                    data-recommendation-track-isrc="${escapeHtml(track.isrc || '')}"
                    data-recommendation-track-title="${escapeHtml(track.title || '')}"
                    data-recommendation-track-artist="${escapeHtml(artistName || '')}"
                    title="Not interested"
                    aria-label="Not interested">
                    <span class="material-icons" aria-hidden="true">close</span>
                </button>`
            : '';
        const requiresPreparedExternalPreview = isDeezerMatchedExternalSource(playbackSource)
            && !!deezerId
            && !playbackContext;
        const previewUrl = playbackSource === 'apple'
            ? (String(track.preview || '').trim()
                || (deezerId
                    ? buildDeezerStreamUrl(deezerId, {
                        type: isPodcastShow ? 'episode' : '',
                        context: playbackContext
                    })
                    : ''))
            : (deezerId && !requiresPreparedExternalPreview
                ? buildDeezerStreamUrl(deezerId, {
                    type: isPodcastShow ? 'episode' : '',
                    context: playbackContext
                })
                : (track.preview || ''));
        const hasPreview = !!previewUrl;
        const isPreparingExternalPreview = !hasPreview && requiresPreparedExternalPreview;
        const isPendingPreview = !hasPreview && (isPendingExternalRow || isPreparingExternalPreview);
        const previewClass = hasPreview ? '' : (isPendingPreview ? ' is-pending' : ' is-disabled');
        const previewLabel = hasPreview
            ? (isPodcastShow ? 'Play Episode' : 'Play Track')
            : (isPreparingExternalPreview
                ? 'Preparing Deezer playback'
                : (isPendingExternalRow ? 'Resolving Deezer match' : 'No Deezer match'));
        const albumTitle = escapeHtml(track.album?.title || fallbackAlbumTitle || 'Unknown');
        const collectionCell = isPlaylistLike
            ? (isPodcastShow
                ? `<td class="track-album"><span class="track-cell-text">${albumTitle}</span></td>`
                : `<td class="track-album" onclick="openAlbum('${albumId}')"><span class="track-cell-text">${albumTitle}</span></td>`)
            : '';
        return `
        <tr${rowClass} data-track-index="${track.index ?? index}" data-track-source="${rowSourceAttr}"${spotifyId ? ` data-spotify-id="${spotifyId}"` : ''}${availabilityKeyAttr}${availabilitySpotifyAttr}${availabilityAppleAttr}${availabilityTidalAttr}${availabilityQobuzAttr}${availabilityAmazonAttr}${availabilityUrlAttr}${availabilityIsrcAttr}${availabilityTitleAttr}${availabilityArtistAttr}${availabilityDurationAttr}${availabilityDeezerAttr}${streamTrackIdAttr}${trackTokenAttr}${md5OriginAttr}${mediaVersionAttr}>
            <td class="track-number">
                <span class="track-num">${track.track_position || index + 1}</span>
                <span class="material-icons preview-controls${previewClass}"
                      data-preview="${previewUrl}"
                      data-link-only="${track.link || ''}"
                      onclick="playPausePreview(this)"
                      title="${previewLabel}">
                    play_arrow
                </span>
            </td>
            <td class="track-title">
                ${renderTrackTitleHtml(track)}
            </td>
            <td class="track-artist" onclick="openArtist('${artistId}')"><span class="track-cell-text">${escapeHtml(artistDisplayName)}</span></td>
            ${collectionCell}
            ${shouldShowQualityColumn() ? `<td class="track-quality">${renderQualityCell(track)}</td>` : ''}
            <td class="track-duration">${formatTrackDurationSeconds(durationSeconds)}</td>
            ${shouldShowMonitoredStateColumn(isLocalSource) ? `<td class="track-location-status">${renderTrackLocationStatusCell(resolveMonitoredTrackLocationStatus(track, playbackSource))}</td>` : ''}
            ${shouldShowAvailabilityColumn(isLocalSource) ? `<td class="track-availability">${renderAvailabilityCell()}</td>` : ''}
            <td class="track-actions">
                <div class="track-actions-row">
	                   ${isLocalSource ? '' : `<input type="checkbox" class="track-checkbox"
	                           data-track-id="${deezerId}"
                               data-track-content-type="${isPodcastShow ? 'podcast' : 'track'}"
	                           data-track-source="${rowSourceAttr}"
	                           data-spotify-id="${spotifyId || ''}"
	                           data-tidal-id="${escapeHtml(platformIds.tidalId || '')}"
	                           data-qobuz-id="${escapeHtml(platformIds.qobuzId || '')}"
	                           data-amazon-id="${escapeHtml(platformIds.amazonId || '')}"
	                           data-track-link="${track.link || track.sourceUrl || track.appleUrl || ''}"
	                           data-track-title="${escapeHtml(track.title || '')}"
	                           data-track-artist="${escapeHtml(artistName || '')}"
	                           data-track-album="${escapeHtml(track.album?.title || fallbackAlbumTitle || '')}"
	                           data-track-album-id="${escapeHtml(albumId || '')}"
	                           data-track-artist-id="${escapeHtml(artistId || '')}"
			                           data-track-cover="${escapeHtml(normalizeCoverUrl(track.album?.cover_medium || ''))}"
		                           data-track-isrc="${escapeHtml(track.isrc || '')}"
                               data-stream-track-id="${escapeHtml(playbackContext?.streamTrackId || '')}"
                               data-track-token="${escapeHtml(playbackContext?.trackToken || '')}"
                               data-md5-origin="${escapeHtml(playbackContext?.md5origin || '')}"
                               data-media-version="${escapeHtml(playbackContext?.mv || '')}"
                           data-track-has-atmos="${isAtmosTrackRow(track) ? 'true' : 'false'}"
                           data-track-has-apple-digital-master="${track.hasAppleDigitalMaster ? 'true' : 'false'}"
                           data-track-is-video="${track.isVideo ? 'true' : 'false'}"
                           data-track-duration-ms="${durationSeconds > 0 ? durationSeconds * 1000 : 0}"
                           data-track-position="${track.track_position || index + 1}"${checkboxDisabledAttr}>`}
                    <button class="track-ignore-btn ${ignoreToggleClass}" type="button"
                        data-ignore-track-id="${track.id}"
                        data-ignore-track-isrc="${escapeHtml(track.isrc || '')}"
                        title="${isPodcastShow ? 'Ignore episode' : 'Ignore track'}">Ignore</button>
                    ${recommendationRejectButton}
                </div>
            </td>
            ${shouldShowQuickDownloadColumn(isLocalSource) ? `<td class="track-quick-download">
                <button class="track-quick-download-btn" type="button"
                    onclick="downloadSingleTrackFromRow(this)"
                    title="${isPodcastShow ? 'Download episode' : 'Download track'}"
                    aria-label="${isPodcastShow ? 'Download episode' : 'Download track'}">
                    <span class="material-icons" aria-hidden="true">file_download</span>
                </button>
            </td>` : ''}
        </tr>
    `;
    }).join('');
}

function renderTracksTable(tracks, isPlaylistLike, isLocalSource, fallbackAlbumTitle, options = {}) {
    const allowEmptyTracks = options?.allowEmptyTracks === true;
    const rows = renderTrackRows(tracks, isPlaylistLike, isLocalSource, fallbackAlbumTitle);
    if (!rows && !allowEmptyTracks) {
        return `<div class="error">${tracklistType === 'show' ? 'No episodes available' : 'No tracks available'}</div>`;
    }

    const columnCount = getTracklistColumnCount(isPlaylistLike, isLocalSource);
    const shouldShowIgnore = isPlaylistLike && !isLocalSource && currentTracklistMeta?.source && watchlistIgnoreEnabled;
    const ignoreToggleClass = shouldShowIgnore ? '' : 'is-hidden';
    const collectionHeaderLabel = tracklistType === 'show' ? 'Podcast' : 'Album';
    const ignoreToggleTitle = tracklistType === 'show' ? 'Ignore episode' : 'Ignore track';
    const isPodcastTable = tracklistType === 'show' || tracklistType === 'episode';
    const emptyRow = rows
        ? rows
        : `<tr class="tracks-loading"><td colspan="${columnCount}">Loading tracks…</td></tr>`;

    return `
        <div class="tracks-table-wrap">
        <table class="tracks-table${shouldShowIgnore ? ' tracks-table--with-ignore' : ''}${isPlaylistLike ? ' tracks-table--playlistlike' : ''}${isPodcastTable ? ' tracks-table--podcast' : ''}">
            <colgroup>
                <col class="col-number">
                <col class="col-title">
                <col class="col-artist">
                ${isPlaylistLike ? '<col class="col-album">' : ''}
                ${shouldShowQualityColumn() ? '<col class="col-quality">' : ''}
                <col class="col-duration">
                ${shouldShowMonitoredStateColumn(isLocalSource) ? '<col class="col-location-status">' : ''}
                ${shouldShowAvailabilityColumn(isLocalSource) ? '<col class="col-availability">' : ''}
                <col class="col-actions">
                ${shouldShowQuickDownloadColumn(isLocalSource) ? '<col class="col-quick-download">' : ''}
            </colgroup>
            <thead>
                <tr>
                    <th class="track-number">#</th>
                    <th>Title</th>
                    <th>Artist</th>
                    ${isPlaylistLike ? `<th>${collectionHeaderLabel}</th>` : ''}
                    ${shouldShowQualityColumn() ? '<th class="track-quality">Quality</th>' : ''}
                    <th class="track-duration">
                        <span class="material-icons">timer</span>
                    </th>
                    ${shouldShowMonitoredStateColumn(isLocalSource) ? '<th class="track-location-status">State</th>' : ''}
                    ${shouldShowAvailabilityColumn(isLocalSource) ? '<th class="track-availability">Availability</th>' : ''}
                    <th class="track-actions">
                        <div class="track-actions-row">
                            ${isLocalSource ? '' : '<input type="checkbox" class="track-checkbox" onchange="toggleAllTracks(this)" title="Select All">'}
                            <span class="material-icons track-ignore-toggle ${ignoreToggleClass}" title="${ignoreToggleTitle}">visibility_off</span>
                        </div>
                    </th>
                    ${shouldShowQuickDownloadColumn(isLocalSource) ? '<th class="track-quick-download"><span class="material-icons" title="Download">file_download</span></th>' : ''}
                </tr>
            </thead>
            <tbody id="tracks-table-body">
                ${emptyRow}
            </tbody>
        </table>
        </div>
    `;
}

function renderQualityCell(track) {
    if (!isAtmosTrackRow(track)) return '';
    const depth = track.bitDepth || '24B';
    const rate = track.sampleRate || '48kHz';
    const qualityText = [depth, rate].filter(Boolean).join(' · ');
    return `
        <div class="quality-tags">
            <span class="quality-strip">
                <span class="quality-icon lossless-icon" aria-label="Lossless"></span>
                <span class="quality-text">${escapeHtml(qualityText)}</span>
                <span class="quality-icon atmos-icon" aria-label="Dolby Atmos"></span>
            </span>
        </div>`;
}

function formatTrackDurationSeconds(seconds) {
    const normalizedSeconds = Number(seconds);
    if (!Number.isFinite(normalizedSeconds) || normalizedSeconds <= 0) {
        return '--:--';
    }

    const roundedSeconds = Math.round(normalizedSeconds);
    const minutes = Math.floor(roundedSeconds / 60);
    const remainingSeconds = roundedSeconds % 60;
    return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}`;
}

function resolveTrackDurationSeconds(track) {
    if (!track) {
        return 0;
    }

    const seconds = Number(track.duration || 0);
    if (Number.isFinite(seconds) && seconds > 0) {
        return Math.round(seconds);
    }

    const milliseconds = Number(track.durationMs || track.duration_ms || 0);
    return Number.isFinite(milliseconds) && milliseconds > 0
        ? Math.round(milliseconds / 1000)
        : 0;
}

function resolveTrackDurationMs(track) {
    const seconds = resolveTrackDurationSeconds(track);
    return seconds > 0 ? Math.round(seconds * 1000) : 0;
}

function getTrackRowsByIndices(indices) {
    if (!Array.isArray(indices) || indices.length === 0) {
        return [];
    }

    const rows = [];
    indices.forEach((index) => {
        const row = document.querySelector(`#tracks-table-body tr[data-track-index="${index}"]`);
        if (row) {
            rows.push(row);
        }
    });
    return rows;
}

function applyIgnoredTrackState() {
    const buttons = Array.from(document.querySelectorAll('.track-ignore-btn'));
    applyIgnoredTrackStateForButtons(buttons);
}

function applyIgnoredTrackStateForRows(rows) {
    if (!Array.isArray(rows) || rows.length === 0) {
        return;
    }
    const buttons = rows
        .map(row => row?.querySelector('.track-ignore-btn'))
        .filter(Boolean);
    applyIgnoredTrackStateForButtons(buttons);
}

function applyIgnoredTrackStateForButtons(buttons) {
    if (!ignoredTrackIds || ignoredTrackIds.size === 0 || !Array.isArray(buttons) || buttons.length === 0) {
        return;
    }
    buttons.forEach(button => {
        const trackId = button.getAttribute('data-ignore-track-id');
        if (!trackId) {
            return;
        }
        if (ignoredTrackIds.has(trackId)) {
            button.classList.add('ignored');
            button.textContent = 'Ignored';
            return;
        }
        button.classList.remove('ignored');
        button.textContent = 'Ignore';
    });
}

function bindIgnoreButtons() {
    const playlistSource = currentTracklistMeta?.source;
    const playlistSourceId = currentTracklistMeta?.sourceId;
    if (!playlistSource || !playlistSourceId) {
        return;
    }

    const rows = Array.from(document.querySelectorAll('#tracks-table-body tr[data-track-index]'));
    bindIgnoreButtonsForRows(rows);
}

function bindIgnoreButtonsForRows(rows) {
    const playlistSource = currentTracklistMeta?.source;
    const playlistSourceId = currentTracklistMeta?.sourceId;
    if (!playlistSource || !playlistSourceId || !Array.isArray(rows) || rows.length === 0) {
        return;
    }

    rows.forEach((row) => {
        const button = row?.querySelector('.track-ignore-btn');
        if (!button || button.dataset.ignoreBound === 'true') {
            return;
        }
        button.dataset.ignoreBound = 'true';
        button.addEventListener('click', async () => {
            const trackId = button.getAttribute('data-ignore-track-id');
            const isrc = button.getAttribute('data-ignore-track-isrc') || '';
            if (!trackId) {
                return;
            }

            try {
                if (button.classList.contains('ignored')) {
                    await fetchJson(`/api/library/playlists/${encodeURIComponent(playlistSource)}/${encodeURIComponent(playlistSourceId)}/ignore/${encodeURIComponent(trackId)}`, {
                        method: 'DELETE'
                    });
                    button.classList.remove('ignored');
                    button.textContent = 'Ignore';
                    ignoredTrackIds.delete(trackId);
                } else {
                    await fetchJson(`/api/library/playlists/${encodeURIComponent(playlistSource)}/${encodeURIComponent(playlistSourceId)}/ignore`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            trackSourceId: trackId,
                            isrc: isrc || null
                        })
                    });
                    button.classList.add('ignored');
                    button.textContent = 'Ignored';
                    ignoredTrackIds.add(trackId);
                }
            } catch (error) {
                DeezSpoTag.ui.alert(`Ignore failed: ${error.message}`, { title: 'Ignore Track' });
            }
        });
    });
}

function bindRecommendationRejectButtons() {
    if (!isRecommendationTracklistContext() || !tracklistLibraryId) {
        return;
    }

    const buttons = Array.from(document.querySelectorAll('.track-recommendation-reject-btn'));
    buttons.forEach((button) => {
        if (!button || button.dataset.rejectBound === 'true') {
            return;
        }

        button.dataset.rejectBound = 'true';
        button.addEventListener('click', async () => {
            const trackSourceId = button.getAttribute('data-recommendation-track-id') || '';
            if (!trackSourceId) {
                return;
            }

            button.disabled = true;
            try {
                const payload = await fetchJson('/api/library/recommendations/reject', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        libraryId: Number(tracklistLibraryId),
                        stationId: tracklistId || currentTracklistMeta?.sourceId || '',
                        trackSourceId,
                        isrc: button.getAttribute('data-recommendation-track-isrc') || null,
                        title: button.getAttribute('data-recommendation-track-title') || null,
                        artist: button.getAttribute('data-recommendation-track-artist') || null,
                        limit: 50
                    })
                });

                if (payload?.station && Array.isArray(payload.tracks)) {
                    renderTracklist(mapRecommendationsTracklist(payload));
                    return;
                }

                const row = button.closest('tr');
                if (row) {
                    row.remove();
                }
            } catch (error) {
                button.disabled = false;
                DeezSpoTag.ui.alert(`Recommendation update failed: ${error.message}`, { title: 'Recommendations' });
            }
        });
    });
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

const tracklistPlaybackState = window.DeezerPlaybackState;

function getPreviewVolume() {
    const stored = parseInt(localStorage.getItem('previewVolume') || '', 10);
    if (!Number.isNaN(stored)) {
        return Math.max(0, Math.min(1, stored / 100));
    }
    return 0.8;
}

function resetPreviewControls() {
    document.querySelectorAll('.preview-controls').forEach((el) => {
        el.removeAttribute('playing');
        el.classList.remove('is-starting');
        delete el.dataset.playbackState;
        el.textContent = 'play_arrow';
    });
    document.querySelectorAll('tr.track-row-playing').forEach((row) => {
        row.classList.remove('track-row-playing');
    });
}

function applyTracklistPlayingVisual(control, isPlaying) {
    if (!control) {
        return;
    }

    const row = control.closest('tr');
    if (isPlaying) {
        control.setAttribute('playing', 'true');
        control.textContent = 'pause';
        if (row) {
            row.classList.add('track-row-playing');
        }
        return;
    }

    control.removeAttribute('playing');
    control.textContent = 'play_arrow';
    if (row) {
        row.classList.remove('track-row-playing');
    }
}

function setTracklistPreviewControlState(control, state) {
    if (!control) {
        return;
    }

    const normalized = String(state || '').trim().toLowerCase();
    const row = control.closest('tr');
    if (tracklistPlaybackState && typeof tracklistPlaybackState.transitionButtonState === 'function') {
        tracklistPlaybackState.transitionButtonState(control, normalized, {
            setPlaying: applyTracklistPlayingVisual
        });
    } else {
        applyTracklistPlayingVisual(control, normalized === 'playing');
    }

    if (normalized === 'requested') {
        control.classList.add('is-starting');
        control.textContent = 'pause';
        if (row) {
            row.classList.add('track-row-playing');
        }
        return;
    }

    control.classList.remove('is-starting');
    if (normalized !== 'playing' && row) {
        row.classList.remove('track-row-playing');
    }
}

function isPlayableTracklistPreviewControl(control) {
    if (!control) {
        return false;
    }

    const row = control.closest('tr');
    if (!row || row.classList.contains('track-row-dead')) {
        return false;
    }

    if (control.classList.contains('is-disabled') || control.classList.contains('is-pending')) {
        return false;
    }

    return !!String(control.getAttribute('data-preview') || '').trim();
}

function buildTracklistPlaybackRequest(control) {
    if (!control) {
        return null;
    }

    const row = control.closest('tr');
    const deezerId = String(row?.querySelector('.track-checkbox')?.dataset.trackId || row?.dataset.availabilityDeezerId || '').trim();
    const previewUrl = String(control.getAttribute('data-preview') || '').trim();
    const initialKey = deezerId
        ? `deezer:${deezerId}`
        : (previewUrl ? `preview:${previewUrl}` : `tracklist:${row?.dataset?.availabilityKey || ''}`);

    return {
        page: 'tracklist',
        button: control,
        key: initialKey,
        volume: getPreviewVolume(),
        sourceKey: initialKey,
        startFailedMessage: 'Playback failed for this track.',
        interruptedMessage: 'Playback failed for this track.',
        unavailableMessage: 'Preview unavailable.',
        onStateChange: (state) => {
            setTracklistPreviewControlState(control, state === 'ended' ? 'idle' : state);
        },
        resolve: async () => {
            let resolvedPreviewUrl = String(control.getAttribute('data-preview') || '').trim();
            const linkOnly = String(control.getAttribute('data-link-only') || '').trim();
            const currentRow = control.closest('tr');
            if (!currentRow) {
                return { url: '', silentUnavailable: true };
            }

            if (!resolvedPreviewUrl) {
                const source = getRowTrackSource(currentRow);
                if (isDeezerMatchedExternalSource(source) && window.DeezSpoTag?.ui?.showToast) {
                    const currentDeezerId = String(currentRow.querySelector('.track-checkbox')?.dataset.trackId || currentRow.dataset.availabilityDeezerId || '').trim();
                    DeezSpoTag.ui.showToast(currentDeezerId
                        ? 'Deezer playback is still preparing for this track.'
                        : 'No Deezer match available yet for this track.', { type: 'warning' });
                    return { url: '', silentUnavailable: true };
                }
                if (linkOnly) {
                    DeezSpoTag.ui.alert('Track not available for streaming.', { title: 'Playback' });
                    return { url: '', silentUnavailable: true };
                }
                return { url: '', silentUnavailable: false };
            }

            const resolvedDeezerId = String(currentRow.querySelector('.track-checkbox')?.dataset.trackId || currentRow.dataset.availabilityDeezerId || '').trim();
            return {
                url: resolvedPreviewUrl,
                deezerId: resolvedDeezerId,
                key: resolvedDeezerId ? `deezer:${resolvedDeezerId}` : `preview:${resolvedPreviewUrl}`
            };
        },
        getNextRequest: () => {
            const currentRow = control.closest('tr');
            const body = currentRow?.parentElement;
            if (!currentRow || !body) {
                return null;
            }
            const rows = Array.from(body.querySelectorAll('tr'));
            const startIndex = rows.indexOf(currentRow);
            if (startIndex === -1) {
                return null;
            }
            for (let i = startIndex + 1; i < rows.length; i += 1) {
                const nextControl = rows[i].querySelector('.preview-controls');
                if (!isPlayableTracklistPreviewControl(nextControl)) {
                    continue;
                }
                return buildTracklistPlaybackRequest(nextControl);
            }
            return null;
        }
    };
}

async function playPausePreview(control) {
    if (!control) {
        return;
    }

    const player = window.DeezerUnifiedPlayback;
    if (!player || typeof player.play !== 'function') {
        return;
    }

    const request = buildTracklistPlaybackRequest(control);
    if (!request) {
        return;
    }

    await player.play(request);
}

