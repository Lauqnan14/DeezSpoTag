<p class="metadata-updater-description tool-card-info">Refresh artist metadata and rotate avatar/background artwork before pushing updates to your selected media server.</p>
<select id="metadata-source-platform">
    <option value="auto" selected>Auto source</option>
    <option value="spotify">Spotify</option>
    <option value="deezer">Deezer</option>
    <option value="apple">Apple Music</option>
    <option value="tidal">Tidal</option>
    <option value="qobuz">Qobuz</option>
    <option value="lastfm">Last.fm</option>
</select>
<select id="metadata-refresh-interval">
    <option value="180">6 months</option>
    <option value="90">3 months</option>
    <option value="30" selected>1 month</option>
    <option value="14">2 weeks</option>
    <option value="7">1 week</option>
    <option value="0">Full refresh</option>
</select>
<div id="metadata-target-server" class="metadata-target-checkboxes" role="group" aria-label="Target servers">
    <label class="metadata-updater-option">
        <input type="checkbox" data-metadata-target="plex" checked />
        <span>Plex</span>
    </label>
    <label class="metadata-updater-option">
        <input type="checkbox" data-metadata-target="jellyfin" />
        <span>Jellyfin</span>
    </label>
    <label class="metadata-updater-option">
        <input type="checkbox" data-metadata-target="navidrome" />
        <span>Navidrome</span>
    </label>
</div>
<label class="metadata-updater-option">
    <input type="checkbox" id="metadata-include-popular-songs" />
    <span>Sync popular songs</span>
</label>
<label class="metadata-updater-option">
    <input type="checkbox" id="metadata-ocr-text-art-blocking" checked />
    <span>Block artwork with text</span>
</label>
