@inject DeezSpoTag.Web.Services.AppInstanceIdProvider AppInstanceIdProvider
@{
    var includeSignalR = ViewData["IncludeSignalR"] as bool? ?? false;
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
        integrity="sha512-VK2zcvntEufaimc+efOYi622VN5ZacdnufnmX7zIhCPmjhKnOi9ZDMtg1/ug5l183f19gG1/cBstPO4D8N/Img=="
        crossorigin="anonymous"></script>
@if (includeSignalR)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"
            integrity="sha512-ZqjBuyHOJ5inr58y0trfRo8TgD0zC0WJROOUmgjAIA6iiqXxobgj3ZocloB2Wp9ov2+LB9UM09aiwI3MDpm5HA=="
            crossorigin="anonymous"></script>
}
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/themes.js")"></script>
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/site.js")"></script>
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/tab-preferences.js")"></script>
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/deezer-playback-context.js")"></script>
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/deezer-resolver.js")"></script>
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/deezer-playback-facade.js")"></script>
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/deezer-playback-state.js")"></script>
<script src="@AssetUrl.Versioned(ViewContext, Url, "~/js/deezer-unified-playback.js")"></script>
<script>
    window.DeezSpoTagAppInstanceId = '@AppInstanceIdProvider.InstanceId';
</script>
