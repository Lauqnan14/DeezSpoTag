@using Microsoft.AspNetCore.Identity
@using DeezSpoTag.Web.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link" href="/Identity/Account/Manage" title="Manage">@User.Identity?.Name</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" method="post" action="/Identity/Account/Logout?returnUrl=%2FIdentity%2FAccount%2FLogin">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-link btn btn-link">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" href="/Identity/Account/Login">Login</a>
    </li>
}
</ul>
