<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>DeezSpoTag Web</AssemblyTitle>
    <AssemblyDescription>DeezSpoTag Frontend UI</AssemblyDescription>
    <Copyright>Copyright © 2025</Copyright>
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SixLabors.Fonts" Version="3.2.0" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.1.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="z440.atl.core" Version="7.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeezSpoTag.Core\DeezSpoTag.Core.csproj" />
    <ProjectReference Include="..\DeezSpoTag.Integrations\DeezSpoTag.Integrations.csproj" />
    <ProjectReference Include="..\DeezSpoTag.Services\DeezSpoTag.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Guard against accidental nested project folder artifacts (DeezSpoTag.Web/DeezSpoTag.Web/*). -->
    <None Remove="DeezSpoTag.Web\**" />
    <Content Remove="DeezSpoTag.Web\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Tools/youtube_playback_runtime/**/*" />
    <Content Include="Tools/youtube_playback_runtime/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Tools\vibe_analyzer.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Tools\models\*.pb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Tools\models\%(Filename)%(Extension)</Link>
    </Content>
    <Content Update="Tools\models\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Tools\models\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Tools/shazam_related/**/*" />
    <Content Include="Tools/shazam_related/runtime.mjs;Tools/shazam_related/LICENSE;Tools/shazam_related/README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ShazamRelatedSources Include="Tools/shazam_related/runtime.ts;Tools/shazam_related/sap/**/*;Tools/shazam_related/package.json;Tools/shazam_related/package-lock.json" />
  </ItemGroup>
  <Target Name="BuildShazamRelatedRuntime" BeforeTargets="PrepareForBuild"
          Condition="'$(ShazamHelperPrebuilt)' != 'true'"
          Inputs="@(ShazamRelatedSources)" Outputs="$(MSBuildProjectDirectory)/Tools/shazam_related/runtime.mjs">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/Tools/shazam_related" Command="npm ci --ignore-scripts --no-audit --no-fund &amp;&amp; npm run build" />
  </Target>

  <UsingTask TaskName="NormalizeRazorGeneratedFields"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <GeneratedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs"><![CDATA[
foreach (var generatedFile in GeneratedFiles ?? Array.Empty<ITaskItem>())
{
    var path = generatedFile.ItemSpec;
    if (string.IsNullOrWhiteSpace(path) || !File.Exists(path))
    {
        continue;
    }

    var content = File.ReadAllText(path);
    var normalized = content.Replace(
        "private global::Microsoft.AspNetCore.Razor.Runtime.TagHelpers.TagHelperRunner __tagHelperRunner =",
        "private readonly global::Microsoft.AspNetCore.Razor.Runtime.TagHelpers.TagHelperRunner __tagHelperRunner =");
    if (!string.Equals(content, normalized, StringComparison.Ordinal))
    {
        File.WriteAllText(path, normalized);
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="NormalizeRazorGeneratedFieldsForAnalyzers"
          AfterTargets="RazorGenerate"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <RazorGeneratedFilesForAnalyzer Include="$(IntermediateOutputPath)generated/**/*.g.cs" />
    </ItemGroup>
    <NormalizeRazorGeneratedFields GeneratedFiles="@(RazorGeneratedFilesForAnalyzer)" />
  </Target>

  <Target Name="NormalizeRazorGeneratedFieldsAfterCompileForAnalyzers"
          AfterTargets="CoreCompile">
    <ItemGroup>
      <RazorGeneratedFilesForAnalyzerPostCompile Include="$(IntermediateOutputPath)generated/**/*.g.cs" />
    </ItemGroup>
    <NormalizeRazorGeneratedFields GeneratedFiles="@(RazorGeneratedFilesForAnalyzerPostCompile)" />
  </Target>

</Project>
